@article{ONZO2026115759,
title = {GraphCETF: Cost-effective training-free acceleration for evolutionary graph neural architecture search},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115759},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115759},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126004892},
author = {Bernard-Marie Onzo and Yu Xue and Ferrante Neri and Moncef Gabbouj and Khursheed Aurangzeb},
keywords = {Neural architecture search, Training-free, Evolutionary algorithms, Surrogate models},
abstract = {Neural architecture search (NAS) has become an essential approach for automating neural network design and improving performance across a range of tasks. Nevertheless, applying NAS to non-Euclidean data, such as graphs, remains challenging due to the high computational cost of evaluating candidate architectures. This paper introduces GraphCETF, a novel evolutionary graph neural architecture search (GNAS) framework that integrates a training-free evaluation strategy with surrogate-assisted methods to accelerate the search process while maintaining high performance. By exploiting training-free evaluation techniques, GraphCETF markedly reduces the computational cost of assessing neural architectures, measured in GPU hours and runtime, and enables more effective exploration of the search space in terms of faster convergence during evolutionary search. We evaluate GraphCETF on six benchmark graph datasets, demonstrating its ability to discover high-quality architectures with substantially lower computational overhead compared with conventional approaches. Experimental results show that GraphCETF achieves competitive performance while significantly reducing search costs, making it a promising solution for efficient GNAS.}
}
@article{ZHANG2026115808,
title = {A mutual information-driven submodular optimization approach to covariate selection in causal effect estimation},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115808},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115808},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005344},
author = {Qi Zhang and Hao Zhong},
keywords = {Causal effect estimation, Covariate, Average treatment effect, Submodular optimization},
abstract = {In high-dimensional causal effect estimation, selecting an optimal subset of covariates is essential for improving the accuracy and stability of average treatment effect (ATE for short) estimation. Traditional methods often rely on linear assumptions or heuristics for covariate importance, lacking a unified, theoretically grounded framework. We propose a mutual information-driven submodular optimization approach for covariate selection. By leveraging the submodular properties of information gain and redundancy minimization, our method employs an adaptive criterion that balances covariate relevance to both outcomes and treatments with feature diversity. A greedy algorithm efficiently optimizes this criterion, selecting covariate subsets that maximize an objective function combining relevance gain and redundancy penalty. Experimental results demonstrate that our approach outperforms established baselines, including both submodular and causal inference methods. On real-world datasets, our method reduces ATE absolute bias by an average of 6.95% compared to the baselines. On synthetic datasets, it lowers ATE variance by an average of 32.7% relative to the baselines.}
}
@article{XIE2026115673,
title = {Fusing multi-head gating and focused-view contrastive learning for knowledge-aware recommendation},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115673},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115673},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126004132},
author = {Yudi Xie and Ying Chen and Wei Zeng and Xiaodong Zhu and Xiang Ao and Huiling Chen},
keywords = {Recommender, Multi-head gating mechanism, Knowledge graph, Contrastive learning},
abstract = {Knowledge-aware recommendation (KGR) models that integrate knowledge graphs (KGs) often face challenges such as sparse supervision signals, noise interference from semantic views, and inadequate feature fusion. To address these issues, this paper proposes a novel model named fusing multi-head gating and focused-view contrastive learning (MHGFCL). First, three distinct types of heterogeneous views are constructed: collaborative view, semantic view, and structural view. Adaptive encoders are then employed to learn the embedding representations of each view individually, enabling the comprehensive capture of user-item interactions, semantic associations, and structural features. Second, a focused-view contrastive learning module is developed, which discards the semantic view (prone to introducing noise) and conducting contrastive learning solely between the collaborative and structural views. Meanwhile, the temperature parameter is set as a learnable variable, and the model’s adaptability to complex data distributions is enhanced through dynamic optimization of similarity measurements—thereby mitigating the issue of sparse supervision signals. Finally, an adaptive feature fusion module employing a multi-head gating mechanism is introduced to achieve fine-grained selection and fusion of multi-source heterogeneous features, as well as to improve the discriminative power of node representations. Experimental evaluations on three datasets demonstrate that proposed algorithm achieves a significant improvement in recommendation performance over all current leading methods.}
}
@article{DENG2026115811,
title = {Polarization information restoration for visual reflection removal via cross dual-stream network},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115811},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115811},
url = {https://www.sciencedirect.com/science/article/pii/S095070512600537X},
author = {Lijun Deng and Yang Xu and Hedong Liu and Zixian Liu and Zhen Yang and Xin Zhou and Zhihua Xie and Haofeng Hu},
keywords = {Polarization imaging, Reflection removal, Computational imaging, Feature interaction},
abstract = {Capturing images through transparent media often introduces superimposed reflections that substantially degrade image quality and distort polarization distributions, thereby hindering the performance of low-level vision tasks. By exploiting inherent differences in polarization states between transmitted and reflected light, polarization imaging provides a robust physical cue for resolving this ill-posed problem. However, existing polarization-based reflection-removal methods insufficiently exploit polarization cues and fail to effectively restore the polarization information of the transmission layer. To harness this potential, we propose a polarization information–guided cross dual-stream network (PICDS-Net) that effectively integrates polarization priors into a dual-branch architecture for simultaneous reflection removal and polarization recovery. In particular, the network established progressive, bidirectional, and polarization-guided feature interactions between reflection and transmission streams across multiple decoder stages, enabling effective removal through hierarchical refinement. To further enhance the fusion of polarization-sensitive features, we introduce a cross-branch attention block that adaptively fuses complementary features across streams by modeling their exclusivity and complementarity, ensuring that each stream focuses on its respective layer content while avoiding feature contamination. We also introduce a polarimetric consistency loss to ensure the plausibility of polarization, thereby improving the model’s robustness and generalization. Experiments on real-world polarized image datasets demonstrated that PICDS-Net achieved state-of-the-art performance, producing cleaner transmission images with sharp details and recovering the scene’s underlying polarization characteristics. By restoring physically consistent polarization characteristics of the transmission layer, this work highlights the advantages of accurate polarization recovery for real-world reflective imaging scenarios. Application-oriented demonstrations further show that reliable polarization restoration improves material perception and scene interpretation, offering valuable insights for advancing polarization-guided vision systems in complex environments.}
}
@article{SHI2026115832,
title = {Explicitly provable gradient network for unrolled medical image reconstruction algorithms},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115832},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115832},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005587},
author = {Baoshun Shi and Lijun Huang and Wenyuan Xu and Yueming Su},
keywords = {Compressed sensing magnetic resonance imaging, Sparse view computed tomography reconstruction, Unrolled algorithm, Gradient network},
abstract = {Recently, unrolled algorithms have demonstrated outstanding empirical performance in solving medical image reconstruction problems; however, they face two primary limitations. First, proving that designed networks explicitly satisfy boundary or Lipschitz constraints-necessary for guaranteed convergence-is inherently challenging due to their black-box nature and limited interpretability. Second, the final imaging quality is limited because the prior network does not utilise the complementary information in intermediate images. We address these issues by proposing an explicitly provable tight frame-based gradient network and developing a convergent unrolled algorithm. Theoretically, we prove the Lipschitz constraint property of the gradient network. Furthermore, we generate reliable thresholds within the gradient network by introducing a threshold-generating sub-network. This sub-network explores complementary information from each intermediate image, including local frame coefficient details, non-local information and inter-stage information within the iterative algorithm. We propose a regularisation model based on the gradient network for solving medical image reconstruction problems and solve the corresponding optimisation problem using a convergent unrolled iterative algorithm. Extensive experimental results demonstrate the superiority of the proposed deep unrolled network in various medical image reconstruction tasks, including compressed sensing magnetic resonance imaging and sparse-view computed tomography reconstruction. Source code is made available at https://github.com/shibaoshun/GDUNet.}
}
@article{LIU2026115771,
title = {FA-CDDL: Contrastive deep dictionary learning with frequency augmentation},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115771},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115771},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126004971},
author = {Zhifeng Liu and Tianrui Huang and John Kingsley Arthur and Conghua Zhou and Shengli Wu and Xiangjun Shen and Sirui Tian and Hongtao Li},
keywords = {Deep dictionary learning, Sparse coding, Contrastive learning, Frequency augmentation},
abstract = {Deep Dictionary Learning (DDL) is a powerful paradigm for visual representation learning, yet prevailing DDL frameworks suffer from three core limitations: (i) they optimize sparse codes locally and underutilize global semantic relations among samples, (ii) they allow features from different categories to collapse in the embedding space, yielding redundant and weakly discriminative encodings, and (iii) they largely ignore frequency-domain cues that carry high-frequency details critical for recognition. To resolve these challenges, we propose FA-CDDL, a Frequency-Augmented Contrastive Deep Dictionary Learning framework. First, we introduce a supervised, multi-layer contrastive learning module that operates at every coding layer. By dynamically forming positive and negative pairsfrom label information, it enforces intra-class compactness and inter-class separation, thereby reducing feature redundancy and sharpening discrimination. Second, we design a frequency augmentation mechanism: encoded features are decomposed in the amplitude spectrum, high-frequency components are retained and reconstructed with phase coherence, and the result is concatenated with spatial features to form enhanced positive pairs. This selectively suppresses low-frequency noise while preserving discriminative detail. Third, we couple reconstruction loss with the supervised contrastive objective in a layerwise optimization loop, writing the learned discriminative signal back into dictionary atoms and codes for globally consistent improvements. Extensive experiments across character, face, and scene/image benchmarks (MNIST, EMNIST, AR Face, Extended Yale B, Scene 15, CIFAR-10, Mini-ImageNet and Places365) show that FA-CDDL consistently outperforms classical sparse coding, single-layer dictionary methods, and recent deep DDL baselines, delivering more compact, robust, and discriminative representations-particularly under frequency-domain perturbations.}
}
@article{GUO2026115852,
title = {Multi-faceted contrastive learning with inter-frame difference for traffic video question answering},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115852},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115852},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005782},
author = {Kan Guo and Qi Zuo and Yongli Hu and Lanping Qian and Daxin Tian and Jiapu Wang and Guixian Qu and Tingzheng Jia and Junbin Gao and Baocai Yin and Jian Wu},
keywords = {TrafficVQA, Inter-frame difference, Contrastive learning},
abstract = {Most existing Video Question Answering (VQA) models rely on vision-language pretraining to bridge the modality gap. However, they often underperform on Traffic Video Question Answering (TrafficVQA) due to its distinctive spatio-temporal characteristics. Surveillance videos often feature static backgrounds with moving objects, while in-car videos involve dynamic camera motion and emphasize interactions among traffic participants. More critically, traffic accidents are usually characterized by sudden and short-lived motion patterns–such as abrupt braking or collisions–that are difficult to capture using models primarily designed for long-term dependencies. To address these challenges, we propose MCL-ID, a Multi-faceted Contrastive Learning framework with Inter-frame Difference analysis. Specifically, we design an inter-frame difference module on top of an image-pretrained backbone to highlight abrupt motion by computing pixel-wise frame differences. We further introduce a cross-attention fusion gate to align spatially localized motion cues with visual features under question guidance. Finally, we incorporate a multi-faceted contrastive learning strategy to enhance cross-modal alignment among motion differences, visual content, and textual queries. Experiments on SUTD-TrafficQA and NExT-QA demonstrate that our approach achieves superior performance, validating its effectiveness for traffic-centric VQA tasks. Code is available at https://github.com/nmjhg/MCL-ID.}
}
@article{LOU2026115784,
title = {Bidirectional accelerated adaptive moment estimation for deep neural networks},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115784},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115784},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005101},
author = {Yuanzheng Lou and Yuqiu Shen and Majid {Ahmed Khan} and Mengjia Zhao and Fangdan Dai and Xu Shan and Jianhong Wang and Jiacheng Weng},
keywords = {Bidirectional accelerated Adam, Deep neural networks, Convergence analysis, Non-convex function, Accuracy estimation},
abstract = {In deep neural networks(DNNs), traditional gradient-based optimizers such as Adaptive Moment Estimation(Adam) suffer from inherent limitations, including low convergence efficiency, difficult to converge to the global extremum point. These problems often lead to premature stagnation or non-convergence of neural networks. To address these critical shortcomings, we propose a novel Bidirectional Accelerated Adam(BIadam) algorithm, which integrates a bidirectional difference mechanism into the Adam framework to enhance gradient estimation accuracy and stability. Theoretical analysis and numerical simulations demonstrate that BIadam achieves faster convergence speed and higher convergence accuracy compared to traditional optimizers. Experimental results demonstrate that the BIadam optimizer outperforms traditional optimizers comprehensively across multi-task scenarios: it achieves a 1.50% accuracy improvement in classification tasks and a 5.75% increase in the R2 for regression tasks. In Physics Informed Neural Networks, it reduces the loss and error by 93.71% and 75.64% respectively compared with traditional models, while also significantly outperforming other optimizers in all remaining metrics. In Transformer, it outperforms other optimizers by at least 0.4% in R2 and 0.7% in Accuracy. The code of the BIadam is available at https://github.com/LYZ-NTU/BIadam.git.}
}
@article{WANG2026115897,
title = {Towards generalizable fault diagnosis via LLM-driven hierarchical cross-modal alignment},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115897},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115897},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006234},
author = {Jie Wang and Ze Sun and Jiale Zhang and Haidong Shao and Yiming Xiao and Bin Liu},
keywords = {Large language model, Cross-modal feature alignment and fusion, Fault diagnosis, Cross-condition, Data imbalance},
abstract = {Recent advances in generative artificial intelligence (AI) have led to transformative breakthroughs across multiple fields. As the core of generative AI, large language models (LLMs) possess strong generalization and reasoning capabilities, offering the potential to establish a unified framework for fault diagnosis. Such a framework can overcome the limitations of existing methods when faced with challenges, including multiple datasets, cross-condition transfer, and data imbalance. However, owing to the significant modality gap between continuous vibration signals and discrete text, effective LLM utilization to process time-series data for fault diagnosis remains a critical challenge. In this study, an LLM-driven hierarchical cross-modal alignment method, termed HCMA_GPT, is proposed to overcome this challenge. First, a signal-text synergistic representation module is constructed to generate domain-knowledge-enriched text descriptions from raw vibration signals. Then, these descriptions are jointly encoded with the original signals to enhance the diversity and semantic expressiveness of fault features. Secondly, a hierarchical cross-modal feature alignment and fusion module is designed to achieve feature alignment and fusion between signals and text data from shallow to deep layers. By minimizing the distributional discrepancy between the two modalities, this module enhances the applicability of semantically trained LLM to time-series data. Finally, a novel unified fault diagnosis framework is developed by leveraging the generalization and reasoning abilities of LLM. Extensive experiments conducted on multiple datasets, cross condition and data imbalance scenarios indicate that HCMA_GPT effectively improves diagnostic accuracy and exhibits superior robustness and generalization capabilities.}
}
@article{XU2026115792,
title = {SP-Det: Self-prompted dual-text fusion for generalized multi-label lesion detection},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115792},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115792},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005186},
author = {Qing Xu and Yanqian Wang and Xiangjian He and Yue Li and Yixuan Zhang and Rong Qu and Wenting Duan and Zhen Chen},
keywords = {Chest X-ray analysis, Lesion detection, Self-prompting, Multi-modal fusion},
abstract = {Automated lesion detection in chest X-rays has demonstrated significant potential for improving clinical diagnosis by precisely localizing pathological abnormalities. While recent promptable detection frameworks have achieved remarkable accuracy in target localization, existing methods typically rely on manual annotations as prompts, which are labor-intensive and impractical for clinical applications. To address this limitation, we propose SP-Det, a novel self-prompted detection framework that automatically generates rich textual context to guide multi-label lesion detection without requiring expert annotations. Specifically, we introduce an expert-free dual-text prompt generator (DTPG) that leverages two complementary textual modalities: semantic context prompts that capture global pathological patterns and disease beacon prompts that focus on disease-specific manifestations. Moreover, we devise a bidirectional feature enhancer (BFE) that synergistically integrates comprehensive diagnostic context with disease-specific embeddings to significantly improve feature representation and detection accuracy. Extensive experiments on two chest X-ray datasets with diverse thoracic disease categories demonstrate that our SP-Det framework outperforms state-of-the-art detection methods while completely eliminating the dependency on expert-annotated prompts compared to existing promptable architectures.}
}
@article{WU2026115709,
title = {Few-shot medical image segmentation via dual-stream feature extractor and detail-enhanced prototype transformer},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115709},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115709},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126004491},
author = {You Wu and Wenfeng Zhang and Yang Ren and Jianming Hu and Wei Hu and Qibing Qin},
keywords = {Few-shot learning, Medical image segmentation, Dual-stream feature extraction, Detailed prototype refinement},
abstract = {Few-shot segmentation (FSS) has emerged as a promising approach for medical image analysis, especially in scenarios where annotated data is limited. However, the performance of existing prototypical networks is typically hindered by two critical challenges: 1) intra-class variation arising from feature distribution discrepancies between support and query sets. 2) Extreme inter-class imbalance, often exacerbated by complex background structures. To tackle these challenges, we propose an innovative dual-stream prototype optimization framework, the Dual-stream Feature Extractor and Detail-enhancing prototype Transformer (DFDT). Firstly, we introduce a Dual-stream Visual Feature Fusion (DVFF) module that simultaneously merges local and global features, generating detailed, semantically rich interactions. This module enables the initial prototype to capture global semantics while preserving fine-grained details, effectively reducing intra-class variation. Subsequently, the iterative Prototype Detail Enhancement Transformer (PDET) is designed, employing iterative cycles of bias correction and detail refinement. This component systematically filters confounding background noise from the prototype while reinforcing core information pertinent to the target foreground, significantly improving robustness against variations in complex backgrounds. Extensive experiments on three public medical imaging datasets demonstrate that the proposed DFDT model achieves significant performance gains over current state-of-the-art methods. Code will be made public at https://github.com/CQNU-ZhangLab/DFDT.}
}
@article{GU2026115776,
title = {FM-LLM: A frequency-enhanced mixture-of-experts framework for adapting LLMs to time series forecasting},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115776},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115776},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005022},
author = {Rentao Gu and Yihang Ding and Junjie Li and Yi Ding and Weijing Sang and Xiaoli Huo and Xin Qin and Yuefeng Ji},
keywords = {Multivariate time-series forecasting, Large language models, Fourier analysis network, Mixture of experts},
abstract = {Recent advances in Large Language Models (LLMs) have spurred cross-modal solutions for time-series forecasting. However, existing methods rely heavily on textual prompts for modality alignment—introducing nontrivial computational overhead and failing to leverage the rich spectral dynamics inherent in time-series data. To enable prompt-free, frequency-aware adaptation of frozen LLMs, we propose FM-LLM (Frequency-Enhanced Mixture-of-Experts for adapting LLMs to Time Series Forecasting), an autoregressive framework grounded in the principle of constrained asymmetric coupling. A Fourier Analysis Network (FAN)-based spectral token aligner injects structured harmonic representations directly into the frozen LLM with numerical compatibility. Concurrently, an asymmetric Mixture-of-Experts (MoE) decoder enforces explicit role separation: shared experts equipped with lightweight FAN layers reconstruct the global periodic backbone, while routed experts—restricted exclusively to standard feed-forward networks (FFNs)—specialize in modeling non-periodic residual dynamics. A time-frequency hybrid loss function jointly optimizes temporal accuracy and spectral consistency, effectively mitigating error accumulation during long-horizon autoregressive rollouts. Evaluated across eleven public benchmarks, FM-LLM achieves state-of-the-art performance on 59 out of 78 evaluation metrics. Compared to the strongest autoregressive LLM-based baseline, it delivers average improvements of 5.3% in Mean Squared Error (MSE) and 5.6% in Mean Absolute Error (MAE), with maximum gains reaching 8.0% for MSE and 8.4% for MAE. FM-LLM also demonstrates robust transferability, maintaining superior performance in 10% few-shot and zero-shot forecasting scenarios. By purposefully wiring spectral alignment and decoding—distinct from prompt-dependent alignment strategies or uniform spectral processing approaches—FM-LLM establishes an accurate, efficient, and interpretable paradigm for next-generation time-series LLMs.}
}
@article{SHAKUNTHALA2026115665,
title = {Automated brain stroke detection inmagnetic resonance imaging using self-modulating convolutional neural networks for enhanced ischemic and hemorrhagic stroke classification},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115665},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115665},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126004053},
author = {M Shakunthala and T.D. Subha and A. {Anna lakshmi} and T.D. Subash},
keywords = {Brain stroke, Ischemic, Hemorrhagic, Stroke area, Energy, Contrast, Homogeneity and skewness},
abstract = {Stroke is a type of cerebrovascular disorder that significantly affects a person’s health and well-being. Quantitative analysis of brain magnetic resonance imaging (MRI) images is crucial for evaluating and determining appropriate treatments for stroke. A blockage in the brain’s blood supply is a primary cause of stroke. To overcome these challenges, automated brain stroke detection in MRI using self-modulating convolutional neural networks for enhanced ischemic and hemorrhagic stroke classification (BSD-IHSC-SMCNN) is proposed. At first, the input image is gathered from the Brain Stroke MRI Images Dataset. Then, the input images are pre-processed utilizing a Bilinear Double-Order Filter (BDOF) is employed to enhance image quality and remove noise. Then, the pre-processed data are fed into a structured doubly stochastic graph based clustering (SDSGC), which is used to split the image into meaningful regions. Then, the segmented data are fed into feature extraction using the Spatial-Spectral Recurrent Transformer (SSRT). It is used to extract relevant features such as Stroke Area, Energy, Contrast, Homogeneity and Skewness. Finally, the Self-Modulating Convolutional Neural Network SMCNN is employed to detect and classify brain stroke into normal, ischemic, and hemorrhagic categories. To further develop classification performance, the Wombat Optimization Algorithm WOA is applied to optimize the network parameters and enhance overall accuracy. The BSD-IHSC-SMCNN model achieves the best performance in brain stroke detection, with 98% accuracy for Normal, 93% for Ischemic, and 96% for Hemorrhagic Stroke and 1.170 seconds computation time, with existing methods, such as the expression of SARS-CoV-2 spike protein in cerebral fluid, deep learning-driven multi-class classification of brain strokes using computed tomography: a step towards improved diagnostic precision (MCBS-CT-CNN), and a new deep learning (DL)-driven GUI design and implementation for automatic detection of brain strokes with CT images (BS-CT-ANN). The arteries: Hemorrhagic stroke implications HS-GAN post-mRNA vaccination.}
}
@article{TONG2026115820,
title = {Lossless image compression encryption algorithm based on multi-scroll chaotic systems and quadtree coding},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115820},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115820},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005460},
author = {Xiaojun Tong and Chunhui Ye},
keywords = {Privacy protection, Image compression, Image encryption, Chaotic system},
abstract = {Image compression and encryption have long constituted a significant research focus within the domain of digital security. To remedy the deficiencies of existing schemes in terms of compression ratio and cryptographic security, a lossless image compression and encryption algorithm based on a multi-scroll chaotic system and optimized quadtree coding is proposed. First, an optimization strategy for quadtree coding is devised to fully exploit the potential of hierarchical quadtree compression by reducing the length of marker overhead, thereby achieving a higher image compression ratio. Second, a four-dimensional multi-scroll chaotic system is constructed, and the pseudo-random sequences it generates are combined with a two-dimensional Fisher-Yates shuffling algorithm, thereby effectively enhancing image confusion. Experimental results demonstrate that, relative to state-of-the-art schemes, the proposed lossless image compression algorithm attains a higher compression ratio and stronger resistance to cryptanalytic attacks, thus exhibiting broader application prospects in efficient and secure image storage and transmission.}
}
@article{CHENG2026115812,
title = {Dynamics-based algorithm-level privacy preservation for push-sum average consensus},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115812},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115812},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005381},
author = {Huqiang Cheng and Mengying Xie and Xiaowei Yang and Qingguo Lü and Huaqing Li},
keywords = {Average consensus, Privacy preservation, Tailored weights, Unbalanced directed networks},
abstract = {In the intricate dance of multi-agent systems, achieving average consensus is not just vital–it is the backbone of their functionality. In conventional average consensus algorithms, all agents reach an agreement through individual calculations and sharing information with their respective neighbors. Nevertheless, the information interactions that occur in the communication network may reveal sensitive information. In this paper, we develop a new privacy-preserving average consensus method on unbalanced directed networks. Specifically, we ensure privacy preservation by carefully embedding randomness in mixing weights to confuse communications and introducing an extra auxiliary parameter to mask the state-updated rule in several initial iterations. In parallel, we exploit the intrinsic robustness of consensus dynamics to guarantee that the average consensus is precisely achieved. Theoretical results demonstrate that the designed algorithms can converge linearly to the exact average consensus value and can guarantee privacy preservation of agents against both honest-but-curious and eavesdropping attacks. The designed algorithms are fundamentally different compared to differential privacy-based algorithms that enable privacy preservation via sacrificing consensus performance. Finally, numerical experiments validate the correctness of the theoretical findings.}
}
@article{MA2026115844,
title = {LogSnippet: Online frequent snippet mining and multi-event tokenization for compact log representation and anomaly detection},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115844},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115844},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005708},
author = {Jun Ma and Qingjun Xiao and Bingjin Wu and Hang Chen and Yongchao Zhang and Guang Cheng},
keywords = {Log anomaly detection, Multi-event tokenization, Frequent pattern mining, Transformer model},
abstract = {Log anomaly detection is critical for ensuring the reliability of large-scale software systems. Although deep learning-based methods have achieved promising results, they typically rely on fixed-granularity tokenization of log sequences. Specifically, raw logs are segmented into tokens at the level of individual log events, and the resulting event sequences are then fed into deep models for anomaly detection. However, this strategy overlooks frequent co-occurrence patterns of successive events arising from repetitive system operations, producing excessively long sequences dominated by redundant normal events and obscuring rare anomalies. To address this limitation, we propose LogSnippet, which integrates frequent snippet mining with multi-event tokenization for log anomaly detection. We first design an online mining algorithm to extract variable-length frequent event snippets in real-time. This algorithm scans log events in a single pass and maintains the cardinalities (i.e., supports) of candidate snippets. To address the combinatorial explosion of candidate snippets in online environments, we adopt a memory-efficient cardinality-counting sketch to estimate snippet supports. Next, leveraging the online-maintained snippets, we introduce a repository-guided multi-event tokenization mechanism that compresses raw event sequences into compact and structured token sequences, thereby enhancing the visibility of rare anomalies against repetitive background patterns. Finally, we employ a Transformer model to learn discriminative patterns from these compact sequences for offline log anomaly detection. Experiments on four datasets demonstrate that LogSnippet consistently outperforms representative baselines.}
}
@article{GAO2026115749,
title = {ACDA: Anatomically constrained distribution alignment for robust medical image segmentation},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115749},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115749},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126004818},
author = {Yifan Gao and Xiaosong Wang and Xin Gao},
keywords = {Diffusion model, Medical image segmentation, Domain adaptation, Style transfer},
abstract = {Deep neural networks for medical image segmentation often degrade when applied to unseen domains with different scanners or protocols. While diffusion models offer a promising image-to-image translation approach to bridge such distribution gaps, their unconstrained generation may produce anatomically inconsistent images, compromising segmentation reliability. To overcome this, we propose anatomically constrained distribution alignment (ACDA), a target-agnostic framework that harmonizes data distributions while preserving structural fidelity. We introduces anatomically constrained denoising diffusion probabilistic models, which steer the generation process by integrating latent variables with explicit structural guidance. A domain-prior U-Net acts as the denoising network, leveraging edge and histogram prompts to capture domain-specific characteristics. Furthermore, we design a prompt-driven distribution matching strategy that aligns the target domain to the source through nearest-neighbor retrieval. We comprehensively evaluated ACDA across five diverse clinical scenarios, including prostate MRI, ovarian tumor MRI, multi-tracer PET, cardiac MRI, and fundus photography. Our method achieved Dice scores of 70.46%, 73.03%, 53.19%, 82.41%, and 86.02% respectively, consistently outperforming existing approaches. Notably, it delivered substantial performance gains of 17% to 54% over the non-adapted baseline across all datasets, demonstrating its effectiveness and generalizability for robust cross-domain segmentation.}
}
@article{YU2026115836,
title = {Bounty hunter optimizer: A novel metaheuristic with an application to multi-UAV mobile edge computing and path planning},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115836},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115836},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005629},
author = {Mingyang Yu and Haorui Yang and Jiaqi Zhang and Kaichen Ouyang and Shengwei Fu and Panlong Tan and Frank Jiang and Jing Xu},
keywords = {Bounty hunter optimizer, Explorpolis rule, Quantum probability rotation selection, Evolutionary model, Multi-UAV mobile edge computing and path planning},
abstract = {This study proposes the bounty hunter optimizer (BHO), a novel optimization algorithm inspired by the behavior of bounty hunters. Unlike traditional methods that rely on mean aggregation, BHO employs a decentralized position-update strategy based on local differences and random disturbances, inherently avoiding center bias and population collapse. BHO introduces three core innovations: (1) the Explorpolis rule, which quantifies individual fitness and its spatial relationship to the high-quality solution set, enabling intelligent filtering of inferior solutions; (2) a quantum probability rotation selection mechanism, which replaces the traditional roulette-wheel selection using quantum bits and rotation gates to continuously adjust probability amplitudes, significantly enhancing population diversity; and (3) an evolutionary model inspired by the “thorough investigation,” “rough search,” and “hunter re-assignment” behaviors of hunters, integrated with a self-feedback adjustment mechanism to dynamically balance exploration and exploitation. Experimental results on the CEC2017 test suite demonstrate that the BHO excels in both 30-dimensional and 100-dimensional optimization tasks, significantly outperforming 11 advanced optimization algorithms, including four competition-level state-of-the-art variants. When applied to the multi-unmanned aerial vehicle (multi-UAV) mobile edge computing (MEC) and path planning (PP) (multi-UAV MEC-PP) system, BHO effectively addresses the path optimization problem under quality-of-service constraints. Extensive simulations across different scales confirm its superior performance, achieving >15% cost reduction relative to advanced competitors and providing reliable and efficient support for PP and decision-making in MEC environments.}
}
@article{YANG2026115754,
title = {G-GBC: A Gaussian mixture-based granular ball computing method for robust CNN classification under noisy labels},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115754},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115754},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126004855},
author = {Junxiao Yang and Qiang Liu and Xuemei Cao and Fei Li and Xin Yang},
keywords = {Granular-ball computing, Training process interpretability, Label noise, Gaussian mixture model},
abstract = {In actual scenarios, both manual and automated annotation methods are susceptible to generating mislabeled data. Existing noise-handling techniques primarily focus on penalizing or eliminating noisy labels; however, they often face challenges in maintaining interpretability and effectively addressing the complexities of label noise. To address these issues, we propose a novel framework that leverages the robustness and interpretability of granular-ball computing (GBC) to improve noise resistance and classification performance. The Gaussian mixture-based GBC (G-GBC) method integrates CNN models as a feature extractor and employs a Gaussian mixture model to adaptively generate granular-ball (GB). By incorporating the purity and weight of GBs into the classification process, the model dynamically adjusts the granularity of GBs, enabling it to extract essential features while reducing the adverse effects of noise. Experimental results on multiple datasets demonstrate that the proposed approach significantly enhances classification accuracy and model robustness under noisy conditions. Furthermore, the GB framework improves the interpretability of the training process, offering a novel perspective for image classification tasks in the presence of label noise.}
}
@article{DU2026115804,
title = {LCMF: A LLM-enhanced cross-modal fusion framework for universal temporal forecasting},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115804},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115804},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005307},
author = {Shengdong Du and Junlong Jiang and Haochen Shi and Yan Yang and Junbo Zhang and Tianrui Li and Yu Zheng},
keywords = {Temporal forecasting, Cross-modal fusion, Large language model, Deep learning, Multimodal data analysis},
abstract = {Time series forecasting has historically concentrated on numerical data processing, and recent multimodal approaches have predominantly been limited to simple numerical-to-textual conversions. However, in reality, time series data from different domains are characteristically accompanied by abundant contextual information that remains underutilized. This necessitates a universal time series forecasting framework. Existing methods are limited by two issues: first, direct signal-to-text conversion results in information loss across different domains; second, simple feature concatenation lacks the ability to learn sophisticated cross-modal interaction features. To address these challenges, this study proposes a novel dual-stage framework, called the LLM-Enhanced Cross-Modal Fusion Framework (LCMF). Notably, LCMF achieves universal temporal forecasting by integrating semantic reasoning with numerical modeling using multilevel cross-modal attention fusion networks. In the initial stage, LCMF performs structured semantic reasoning on contextual information using LLMs through parallel modality preprocessing branches while simultaneously preserving the original numerical characteristics by processing time series from different domains. The second stage introduces a multilevel cross-modal attention fusion network (MLCA-Net) to dynamically integrate multisource information through adaptive weight allocation and hierarchical cross-modal interactions. Extensive experiments on benchmark datasets spanning multiple domains demonstrate that the LCMF framework substantially outperforms state-of-the-art methods, thereby validating its generalizability and effectiveness across different temporal forecasting scenarios.}
}
@article{FAZA2026115824,
title = {Direct interval propagation methods using neural-network surrogates for uncertainty quantification in physical systems surrogate model},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115824},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115824},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005502},
author = {Ghifari Adam Faza and Jolan Wauters and Fabio Cuzzolin and Hans Hallez and David Moens},
keywords = {Operator learning, Interval propagation, Uncertainty quantification, Interval regression},
abstract = {In engineering applications, uncertainty propagation refers to the systematic characterisation of a system output under uncertain inputs. Specifically for interval uncertainty, the objective is to determine the lower and upper bounds of the output, given interval-valued inputs. Such uncertainty propagation plays a crucial role in engineering tasks, including robust design optimisation and reliability analysis, where accurate characterisation of uncertainty is essential for safe and reliable decision-making. However, standard interval propagation requires solving optimisation problems that can be computationally expensive, particularly when dealing with complex physical systems. To address this challenge, surrogate models have been developed to enable efficient interval propagation. Although surrogate models are computationally more efficient, standard surrogate-based approaches typically only replace the evaluator function within the optimisation loop, which still requires a large number of inference calls. Therefore, we propose to directly estimate the output interval by reframing the problem as an interval-valued regression task. In this work, we present a comprehensive study of strategies for direct interval propagation using NN-based surrogate models, including standard multilayer perceptrons (MLPs) and deep operator networks (DeepONet). We investigate and compare three distinct approaches: (i) naive interval propagation through standard architectures, (ii) bound propagation techniques such as Interval Bound Propagation (IBP) and CROWN, and (iii) interval neural networks (INNs) with interval weights. Our results demonstrate that these methods are significantly more efficient compared to traditional optimisation-based interval propagation and are able to provide accurate interval estimates. We also discuss the limitations and open challenges associated with implementing interval-based propagation in practice.}
}
@article{ZHANG2026115848,
title = {Selective layer-wise cleansing: A knowledge-preserving defense against backdoor attacks in LoRA-tuned models for natural language understanding},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115848},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115848},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005745},
author = {Xiaohui Zhang and Tao Shen and Kai Zeng and Fenhua Bai},
keywords = {Pre-trained language models, Backdoor attacks, LoRA fine-tuning, Defense-convergence dilemma},
abstract = {Low-rank adaptation (LoRA) is a popular method for efficiently fine-tuning pre-trained language models (PLMs) with lightweight, trainable plugins. This paradigm is vulnerable to backdoor attacks, in which attackers embed triggers that force the LoRA-tuned model to produce attacker-chosen outputs. However, existing defenses focus on backdoors in the main PLM backbone, leaving LoRA plugins unaddressed. When these backbone-oriented defenses are applied to LoRA-tuned models, they erase task-specific knowledge while degrading model performance, resulting in the defense-convergence dilemma. To address this issue, we propose selective layer-wise cleansing (SLC), a framework for removing backdoors from LoRA plugins while maintaining task performance. SLC is based on our backdoor activation divergence principle, which states that benign and malicious inputs result in statistically distinct layer-level activation patterns. Our framework first trains a benign auxiliary model on publicly available, task-agnostic data to serve as a clean behavioral baseline. It then identifies anomalous layers in the target model by comparing their activation patterns. Finally, SLC uses a layer-wise distillation process to transfer verified, task-specific knowledge into the clean auxiliary model, guided by the divergence ranking. Experiments show that SLC solves the defense-convergence dilemma. Compared to representative baselines, such as PURE, RECIPE, and BDEKD, SLC robustly defends against various backdoor attacks while maintaining high accuracy on natural language understanding (NLU) benchmarks. The code for our proposed SLC is released at https://github.com/AIR6200/SLC.}
}
@article{DONG2026115868,
title = {Dynamic expansion orthogonal network for class-incremental learning},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115868},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115868},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005940},
author = {Mingda Dong and Zhizhong Zhang and Xin Tan and Jiling Qiu and Yuan Xie},
keywords = {Continual learning, Catastrophic forgetting, Dynamically expandable networks, Orthogonal loss},
abstract = {Dynamic expansion networks have emerged as a promising approach for incremental learning by introducing new feature extractors for each task while freezing previously learned ones to preserve acquired knowledge. However, existing methods often fail to effectively leverage information from earlier tasks when learning subsequent tasks, leading to blurred decision boundaries for earlier tasks and exacerbating catastrophic forgetting. To address this issue, we propose a novel orthogonal feature space constraint that encourages new-task features to lie in a subspace orthogonal to that of earlier tasks. This constraint helps preserves task boundaries and mitigate catastrophic forgetting. However, strictly enforcing orthogonality may undermine the plasticity needed to learn new tasks, potentially hindering performance. To strike a balance between stability and plasticity, we introduce a selective orthogonal constraint guided by a Task Relevance Matrix (TRM), which quantifies cross-class similarities between old and new classes, relaxes unnecessary restrictions, and enables more precise and adaptive orthogonal regularization. Additionally, we propose an intra-task orthogonality module that helps new tasks better differentiate their feature space from that of old tasks. Extensive experiments on CIFAR-100, ImageNet-100, and ImageNet demonstrate that our method effectively alleviates catastrophic forgetting while maintaining competitive performance on newly introduced tasks.}
}
@article{LIU2026115788,
title = {D2-DETR:DETR With Dual-Domain frequency-spatial modeling for unmanned aerial vehicle imagery object detection},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115788},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115788},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005149},
author = {Xuanming Liu and Huanxin Zou and Jun Li and Liyuan Pan and Shitian He and Xu Cao and Yuqing Zhang and Jiangshan Li and Wanyu Chen},
keywords = {UAV Aerial images, Object detection, D-DETR, Dual-Domain modeling, Frequency attention module, Feature fusion pyramid network},
abstract = {Object detection in Unmanned Aerial Vehicle (UAV) imagery presents significant challenges, particularly regarding small, densely packed objects characterized by low resolution and feature ambiguity. To address these issues, this paper introduces D2-DETR, a novel detection framework that leverages a dual-domain architecture to synergistically model both frequency and spatial information. Central to our model is the D2-Backbone, which integrates three key components: (1) a Frequency Attention (FA) module that dynamically amplifies high-frequency features of small objects while suppressing background noise via learnable spectral weighting; (2) a Spatially-Guided Adaptive Dilation Rate Mechanism (SG-ADRM) that modulates dilation rates based on local frequency energy to balance detail preservation with large-context modeling; and (3) a Dynamic Dual-Shape Attention (DDA) module employing shape-specific convolutional kernels to capture both compact vehicle contours and elongated traffic queues. Furthermore, we propose a Spatial-Frequency Feature Pyramid Network (SF-FPN) that integrates dual-branch processing with real-valued FFT compression. This design enhances multi-scale fusion and ensures effective fine-grained information propagation while maintaining computational efficiency. Extensive experiments on challenging public benchmarks, VisDrone and UAVDT, demonstrate the superiority of our approach. Specifically, D2-DETR achieves state-of-the-art performance with mAP@.50 scores of 41.40% on VisDrone and 38.21% on UAVDT, outperforming existing detectors while retaining real-time inference capabilities. This work validates the efficacy of joint frequency-spatial modeling for small object detection, offering a robust solution for real-world aerial surveillance applications.}
}
@article{ZHA2026115785,
title = {iTransPASOH: A physics-aware iTransformer framework for lithium-ion battery state-of-health estimation},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115785},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115785},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005113},
author = {Yiwei Zha and Feng Yan and Chunjie Yang and Guodong Mao},
keywords = {Soft sensor, Physics-informed neural network, Lithium-ion battery, Time-series prediction},
abstract = {The safety issue of lithium-ion batteries during the charging and discharging process is of great significance. Hence, state-of-health estimation, a key indicator in the battery management system, is crucial for battery safety control, degradation optimization, and precise remaining life prediction. Researchers have proposed several methods for measuring state-of-health, including direct measurement and soft sensor approaches, such as first-principle modeling and data-driven methods. However, these methods have significant limitations during applications. Hybrid methods, while leveraging advantages from both approaches, still face limitations including lack of flexibility and architectural design-level interpretability, over-dependency on data, and robustness issues. To solve these problems, we propose a trend-capture physics-aware optimization method together with iTransformer to capture the temporal patterns of SOH degradation. Then, to dynamically model the PDE that describes SOH degradation, we theoretically derive the CCA model into a generalized PDE form to provide interpretability and input the multivariate features (cross-sectional characteristics extracted from each charging cycle) and time-series features (temporal patterns across multiple cycles) respectively to enhance robustness. Next, we construct a PDE loss term using the numerical output from the PDE modeling to physically guide the optimization of the PINN. Finally, comprehensive experimental validation across four benchmark datasets demonstrates that iTransPASOH achieves an average MAPE improvement of 20.942% over state-of-the-art methods, with statistical significance confirmed at the 95% confidence level, while maintaining only 16.7% performance degradation under noise conditions and practical inference times of 6.4ms per sample for real-world deployment.}
}
@article{ZHOU2026115809,
title = {Towards attribute-Augmented course recommendation: An LLM-Driven model-Agnostic representation learning framework},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115809},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115809},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005356},
author = {Guangyou Zhou and Zhuo Zhao and Jinjin Ma and Zhiwen Xie},
keywords = {Smart education, MOOCs, Course recommendation, Online learning},
abstract = {Course recommendation systems are essential to personalized online education platforms, helping learners find courses that meet their preferences and future developmental needs, thereby achieving exponential improvements in learning efficiency. Despite the promise of recent LLM advances, their integration into course recommendation remains severe challenges. First, directly encoding course titles inadequately captures their comprehensive semantic content and structured characteristics. Second, serializing lengthy textual descriptions of course histories exacerbates modeling complexity and degrades real-time performance. To address these limitations, an LLM-driven model-agnostic representation learning (LMRL) framework is proposed, which deeply integrates the powerful text generation and comprehension strengths of LLMs to enhance current course recommendation systems. For each course, meticulously crafted system prompt is employed to guide the LLM in generating fine-grained and multi-dimensional attribute information, thereby expanding the semantic space and explicitly revealing topological associations among courses. Furthermore, LMRL trains a lightweight transformation network through the constructed contrastive-aligned course representation learning module to achieve optimal modeling of course information containing multi-dimensional attributes. This approach enables LMRL to be seamlessly integrated as a preprocessing component into existing course recommendation systems, achieving substantial performance improvements with minimal computational overhead. Experiments on two education datasets confirm the efficacy and compatibility of LMRL.}
}
@article{DI2026115861,
title = {SDD-Fuse: A multi-modality image fusion framework based on the spiking diffusion fusion model},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115861},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115861},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005873},
author = {Jing Di and Heran Wang and Jing Lian and Shuhui Shi and Jizhao Liu},
keywords = {Multi-modal image fusion, Diffusion model, Spiking neural network, Kolmogorov-Arnold network},
abstract = {Denoising diffusion models have emerged as powerful tools for multi-modal image fusion due to their powerful image generation ability and stable, controllable denoising generation process. However, existing diffusion-based fusion methods face challenges, including high computational energy consumption and inadequate modeling of time-embedded image features, which hinder the development of diffusion models in the image fusion domain. To address these issues, building upon an existing spiking diffusion model, we propose a multi-modality image fusion framework based on Spiking Diffusion Fusion Model (SDD-Fuse), which consists of a spiking denoising network (SK-UNet) and a fusion refinement network (FR-Net). First, we introduce task-oriented adaptations to the spiking diffusion model for multimodal image fusion. By progressively incorporating fusion prior information during the reverse denoising process, the proposed framework achieves efficient generation of fused images through the spiking distribution of images. Subsequently, we construct SK-UNet, in which KAN is introduced to perform spiking dynamic modeling of the fused image distribution. This design enhances the capability of the diffusion-based fusion model to process image features with time-embedded information while maintaining low computational overhead. Finally, we design the fusion network FR-Net, composed of multiple Transformer blocks integrated with RoPE, which is deeply coupled with SK-UNet via the residual structure to iteratively optimize the fusion process and generate high-quality fused images that align with the fusion knowledge distribution. Extensive experiments show that SDD-Fuse significantly reduces the computational cost of fused image generation and achieves state-of-the-art fusion performance in various complex scenarios. Additionally, downstream semantic object detection experiments demonstrate the importance of SDD-Fuse for downstream vision tasks. The code will be available at https://github.com/heran323625/SDD-Fuse.}
}
@article{KOLAHKAJ2026115741,
title = {HGAT-MHRec: A multimodal multi-objective hybrid recommendation framework using heterogeneous graph attention and deep autoencoders},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115741},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115741},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126004740},
author = {Maral Kolahkaj},
keywords = {Recommender systems, Multimodal learning, Multi-objective optimization, Graph attention networks, Deep autoencoders},
abstract = {Recommender systems (RS) play a pivotal role in modern digital ecosystems, guiding user decisions across e-commerce, social media, and multimedia content platforms. Traditional approaches such as collaborative filtering (CF) and content-based filtering (CBF) often struggle with data sparsity, cold-start problems, and limited personalization, particularly in dynamic and multimodal heterogeneous environments. Recent developments in Graph Neural Networks (GNNs), multimodal learning, and deep autoencoders have enabled richer representations by capturing both structural and semantic aspects of user–item interactions. Despite these improvements, generating recommendations that are simultaneously accurate, diverse, novel, and well-covered remains a persistent challenge, especially in heterogeneous and high-dimensional multimedia domains. To address these issues, we present Multi-Modal HGAT-MHRec, a modular hybrid recommendation framework that combines: (i) heterogeneous graph attention networks for capturing relation-aware, type-specific semantic interactions among users, items, tags, and temporal metadata; (ii) multimodal autoencoding with mutual information preservation to achieve robust and semantically consistent feature representations across modalities; and (iii) a multi-objective evolutionary algorithm to perform list-wise, sequential recommendation tuning that balances the objectives. Our framework is designed to sequentially align structural modeling, semantic fusion, and adaptive recommendation list generation. Experiments conducted on a subset of the real-world multimedia dataset (YFCC100M) demonstrate that HGAT-MHRec outperforms baseline methods across multiple evaluation metrics. The results highlight the effectiveness of jointly modeling graph heterogeneity, multimodal semantics, and multi-objective optimization within a unified architecture tailored for complex and content-rich recommendation scenarios.}
}
@article{CHEN2026115777,
title = {Towards robust incomplete multimodal open-set domain generalization with uncertain missing modalities},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115777},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115777},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005034},
author = {Xin Chen and Huanjie Tao and Benran Li},
keywords = {Incomplete multimodal learning, Open-set domain generalization, Meta learning, Uncertain missing modalities},
abstract = {Incomplete Multimodal Open-set Domain Generalization aims to enable effective generalization to unseen domains and novel categories under incomplete modalities. Existing methods for open-set domain generalization often overlook missing modalities, which amplifies domain-class distribution shifts. Most incomplete multimodal learning approaches are not applicable to open-set domain generalization with unseen categories, unseen domains, and missing modalities. To address these critical limitations, we propose a novel Missing Modal-Domain-Class Meta-Learning framework (MMDCM). The proposed framework effectively utilizes diverse incomplete training data under the challenging Uncertain Missing Modalities setting. MMDCM employs a Cascade Autoencoder guided by a Feature Association Loss for robust cross-modal representation learning and the inference of missing information. Furthermore, we design a Missing Modality Entropy-Weighted Masking Strategy to mitigate information confusion from uncertain missingness during optimization. Extensive experiments on the HAC, MSA-IMOSDG, and MSA-IMOSDG-4ways datasets demonstrate that our method achieves superior performance on Incomplete Multimodal Open-Set Domain Generalization tasks, outperforming existing state-of-the-art methods. Our code will be available at https://github.com/leeAndJim/IMDGOS.}
}
@article{TONG2026115829,
title = {Adversarial batch representation augmentation for batch correction in high-content cellular screening},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115829},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115829},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005551},
author = {Lei Tong and Xujing Yao and Adam Corrigan and Long Chen and Navin Rathna Kumar and Kerry Hallbrook and Jonathan Orme and Yinhai Wang and Huiyu Zhou},
keywords = {Batch effect, Domain generalization, Cell painting images, siRNA perturbation classification},
abstract = {High-Content Screening routinely generates massive volumes of image data for phenotypic profiling, such as cell painting. However, technical variations across experimental executions inevitably induce biological batch (bio-batch) effects. These cause covariate shifts and degrade the generalization of deep learning models on unseen data. Existing batch correction methods typically rely on additional prior knowledge (e.g., treatment or cell culture information) or struggle to generalize to unseen bio-batches. In this work, we frame bio-batch mitigation as a Domain Generalization (DG) problem and propose Adversarial Batch Representation Augmentation (ABRA). ABRA explicitly models batch-wise statistical fluctuations by parameterizing feature statistics as structured uncertainties. Through a min-max optimization framework, it actively synthesizes worst-case bio-batch perturbations in the representation space, guided by a strict angular geometric margin to preserve fine-grained class discriminability. To prevent representation collapse during this adversarial exploration, we introduce a synergistic distribution alignment objective. Extensive evaluations on the large-scale RxRx1 and RxRx1-WILDS benchmarks demonstrate that ABRA establishes a new state-of-the-art for siRNA perturbation classification.}
}
@article{ZHANG2026115698,
title = {MIFSO-Net: A 3D point cloud registration network using multilevel contextual feature interaction and saliency-Guided overlap enhancement},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115698},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115698},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126004387},
author = {Yinuo Zhang and Xuchu Wang},
keywords = {3D Point cloud registration, Multi-level graph contextual feature interaction, Graph convolution, Transformer, Overlap correspondences},
abstract = {3D point cloud registration is fundamental to applications such as autonomous driving, SLAM, 3D reconstruction, and precision measurement. However, challenges like low overlap and geometric ambiguity often lead to registration failure. To address this, we propose MIFSO-Net, a novel registration framework that combines multi-level graph contextual feature interaction with saliency-guided overlap enhancement. MIFSO-Net consists of three key modules: (1) a multi-scale graph aggregation module for capturing rich contextual features; (2) a multi-level context Transformer to mitigate feature homogenization from stacked attention layers; and (3) a mask-based overlap prediction module that leverages point-wise saliency to refine correspondence selection. Extensive experiments on ModelNet, 3DMatch, 3DLoMatch, KITTI Odometry, and industrial datasets show that MIFSO-Net outperforms state-of-the-art methods, improving registration recall by 4.1% on 3DMatch and 14.4% on 3DLoMatch, demonstrating strong performance and generalization.}
}
@article{LAI2026115780,
title = {A hybrid knowledge-based recommendation system driven by modeling fashion design semantics},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115780},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115780},
url = {https://www.sciencedirect.com/science/article/pii/S095070512600506X},
author = {Yangyu Lai and Xianyi Zeng and Yan Hong and Xiaoqun Dai},
keywords = {Recommendation system, Fashion design knowledge representation, Knowledge graphs and embeddings, Hybrid semantic-structural learning, Affective computing},
abstract = {Personalized fashion design recommendation requires accurate reasoning over complex semantic relationships linking fashion attributes, affective styles, and user preferences. The existing knowledge graph-based approaches can provide structured representations but often have problems to capture long-range relational dependencies and subtle semantic similarities between fashion concepts, leading to incomplete or noisy reasoning paths. To address these drawbacks, we propose a semantic-aware fashion recommendation framework (KGNBF) that integrates global semantic representations with graph-based multi-hop reasoning. Concretely, the global semantic embeddings derived from GloVe are used to encode latent relationships between fashion attributes and affective styles, while a Neural Bellman–Ford Network (NBFNet) performs multi-hop relational reasoning over the fashion knowledge graph. To further enhance graph completeness and robustness, we have introduced a hybrid similarity measure that combines Longest Common Subsequence (LCS) analysis with intra-class semantic aggregation to infer missing links between design elements and affective style labels. The proposed framework has been evaluated on a large-scale, dynamically evolving fashion knowledge base containing over 30,000 fashion products. Experimental results have shown an improvement of approximately 5% in recommendation accuracy compared with static graph-based baselines. In addition, a user study has reported an average satisfaction score of 4.29 out of 5 and an acceptance rate of 80.19%, which confirms that the framework can generate accurate, interpretable, and user-aligned fashion design recommendations.}
}
@article{NIU2026115801,
title = {Semi-supervised disentangled representation for long-tailed learning in remote sensing images},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115801},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115801},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005277},
author = {Jiawei Niu and Lizhuo Liu},
keywords = {Long-tailed learning, Image generation, Generative adversarial model, Contrastive representation learning, Remote sensing images},
abstract = {Long-tailed learning remains a critical challenge in remote sensing, where class distributions are often highly imbalanced. Although existing long-tailed methods have shown substantial progress, most of them rely on fully labeled datasets, limiting their practicality in real-world scenarios. The challenge is further exacerbated in remote sensing, where large-scale, fine-grained images make manual annotation extremely costly, while unlabeled data are much easier to obtain. Consequently, learning effectively from long-tailed data when only a small portion is labeled becomes particularly difficult. To address this issue, we propose a semi-supervised disentangled representation learning method (SDR-LT) for long-tailed classification. SDR-LT leverages an InfoGAN-based architecture to disentangle class identity as a controllable latent factor, enabling category-aware sample generation for augmenting tail classes. In addition, auxiliary networks are introduced to guide the generator in disentangling high-level semantic features and in producing more realistic, semantically consistent samples. Experiments on the MSTAR and HRSC datasets demonstrate that SDR-LT consistently achieves superior performance compared to other related long-tailed learning methods under limited-label conditions.}
}
@article{ZHAO2026115853,
title = {Multi-focus image fusion based on multi-scale feature extraction and edge preservation techniques},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115853},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115853},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005794},
author = {Baojun Zhao and Fei Luo and Luis Rojas Pino and Weichao Ding and Xueqin Zhang},
keywords = {Multi-focus image fusion, Unsupervised learning, Multi-scale feature extraction, Edge-preserving filtering, Manifold theory},
abstract = {As a popular image enhancement technique, decision map-based multi-focus image fusion (MFIF) integrates partially focused images into fully focused composites without the problem of image distortion. However, conventional decision map-based methods face dual limitations: (1) Encoders in existing unsupervised methods cannot fully capture contextual information, which weakens the robustness of activity-level measurement. (2) Post-processing techniques lose edge consistency between decision maps and source images, caused by defocus spread effects at focus boundaries. To address those issues, we propose EP-MFIF, an unsupervised framework that synergizes multi-scale contextual modeling and geometry-aware edge preservation. First, a multi-branch convolution-based encoder with triple-branch receptive fields (5×5, 9×9, 13×13) is proposed to capture multi-scale contextual features, enabling robust activity-level measurement while preserving spatial resolution. Second, as our core contribution, the post-processing is designed as a geometry-aware, manifold-based refinement module that redefines the distance metric (curvature-consistent three-point geodesic) and performs an isometric 1D domain transformation, enabling recursive joint filtering that tightly adheres to focus boundaries and outperforms guided/bilateral variants in MFIF. Third, boundary-consistent focus and defocus masks are generated via a concise two-stage fusion coupling spatial-frequency activity estimation with edge-preserving refinement. Evaluated on the Lytro dataset, EP-MFIF achieves state-of-the-art performance, improving the Qmi metric by 2.8% over existing unsupervised methods. The methodology effectively bridges multi-scale feature integration with edge-preserving theory, offering practical value for applications requiring precise focus boundary determination in microscopy, computational photography, and optical inspection systems.}
}
@article{AHN2026115821,
title = {Energy-ensemble concept bottleneck models for enhancing interpretability and accuracy in concept-based learning},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115821},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115821},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005472},
author = {Dasom Ahn and Sangwon Kim and Byoung Chul Ko},
keywords = {Explainable AI, Concept bottleneck models, Energy-based models},
abstract = {Concept bottleneck models (CBM) have emerged as a promising solution to address the lack of interpretability in deep learning models. Recent CBM studies often achieve strong task and concept accuracy by leveraging high-capacity architectures or auxiliary prediction paths. However, high concept accuracy alone does not guarantee that concepts are reliably used as causal and intervenable decision variables, which is critical for practical interpretability. The EE-CBM leverages an energy-based concept encoder to effectively extract concepts, overcoming the information bottleneck common in conventional CBMs. Additionally, a novel energy ensemble gate within the EE-CBM architecture efficiently combines concept probability and embedding to further address this bottleneck. Moreover, the EE-CBM employs the maximum mean discrepancy loss to enhance concept discrimination within the concept space and facilitate accurate concept inference. Across CUB-200-2011, TravelingBirds, AwA2, and CheXpert datasets, EE-CBM shows consistent gains in concept accuracy and competitive task performance, suggesting improved interpretability without sacrificing accuracy. This work positions the EE-CBM as a notable step forward in CBM researches, enabling them to effectively balance performance and interpretability for improved model transparency.}
}
@article{WANG2026115686,
title = {Towards effective few-shot OOD detection for text-attributed graphs via topology-Text consensus modeling},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115686},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115686},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126004260},
author = {Xu Wang and Yinlin Zhu and Xunkai Li and Meixia Qu and Wenyu Wang},
keywords = {Graph out-of-Distribution detection, Few-shot learning, Text-attributed graphs},
abstract = {Text-attributed graphs (TAGs) represent complex relational data by integrating rich textual semantics with structural topologies. Despite recent progress in TAG-based graph learning, models trained on TAGs remain highly vulnerable to open-world distribution shifts. Existing out-of-distribution (OOD) detection methods predominantly follow a post-hoc paradigm, which suffers from two fundamental limitations: (L1) excessive reliance on in-distribution (ID) supervision, and (L2) a lack of explicit OOD modeling, both of which lead to sub-optimal OOD detection performance. To this end, we propose Topology-Text Consensus Modeling (TTCM), a framework that facilitates a shift from passive scoring to in-training modeling. Specifically, TTCM addresses L1 and L2 in a two-pronged manner: (1) Structure-Semantic Dual Augmentation (SSDA), which expands the limited supervision by retrieving high-recall ID candidates and generating explicit OOD concepts, and (2) Consensus-Gated EM Training (CGEM), a concurrent process that fosters mutual enhancement between reliability estimation and representation learning. Adopting an alternating optimization procedure, CGEM utilizes the Distribution-Aware Reliability Estimator (DARE) in the E-step to explicitly define consensus via a triangular consistency check : topology-text alignment, topology-prototype alignment, and text-prototype alignment. These reliability scores then serve as dynamic gates in the M-step to guide the encoders, rigorously filtering unreliable data to shape a robust decision boundary. Extensive Experiments on six benchmarks demonstrate that TTCM consistently outperforms state-of-the-art baselines. Our code is available at https://github.com/XuWang05/TTCM.}
}
@article{KUMARD2026115813,
title = {Generative AI based blockchain framework for secure and private communication in internet of drones systems},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115813},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115813},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005393},
author = {Nagendra {Kumar D} and Sundarakantham K and Dharani J and Kunwar Singh},
keywords = {Privacy preservation, GAN, zK-SNARK, Hyperledger fabric, PBFT, Secure drone communication},
abstract = {The Internet of Drones (IoD) enables drone-to-everything (D2X) communication across users, peer UAVs, and ground infrastructure, but securing these interactions while preserving privacy and ensuring anomaly resilience remains a critical challenge. Existing solutions typically address authentication, anomaly detection, or consensus in isolation, leading to inefficiencies and limited scalability. This paper introduces Generative AI based Blockchain Framework for Internet of Drones system (GAIBIoD), that unifies Zero-Knowledge Succinct Non-Interactive Arguments of Knowledge (zk-SNARKs) for privacy-preserving identity authentication, Generative Adversarial Networks (GANs) for real-time anomaly detection, and Practical Byzantine Fault Tolerance (PBFT) style ordering mechanism deployed on top of Hyperledger Fabric for tamper-resistant consensus. The GAN model, trained on Unmanned Aerial Vehicle (UAV) behavioral data, outperformed Long Short-Term Memory (LSTM) and Autoencoder (AE) baselines, achieving 98.4% detection accuracy. A prototype implementation demonstrated strong efficiency, with a cumulative communication cost of 1752 bits, computation time of 38.6 ms, latency of 137 ms, throughput of 91 communications per second, and energy consumption of 0.92 J per full cycle. These results validate GAIBIoD as a scalable and resource-efficient framework for secure, privacy-preserving, and verifiable communication in dynamic IoD environments.}
}
@article{WANG2026115789,
title = {Robustness controlled adversarial graph convolutional network for multi-view semi-supervised classification},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115789},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115789},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005150},
author = {Jianghua Wang and Zhicheng Wei and Zhibin Shi and Na Song and Shiping Wang},
keywords = {Multi-view learning, Graph convolutional network, Semi-supervised classification, Adversarial learning, Robustness controlling},
abstract = {Multi-view learning based on graph convolutional networks can capitalize on supervisory information from heterogeneous data views to improve performance, thereby attracting increasing attention in various practical fields. Although existing research and applications have made significant progress, they mostly consider feature and topological structure learning separately, resulting in underutilization of learned representations or topological structures and susceptibility to noise. To address these challenges, we first propose a bi-level optimization framework for an interpretable graph neural network in an end-to-end manner, then introduce adversarial training into multi-view learning, modeling the multi-view adversarial graph convolutional problem as a minimax optimization problem. Specifically, the lower-level optimization maximizes graph regularization within a robust control range to refine the graph Laplacian, while the upper-level minimizes the loss caused by the lower-level perturbations to enhance representation robustness. This jointly improves model adaptability to noisy data. The proposed approach aims to synchronize representation learning and topological adjustment to ensure effective information transfer between features and topological structures. It represents an efficient solution for multi-view graph convolutional networks within the dynamic graph structure learning paradigm. Extensive experiments validate our method’s effectiveness across diverse real-world multi-view datasets.}
}
@article{SHI2026115781,
title = {LiDAR-guided multi-modal fusion for dynamic hyperspectral band selection},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115781},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115781},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005071},
author = {Cuiping Shi and Zexin Zeng and Weiwei Sun and Kaijie Shi and Fei Zhu},
keywords = {Hyperspectral Image, LiDAR data, Multi-modal fusion, Bidirectional cross-attention, Dynamic band selection},
abstract = {Existing band selection methods are mostly designed for single-modality data, which often ignore the potential advantages of elevation information in multimodal datasets, resulting in limited comprehensiveness and accuracy in information mining. Meanwhile, these methods are prone to losing key information during the feature fusion stage. To address this issue, a method called LiDAR-guided multi-modal fusion for dynamic hyperspectral band selection (LGMF-DBS) is proposed. First, a wavelet transform deformable convolution (WTDefconv) is proposed to effectively capture multiscale features. Second, a multi-scale feature alignment fusion module (MSFAFM) is designed to adaptively align hyperspectral and LiDAR data features. Then, a bidirectional cross-attention fusion module (BCAFM) is constructed to effectively fuse hyperspectral and LiDAR data. Finally, a dynamic band selection module based on Top-k sparse attention (DBSM-TKSA) is designed to automatically learn band weights and select the optimal bands. Extensive experimentation reveals that compared to other advanced methods, the proposed band selection method achieves the best classification performance on three public datasets—Houston 2013, Trento, and MUUFL—which fully demonstrates its effectiveness.}
}
@article{ISLAM2026115762,
title = {An audio-video based multi-modal fusion approach for emotion recognition},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115762},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115762},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126004909},
author = {S M Jishanul Islam and Sahid Hossain Mustakim and Musfirat Hossain and Mysun Mashira and Nur Islam Shourav and Md Rayhan Ahmed and Salekul Islam and A.K.M. Muzahidul Islam and Swakkhar Shatabda},
keywords = {Deep learning, Multimodal deep learning, Convolutional neural network, Squeeze-and-Excitation network, Frame filtering, Emotion recognition},
abstract = {Multi-modal deep learning leverages complementary information from multiple data sources, such as audio and video, to improve the robustness of emotion recognition systems. However, effectively integrating heterogeneous features across modalities remains challenging. In this paper, we propose a multi-modal architecture that jointly models audio and visual information for emotion classification. The framework employs a pre-trained R(2+1)D network to extract spatiotemporal representations from video inputs through the combination of 2D spatial and 1D temporal convolutions within a residual learning structure. For the audio modality, multiple acoustic representations-including root-mean-square energy, zero-crossing rate, mel-frequency cepstral coefficients, and mel-spectrogram features averaged along the temporal dimension-are processed using dedicated 1D convolutional networks augmented with a squeeze-and-excitation module for channel-wise feature recalibration. The extracted audio and video features are fused and passed to a Softmax classifier for emotion prediction. The proposed approach is evaluated on three benchmark datasets: the Ryerson Audio–Visual Database of Emotional Speech and Song (RAVDESS), the Surrey Audio–Visual Expressed Emotion (SAVEE), and the Crowd-Sourced Emotional Multimodal Actors Dataset (CREMA-D). Experimental results demonstrate strong performance, achieving F1-scores of 0.9711, 0.9965, and 0.8990 on RAVDESS, SAVEE, and CREMA-D, respectively, showing competitive performance with recent state-of-the-art methods. The code and trained models are publicly available at https://github.com/S-M-J-I/Multimodal-SER.}
}
@article{YUCELALTAY2026115581,
title = {Q-rung picture fuzzy sets theory-based ensemble learning method for credit risk assessment},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115581},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115581},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126003217},
author = {Şeyma {Yücel Altay} and Betül {Turanoğlu Şirin}},
keywords = {Credit risk assessment, Machine learning, q-rung picture fuzzy sets, Feature selection, Stacking model},
abstract = {Credit risk assessment is conducted to assess the credit repayment capacity of a customer and determine the associated risk level. Traditional methods often face limitations in the effective modeling of uncertainties and the management of large datasets, highlighting the need to improve the risk management processes of banks. In addition, evaluating credit risk is essential to guide decision-making mechanisms within financial organizations; however, traditional approaches often struggle with the complexity and uncertainty involved. q-rung picture fuzzy sets (q-RPFSs), a theory well known for its ability to handle uncertainty, offer significant potential to address these challenges. In this study, we propose a novel framework that integrates q-RPFS-based feature selection with a stacking ensemble learning method to enhance predictive performance. The framework was tested on the German credit dataset. The findings demonstrated the effectiveness of the method, achieving an accuracy of 0.768 and an AUC of 0.792 on the German dataset, placing it among the top-performing approaches in the literature. Additionally, comparative experiments were conducted using several widely adopted fuzzy-MCDM methods. These included fuzzy Analytic Hierarchy Process (fuzzy-AHP), fuzzy Best Worst Method (fuzzy-BWM), and fuzzy Criteria Importance Through Intercriteria Correlation (fuzzy-CRITIC). The results indicated that the proposed q-RPFSs-based approach consistently outperforms these alternative techniques in terms of predictive performance. As a result, by integrating q-RPFSs with machine learning, this approach not only introduces innovative solutions to the financial sector but also provides a robust framework for handling uncertainty in real-world decision-making, thereby advancing the state of the art in intelligent systems.}
}
@article{SONG2026115755,
title = {A curriculum-guided semi-supervised learning framework for joint entity and relation extraction},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115755},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115755},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126004867},
author = {Haodong Song and Chen Li and Tianyuan Hu and Yuanfei Dai},
keywords = {Entity relation extraction, Semi-supervised learning, Curriculum learning, Self-training mechanism},
abstract = {Entity relation extraction (ERE) is crucial for various natural language processing tasks but is often hindered by the need for large annotated datasets. Current supervised ERE methods struggle in data-scarce scenarios due to the high cost and effort of annotation. To address this limitation, this paper proposes CSJE, a novel Curriculum-guided Semi-supervised learning framework for Joint entity relation Extraction. CSJE integrates semi-supervised learning with a curriculum learning strategy inspired by human cognitive processes. The framework initially trains a model on labeled data partitioned by a novel difficulty metric based on entity and relation overlap, progressing from simple to complex examples. Subsequently, it employs a self-training mechanism with an adaptive dynamic threshold to generate high confidence pseudo labels for large amounts of unlabeled data. This approach iteratively expands the training set and refines the model following a teacher-student framework. Experimental evaluations on three benchmark datasets demonstrate that CSJE significantly improves ERE performance.Specifically, in low-resource settings, the CSJE framework achieves an improvement of 1% to 5% in F1 score compared to traditional supervised methods. The framework shows high generalizability and compatibility with existing ERE models, effectively optimizing model performance and robustness by leveraging both limited labeled data and extensive unlabeled data.}
}
@article{YU2026115805,
title = {Class-Balanced and fast active learning for graph neural networks via reinforcement learning},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115805},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115805},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005319},
author = {Chengcheng Yu and Jiapeng Zhu and Xiang Li},
keywords = {Active learning, Class balance, Graph neural network, Reinforcement learning},
abstract = {Graph neural networks (GNNs) have recently demonstrated significant success. Active learning for GNNs aims to query the valuable samples from the unlabeled data for annotation to maximize the GNNs’ performance at a low cost. However, most existing methods for reinforced active learning in GNNs may lead to a highly imbalanced class distribution, especially in highly skewed class scenarios. This further adversely affects the classification performance. To tackle this issue, in this paper, we propose a novel reinforced Class-Balanced Active Learning framework for GNNs, namely, GraphCBAL. It learns an optimal policy to acquire class-balanced and informative nodes for annotation, maximizing the performance of GNNs trained with selected labeled nodes. GraphCBAL designs class-balance-aware states, as well as a reward function that achieves a trade-off between model performance and class balance. We further upgrade GraphCBAL to GraphCBAL++ by introducing a punishment mechanism to obtain a more class-balanced labeled set. To improve the efficiency of GraphCBAL, we propose BGraphCBAL, a batch-mode extension that selects multiple nodes for labeling at each iteration. We formulate batch active learning as a cooperative multi-agent reinforcement learning problem. We further design a multi-agent policy network that not only accounts for the informativeness and class balance of candidate nodes, but also models interactions among nodes selected within the same batch. Extensive experiments on multiple datasets demonstrate the effectiveness and efficiency of the proposed approaches, achieving superior performance over state-of-the-art baselines. In particular, our methods can strike a balance between classification results and class balance. We provide our code and data at https://github.com/cici-chengcheng/GraphCBAL.}
}
@article{WU2026115702,
title = {Triple-constrained and assumption-based zero-shot logical reasoning in reading comprehension},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115702},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115702},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126004429},
author = {Xin Wu and Yuqi Bu and Yi Cai and Tao Wang},
keywords = {Logical reasoning, Large language models, Logical reading comprehension, Assumption-based reasoning},
abstract = {The task of zero-shot logical reasoning in reading comprehension requires machines to identify logically valid answers based on contexts and questions without task-specific fine-tuning. Existing Large Language Models (LLMs)-based methods select answers from several sampling results with a majority voting. However, this type of method suffers from the issue of majority bias, i.e., the answer with a majority of votes may not be the correct answer. They lack a mechanism to validate the correctness of the majority answers and cannot identify potential non-major correct answers. In this article, we propose a Triple-constrained and Assumption-based Reasoning framework (TAR), which utilizes large language models (a type of deep neural network) for logical reasoning in reading comprehension. To address the issue of majority bias in reasoning results from a single perspective and lack of validation, TAR collects LLMs’ reasoning results constrained by three perspectives: implication, irrelevance, and contradiction. By cross-validating the results from these three perspectives, incorrect answers with a majority of votes from a single perspective can be avoided. To address the issue of overlooking non-major answers, TAR adopts assumption-based reasoning to push LLMs to proactively explore potential reasons for the correctness of non-major answers, thus uncovering more potential correct answers. Experiments on two logical reasoning reading comprehension datasets demonstrate that TAR outperforms existing methods by over 5.1%, 4.2%, and 4.7% on three LLMs, respectively. Additionally, TAR effectively reduces 7.9% incorrect answers caused by majority bias and discovers 8.3% additional potential answers.}
}
@article{YE2026115767,
title = {Stochastic social learning optimization: Combining social learning and bucket theory for efficient optimization},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115767},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115767},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126004946},
author = {Jiaojiao Ye and Khamron Sunat and Sirapat Chiewchanwattana},
keywords = {Metaheuristic optimization, Stochastic social learning, Bucket theory, Engineering validation, Feature selection},
abstract = {This paper introduces Stochastic Social Learning Optimization (SSLO), a novel metaheuristic algorithm inspired by social learning theory and bucket theory. SSLO establishes a distinctive optimization framework by simulating human knowledge acquisition mechanisms, including observation, imitation, and social interaction. When knowledge accumulation reaches a critical threshold, the algorithm triggers stochastic inspiration bursts by incorporating neighborhood knowledge, thereby achieving a dynamic balance between exploration and exploitation. Simultaneously, by integrating bucket theory, SSLO prevents overall performance degradation caused by weak components through proactive reinforcement and directional exploration, effectively avoiding premature convergence. Furthermore, SSLO promotes innovative search behavior through knowledge exchange among individuals and employs an assessment mechanism to refine the optimization trajectory for subsequent social learning stages. The performance of SSLO is evaluated through a systematic combination of qualitative and quantitative analysis. Qualitative analysis investigates the internal working mechanisms of the algorithm in terms of convergence behavior, population distribution, and exploration-exploitation balance. Quantitative evaluation is conducted on the CEC2017 and CEC2022 benchmark functions, complemented by parameter sensitivity analysis, bucket-effect ablation experiments, and runtime efficiency assessment. Experimental results demonstrate that, compared with ten well-established optimization algorithms, SSLO exhibits remarkable advantages in global optimization, local optima escape, convergence performance, stability, and robustness. Notably, even under extreme computational conditions with only two candidate solutions, SSLO maintains strong optimization performance. Furthermore, its successful validation on four constrained engineering optimization problems and feature selection tasks further demonstrates the effectiveness and practical applicability of SSLO in solving real-world problems.}
}
@article{LIU2026115828,
title = {MedAugment: Universal automatic data augmentation plug-in for medical image analysis},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115828},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115828},
url = {https://www.sciencedirect.com/science/article/pii/S095070512600554X},
author = {Zhaoshan Liu and Qiujie Lv and Yifan Li and Ziduo Yang and Lei Shen},
keywords = {Data augmentation, Medical image analysis, Image classification, Image segmentation},
abstract = {Data augmentation (DA) has been widely leveraged in computer vision to alleviate data shortage, while its application in medical imaging faces multiple challenges. The prevalent DA approaches in medical image analysis encompass conventional DA, synthetic DA, and automatic DA. However, these approaches may result in experience-driven design and intensive computation costs. Here, we propose a suitable yet general automatic DA method for medical images termed MedAugment. We propose pixel and spatial augmentation spaces and exclude the operations that can break medical details and features. Besides, we propose a sampling strategy by sampling a limited number of operations from the two spaces. Moreover, we present a hyperparameter mapping relationship to produce a rational augmentation level and make the MedAugment fully controllable using a single hyperparameter. These configurations settle the differences between natural and medical images. Extensive experimental results on four classification and four segmentation datasets demonstrate the superiority of MedAugment. Compared with existing approaches, the proposed MedAugment prevents producing color distortions or structural alterations while involving negligible computational overhead. Our method can serve as a plugin without an extra training stage, offering significant benefits to the community and medical experts lacking a deep learning foundation. The code is available at https://github.com/NUS-Tim/MedAugment.}
}
@article{ATTWA2026115730,
title = {Genetic algorithm for parameter estimation of the alpha power transformed GEVL distribution: A time series forecasting approach vs. return level analysis},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115730},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115730},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126004703},
author = {Rasha Abd El-Wahab Attwa and Shimaa Wasfy Sadk and Hassan M. Aljohani},
keywords = {Time series, Genetic algorithm (GA), Alpha power transformation, , Bayesian estimation, Maximum likelihood estimation},
abstract = {In this article, a new distribution family called the alpha power transformation of the generalized extreme value distribution with linear normalization (APT−GEVL), is proposed and investigated. Since adding a parameter to any baseline distribution enhances its flexibility for better representation of the real data but complicates the process of maximum likelihood estimation (MLE), this problem is addressed using the genetic algorithm (GA). Furthermore, the new parameter adjusts the distribution’s properties, demanding a further examination of its effects. So, both of MLE and Bayesian estimation (BE) for APT−GEVL parameters are considered under type II progressive censoring for three cases of removals (fixed, binomial, and discrete uniform random removal). Additionally, BE is considered for informative and non-informative priors under both square error and LINEX loss functions using Lindley approximation. To demonstrate the effectiveness of the new parameter to GEVL, increased fitting has been noticed for U.S. employment rate data, which is subsequently utilized for forecasting future outcomes using both return level and time series methods.}
}
@article{LEUNG2026115706,
title = {From entity-centric to goal-oriented graphs: Enhancing LLM knowledge retrieval in minecraft},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115706},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115706},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126004466},
author = {Jonathan Leung and Yongjie Wang and Zhiqi Shen},
keywords = {Large language models, Retrieval-augmented generation, Knowledge graph, AI agents, Procedural reasoning},
abstract = {Large Language Models (LLMs) demonstrate impressive general capabilities but often struggle with step-by-step procedural reasoning, a critical challenge in complex interactive environments. While retrieval-augmented methods like GraphRAG attempt to bridge this gap, their fragmented entity-relation graphs hinder the construction of coherent, multi-step plans. In this paper, we propose a novel framework based on Goal-Oriented Graphs (GoGs), where each node represents a goal and edges encode logical dependencies between them. This structure enables the explicit retrieval of causal reasoning paths by identifying a high-level goal and recursively retrieving its prerequisites, forming a coherent chain to guide the LLM. Through extensive experiments on the Minecraft testbed, a domain that demands robust multi-step planning and provides rich procedural knowledge, we demonstrate that GoG substantially improves procedural reasoning and significantly outperforms GraphRAG and other state-of-the-art baselines.}
}
@article{COMBS2026115772,
title = {Analogy2kg: An automatic pipeline for deriving knowledge graphs from long-text analogies},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115772},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115772},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126004983},
author = {Kara Combs and Lance Champagne and Bruce Cox and Christine {Schubert Kabban} and Trevor Bihl and Grace Lemming},
keywords = {Analogical reasoning, Information extraction, Knowledge graphs, Natural language processing, Text mining},
abstract = {Analogical reasoning is an increasingly popular, lightweight solution to enable large language model (LLM)-level reasoning without computational complexity. Still, it has yet to be adopted due to its reliance on strictly hand-formatted data. Therefore, we propose Analogy2KG (“Analogy to Knowledge Graph”), as an automatic pipeline that transforms text into a KG format via a fine-tuned version of information extraction (IE) algorithms for long-text analogies. The need to verify that the complex underlying analogical structure of the data is maintained was done via paired samples tests in the creation and validation of this pipeline. Graph density was used to evaluate the structural quality of the resulting KGs. Lastly, causal relationships were optionally detected using a novel, question-and-answer-based method. Analogy2KG was validated on the Rattermann and Wharton long-text datasets, which suggested that the proposed methodology maintains analogical structure when transforming from text to KGs. The resulting RattermannKG and WhartonKG datasets were introduced to the literature, which is the first instance of a conversion of long-text analogy dataset into a KG format in the literature. Finally, Analogy2KG had superior performance among three LLM-enabled information extraction algorithms: ChatIE, Code4UIE, and InstructUIE for maintaining analogical structure, despite operating without the need for an LLM backend and a pre-defined relation extractor list; thus, making it an ideal lightweight solution.}
}
@article{LI2026115746,
title = {PLATO: ProbabiListic hierArchical mulTi-head mOdel for plug-and-play ambiguous medical image segmentation},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115746},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115746},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126004788},
author = {Xiangyu Li and Fanding Li and Yongfeng Yuan and Suyu Dong and Kuanquan Wang and Yi Shen and Guohua Wang and Gongning Luo and Shuo Li},
keywords = {Ambiguous medical image segmentation, Evidential deep learning, Hierarchical multi-head model, Plug-and-play},
abstract = {Ambiguous medical image segmentation (AMIS) is crucial for computer-aided diagnosis. Current AMIS approaches generally require training specialized models from scratch, which neglects the discriminative capabilities of existing deterministic segmentation models. To address this, we propose PLATO (ProbabiListic hierArchical mulTi-head mOdel), the first plug-and-play AMIS framework that integrates with arbitrary deterministic segmentation backbones while introducing ambiguity in a fully model-agnostic manner. PLATO features a novel Probabilistic Hierarchical Multi-head Structure (PHMS) that captures inherent ambiguity by hierarchically modeling local ambiguity and global consistency, generating diverse yet anatomically plausible predictions. Additionally, we introduce an Evidence-based Belief Assignment (EBA) module to manage uncertainty entanglement through joint modeling of aleatoric and epistemic uncertainty via Dirichlet-based exponential evidential deep learning. EBA provides a unified, disentangled uncertainty quantification framework that is reliable and interpretable. Extensive experiments on three public datasets demonstrate that PLATO outperforms existing AMIS methods. Specifically, our PLATO achieves relative improvement compared with existing methods by a maximum of 43.1% on GED100 (PhC Dataset), 60.78% on Brier Score and 0.49% on HM-IoU32 (LIDC Dataset), 26.2% on ECE (ISIC Subset) following commonly used experimental settings and random seed=230. The proposed PLATO establishes a practical and generalizable plug-and-play solution for ambiguous medical image segmentation. Source code is publicly available at https://github.com/PerceptionComputingLab/PLATO.}
}
@article{SHAO2026115802,
title = {Domain generalization method based on causal disentanglement network for the fault diagnosis of axial piston pumps},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115802},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115802},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005289},
author = {Yuechen Shao and Qun Chao and Pengcheng Xia and Zhiqiang Zhang and Chengliang Liu},
keywords = {Axial piston pump, Fault diagnosis, Domain generalization, Causal disentanglement network},
abstract = {The significant discrepancies in data distributions pose substantial challenges for traditional deep learning methods in the fault diagnosis of axial piston pumps. Moreover, domain adaptation techniques often fail to achieve effective alignment between source and target domains in the absence of target data. To address fault diagnosis under unseen operating conditions, this paper proposes a domain generalization method based on a causal disentanglement network (CDN), which introduces a novel integration of causal learning (CL) and data augmentation. First, two encoders are employed to separately extract causal and non-causal features from the source data, while two classifiers are used to predict both fault and domain labels for the extracted features. In addition to the standard classification loss, a causal aggregation loss and a redundancy reduction loss are designed to enforce disentanglement between causal and non-causal features. Second, a decoder is introduced to reconstruct the source data, ensuring that critical information is preserved within the causal features. Unlike conventional CDNs, the proposed decoder further generates augmented data to enhance the training of the encoder and classifier, thereby improving the overall generalization capability of the network. The effectiveness of the proposed method is evaluated across multiple transfer tasks at varying rotational speeds and discharge pressures. Experimental results demonstrate that the proposed method outperforms state-of-the-art domain generalization methods.}
}
@article{LIU2026115786,
title = {Two-stage surrogate-assisted bi-cooperative optimization algorithm for high-dimensional expensive problems},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115786},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115786},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005125},
author = {Jiansheng Liu and Kun Zhang and Zan Yang and Yuanhao Liu and Haobo Qiu and Liang Gao and Yunping Wang and Bin Yuan},
keywords = {High-dimensional expensive optimization, Radial basis function, Dimension perturbation mutation, Surrogate-assisted evolutionary algorithm},
abstract = {To solve high-dimensional expensive problems, this paper proposes a two-stage surrogate-assisted bi-cooperative optimization algorithm (TSSABC) in which two collaborative frameworks of global and local surrogates-based optimization are effectively cooperated in the current promising and historical potential regions respectively. For the first one, local RBF-based JADE with historical position exclusion is combined with dynamic coordinate search using response surface (DYCORS) models for local and global search, effectively exploring the current promising region and accelerating convergence. For the second one, the local RBF-based JADE algorithm repositions the best solution within the historical potential region. Two approximate center solutions, i.e., dimension-based and space-based, are reconstructed using the Parzen window method. DYCORS-based global search then investigates these solutions to efficiently explore the historical trajectory from previous iterations. Additionally, an adaptive intervention mechanism adjusts the search focus by incorporating greedy information if the two frameworks fail to yield positive optimization progress over several successive iterations. Experimental results on three different test suites demonstrate that TSSABC outperforms classical and state-of-the-art algorithms in terms of performance.}
}
@article{WANG2026115838,
title = {CASE-TCR: Content aware and sparse selection attention driven learning framework for pan-cancer prediction using T-cell receptor sequences},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115838},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115838},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005642},
author = {Diandian Wang and Tong Jin and Guoliang Wang and Shuai Liu and Kun Wang and Dianlin Hu and Jin Liu and Xilin Liu},
keywords = {T cell receptor, Sparse coattention, Content aware, Cancer prediction},
abstract = {The T cell receptor (TCR) repertoire represents a vital indicator of cancer-related immune activity and holds significant potential for immunodiagnostics. Despite recent progress, existing computational models often inadequately capture the complex interdependencies among TCR sequences and struggle to detect the sparse presence of cancer-associated TCRs (caTCRs). These shortcomings restrict both the precision of early-stage cancer identification and the generalizability of prediction models across diverse cancer types. To overcome the limitations of existing models, we introduce CASE-TCR, which is an advanced deep learning architecture that is built upon three core components. First, CASE-TCR employs a dynamic protein-BERT encoder in combination with Sparsemax attention to extract contextual features from CDR3 sequences; second, it incorporates a dual-sparsification coattention mechanism that leverages both TopK filtering and Sparsemax to emphasize informative motifs while minimizing background noise; and third, a self-contrastive learning approach that utilizes dual-view augmentation techniques, including random position masking and amino acid substitution, to enhance the prediction of infrequent cancer-associated TCRs is adopted. The model architecture further integrates multiscale convolutional neural networks with kernel sizes from 2–7 alongside a five-model ensemble strategy to ensure stable and accurate predictions. Evaluated across 10 cancer types with samples from 1164 patients, CASE-TCR achieved a promising improvement. Its consistent robustness across diverse cancer types underscores the strong potential of CASE-TCR as a scalable pan-cancer screening framework for both clinical and research applications.}
}
@article{KANG2026115727,
title = {DABD: Direction alignment–based backdoor defense with sign consensus in federated learning},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115727},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115727},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126004673},
author = {Jie Kang and Ruizhong Du and Xiaoyu Zhang},
keywords = {Federated learning, Backdoor defense, Direction alignment, Sign consensus, Adaptive aggregation},
abstract = {As a privacy-preserving distributed machine learning paradigm, federated learning (FL) has been widely adopted in critical sectors, including healthcare and finance. However, its open participation mechanism exposes the global model to severe threats from backdoor attacks. Existing defense mechanisms are often constrained by the coupling of benign statistical heterogeneity and malicious attack stealthiness within the feature space. To address these challenges, we designed direction alignment and sign consensus backdoor detection (DABD), a novel dual-dimensional consistency detection framework combined with adaptive weighted fusion. In particular, first, it employs cosine similarity for computing a direction alignment score, capturing shifts in the global optimization trend. Then, it utilizes a majority voting mechanism on Top-K parameter updates to derive a sign consensus score, identifying subtle malicious sign flipping on critical dimensions often overlooked by holistic directional metrics. Finally, a temperature-controlled SoftMax function maps these dual scores into aggregation weights, enabling threshold-free suppression of malicious gradients. Extensive experiments on three benchmark datasets demonstrate that DABD effectively mitigates sophisticated attacks, including Neurotoxin, achieving substantial improvements in the main task accuracy and considerable reductions in the attack success rate as compared to the state-of-the-art baselines.}
}
@article{ZHU2026115778,
title = {Beyond feature concatenation: Mutual information-driven fusion for multimodal sequential recommendation},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115778},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115778},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005046},
author = {Haodong Zhu and Chenhao Yang and Hongchan Li and Zhongchuan Sun and Yajuan Cui and Yanpei Liu and Liang Zhu},
keywords = {Sequence recommendation, Mutual information optimization, Multimodal, Information fusion, Information bottleneck},
abstract = {Sequential recommendation leverages historical user interactions to predict future preferences and has achieved strong progress. With the growth of item content, multimodal sequential recommendation incorporates modalities such as images and text, offering richer signals for preference modeling. However, effectively fusing heterogeneous modalities remains challenging for learning robust representations when multimodal content is noisy and redundant. Conventional fusion methods, such as concatenation and element-wise addition, perform invasive feature mixing that may distort modality-specific characteristics and amplify cross-modal noise. Although cross-modal attention enables non-invasive interaction, it often introduces substantial computational overhead. To address these issues, we propose MiFuSR, a Mutual Information-driven Fusion framework for Multimodal Sequential Recommendation. MiFuSR couples an item-transition graph convolution backbone with information-theoretic regularization to achieve lightweight fusion. Specifically, MiFuSR maximizes cross-modal mutual information in a layer-wise manner along graph propagation, enabling complementary cues to be integrated from shallow to deep representations while preserving modality uniqueness. Meanwhile, MiFuSR minimizes intra-modal mutual information between raw features and graph-refined representations, suppressing redundancy and modality-specific noise. This dual mutual-information optimization instantiates an information bottleneck-style principle for recommendation and achieves non-invasive fusion without complex cross-modal attention layers. Extensive experiments on four real-world datasets demonstrate that MiFuSR consistently outperforms state-of-the-art multimodal sequential recommendation methods.}
}
@article{YAN2026115822,
title = {Semantic anchor enhanced prototype learning for few-shot hyperspectral image classification},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115822},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115822},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005484},
author = {Huan Yan and Jinrong He and Xiangqing Zhang and Zhaokui Li},
keywords = {Hyperspectral image classification, Few-shot learning, Prototype learning, Semantic anchor},
abstract = {Addressing the critical challenge of sample scarcity in hyperspectral image classification, this paper presents a semantic-anchor-enhanced prototype learning (SAEPL) framework that is specifically tailored for few-shot, cross-domain expert systems. Unlike conventional prototype methods that rely solely on the mean of a handful of support samples, SAEPL introduces trainable, orthogonally-initialized semantic anchors to explicitly capture inter-class relationships and guide prototype generation. These anchors are jointly optimized with a lightweight contrastive-learning objective that aligns class prototypes across source and target domains, thereby dramatically improving generalization under heterogeneous distributions. In addition, a Dynamic Adaptive Spatial Occlusion data-augmentation module is embedded to simulate real-world spatial degradations, further boosting robustness without extra annotation cost. Extensive experiments on four public hyperspectral datasets (Chikusei → Indian Pines, Houston, Salinas) demonstrate that SAEPL attains overall accuracies of 80.49%, 81.35%, and 93.22%, outperforming eight state-of-the-art algorithms by significant margins while reducing parameter count by up to 90%. Ablation studies and t-SNE visualizations confirm that both semantic anchors and Dynamic Adaptive Spatial Occlusion are indispensable for achieving compact, discriminative feature clusters. The source code is available at: https://github.com/AIYAU/SAEPL.}
}
@article{LI2026115790,
title = {Two-Stage feature selection for early warning of default risk},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115790},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115790},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005162},
author = {Zhe Li and Lina He and Mohammad Zoynul Abedin and Petr Hajek and Brian Lucey},
keywords = {Default prediction, Feature selection, Improved backward selection algorithm, Generalized -Score},
abstract = {Feature selection enhances credit risk models’ predictive accuracy and stability by eliminating redundant and noisy features while retaining critical predictive features. Employing different feature combinations to construct models leads to varying prediction accuracies. However, existing research on feature selection often focuses on the discriminatory power of individual features, neglecting the joint effects among variables on default prediction. To address these limitations, this study proposes a novel, two-stage feature selection framework integrating the Maximum Information Coefficient (MIC) and Modified Sequential Backward Selection (MSBS) algorithms. The MIC acts as an initial, broad-spectrum filter, detecting and removing redundant features while preserving complex, nonlinear associations with default risk. The MSBS algorithm subsequently refines the feature set through a dynamic backward elimination process, guided by predictive accuracy metrics and enhanced by feature substitution and feature swap strategies. The empirical results from six time windows, each containing 3425 Chinese listed firms, demonstrate that our method outperforms common feature selection techniques, such as sequential backward selection, genetic algorithm and XGBoost with recursive feature elimination. Non-financial features are the most influential in default risk prediction, followed by financial features, and finally by macroeconomic features. Experiments on multiple UCI public datasets demonstrate that the MSBS method achieves superior default discrimination power and exhibits strong robustness.}
}
@article{HUA2026115782,
title = {TimeRouter: A unified dynamic routing framework for handling missing data in time series forecasting},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115782},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115782},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005083},
author = {Qiang Hua and Yongxin Chen and Chunru Dong and Yong Zhang and Lei Xu},
keywords = {Multivariate, Time series forecast, Router, Dynamic fusion structure, Data missing},
abstract = {Time series forecasting is critical in various domains, such as finance, healthcare, and climate science. Recent studies have improved prediction accuracy by incorporating exogenous variables to model real-world relationships; these static fusion methods typically assume that variables are fully available. However, in the real world, data is frequently missing due to issues like sensor failures or communication errors. Static fusion methods, relying on fixed fusion structure between endogenous and exogenous variables, exhibit poor adaptability to dynamic changes, limiting their performance in complex data missing scenarios. To address these challenges, we propose TimeRouter, a unified dynamic routing fusion framework for handling missing data in multivariate time series forecasting. TimeRouter dynamically adjusts the fusion structure to adapt to varying patterns of missing data, thereby mitigating performance degradation. Specifically, we introduce Hierarchical Dynamic Fusion Space (HDFS), a novel architecture for multi-expert modules. By embedding routing mechanisms within each expert, HDFS autonomously explores optimal fusion structures. Evaluation on a range of benchmark datasets for short-term and long-term multivariate forecasting shows that TimeRouter achieves significantly superior prediction accuracy compared to all existing methods by a substantial margin. Its effectiveness is further highlighted under challenging conditions with high missing rates (up to 50%), where it sustains accuracy with limited performance impact. Our code is available at https://github.com/chen-yongxin-ship-it/TimeRouter.}
}
@article{MA2026115845,
title = {SPIRNet: Polarized image reconstruction with adaptive sparse attention and intelligent scaling},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115845},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115845},
url = {https://www.sciencedirect.com/science/article/pii/S095070512600571X},
author = {Ruilong Ma and Youlin Gu and Fanhao Meng and Wenhao Wu and Zhen Yi and Han Zheng and Xi Zhang and Yihua Hu},
keywords = {Polarization imaging, Image demosaicing, Super-resolution, Sparse attention mechanism, Multi-scale feature fusion, Color polarization filter array},
abstract = {Polarization imaging captures critical physical parameters such as degree of polarization (DoP) and angle of polarization (AoP), demonstrating significant potential in biomedical imaging and three-dimensional object recognition. However, color polarization filter array (CPFA) sensors have lower spatial resolution and image fidelity, while traditional sequential processing strategies cause cascading error accumulation, which reduces polarization measurement accuracy. To address these issues, the sparse polarization image reconstruction network (SPIRNet) is proposed, which optimizes both polarization image demosaicing and super-resolution reconstruction. SPIRNet introduces a polarization-aware sparse residual attention (PSRA) mechanism with adaptive top-k selection to suppress demosaicing artifacts and noise interference, as well as a cross-scale polarization fusion network (CPFN) module with multi-scale convolutions to extract hierarchical polarization features. Experimental results demonstrate that SPIRNet performs well with a PSNR of 41.13 dB, an SSIM of 0.979, and an MAE of 10.71∘, making it an effective solution for high-quality polarization image reconstruction.}
}
@article{ZHANG2026115774,
title = {ACT: Anomaly-aware causal transformer with mixture-of-experts for time-series forecasting},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115774},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115774},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005009},
author = {Han Zhang and Yufeng Chen and Xinyi Niu},
keywords = {Time-series forecasting, Transformer, Causality, Mixture-of-experts, Anomaly detection},
abstract = {Time-series forecasting is a critical task across numerous domains, with several Transformer-based models demonstrating state-of-the-art performance. Nevertheless, these models are associated with spurious correlations and the limitations of uniform parameter sharing when handling heterogeneous, non-stationary data. We introduce the anomaly-aware causal Transformer (ACT) model, which incorporates a diverse suite of anomaly-detection experts to generate dynamic anomaly scores subsequently aggregated by a learned gating network. These scores are transformed into a data-driven causal matrix that biases causal attention while a sparse mixture-of-experts expert directs computation to specialised sub-modules for adaptive modelling. Extensive experiments on multiple real-world benchmarks demonstrate that ACT delivers state-of-the-art results on a challenging benchmark and strong, consistent performance across others. A detailed case study on a representative dataset elucidates interpretable causal relationships and expert utilisation patterns. Computational analysis shows ACT effectively converts parameter capacity into forecasting gains. It uses roughly 5.2M parameters and has training times comparable with those of other large configurations, Hence, the extra computational cost is reasonable when forecast accuracy and interpretability are priorities.}
}
@article{GUO2026115826,
title = {Open-set unknown class incremental detection of gearboxes under trustworthy feature conditions based on low-rank fine-tuning mechanism},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115826},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115826},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005526},
author = {Zhen Guo and Chuan Li and Diego Cabrera},
keywords = {Open-set unknown class incremental detection, Rotating machinery gearboxes, Convolutional autoencoder, Low-rank adaptation mechanism, Isolation forest},
abstract = {As a core transmission component of rotating machinery, the gearbox is of vital importance to the reliable and safe operation of equipment. The current fault diagnosis methods rely on known data classes and are unable to address the open-set unknown class incremental detection task (OUCIDT), making it difficult to ensure the diagnostic reliability under constant working conditions. To this end, this paper proposes a model (LRACAEF) that combines a convolutional autoencoder with an isolation forest (IF) based on a low-rank adaptation mechanism. Firstly, a convolutional autoencoder with a low-rank adaptation mechanism is designed to extract features from streaming data. Secondly, a hybrid network is employed to identify unknown classes appearing in the data stream. Finally, the IF is utilized to obtain incremental detection results at each stage. Experimental verification on private datasets and the public dataset of Case Western Reserve University has shown that the proposed LRACAEF model can effectively handle the OUCIDT, highlighting its reliability in the health monitoring of rotating machinery.}
}
@article{ZHU2026115756,
title = {Multi-semantic depth collaborative multi-modality image fusion network},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115756},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115756},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126004879},
author = {Huayi Zhu and Xuyang Li and Rui Chen and Qiao Liu and Xiaojun Chang and Di Yuan},
keywords = {Multi-modality image fusion, Semantic consistency, Dual-task parallel structure, Multi-semantic deep synergistic module},
abstract = {Multi-modality image fusion aims to integrate complementary data from diverse sensors to achieve a more comprehensive representation of the imaging scene. Existing methods primarily focus on surface-level interactions between pixel-level features and visual or textual semantics, and do not fully integrate the global consistency between text modalities, image fusion, and downstream tasks. The lack of this deep collaboration between multiple semantics cannot effectively capture multi-modal information and the fine-grained association between fusion and downstream tasks. Therefore, we propose a Multi-Semantic depth collaborative Image Fusion (MSIF) network. Firstly, different from the traditional cascaded network structure, MSIF adopts a dual-task parallel structure that efficiently establishes deep correlations between the fusion and segmentation tasks. Second, MSIF enhances the semantic consistency between fusion and downstream tasks by leveraging deeper and detailed semantic information in text modalities to guide image fusion and segmentation. Additionally, MSIF uses the designed Multi-Semantic Deep Synergistic Module (MSDSM) to deeply integrate text features, pixel-level features and segmentation semantic features, so as to realize the effective fusion of multi-modal information and meet the semantic requirements of downstream tasks. Finally, the combined semantic features are fed into a fusion decoder to yield the final fusion result. Extensive quantitative and qualitative experiments demonstrate that our approach achieves state-of-the-art (SOTA) performance on multimodal datasets.}
}
@article{YANG2026115707,
title = {Dynamic bidirectional federated transfer learning with multi-source data fusion in unsupervised privacy-preserving prediction},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115707},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115707},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126004478},
author = {Dan Yang and Xin Peng and Linlin Li and Xiaolong Wu and Chaoyang Chen and Weimin Zhong},
keywords = {Transfer learning, Federated learning, Cross-domain prediction, Auto-encoder, Wastewater treatment processes},
abstract = {Transfer learning has proved effective in cross-domain prediction of the wastewater treatment process (WWTP) by leveraging labeled data from related source domains and unlabeled target data. However, access to original data is not always feasible in practical scenarios due to the demand for data privacy and security, which can make transfer learning methods that aligning distributions utilizes data ineffective. Federated learning is an emerging technology for data privacy and security but requires labeled target data, which is time-consuming. To address these challenges, in this paper, we propose Dynamic Bidirectional Federated Transfer Learning (DBFTL) by combining transfer learning and federated learning, which is the first multi-source domains unsupervised transfer learning framework for privacy-preserving prediction. DBFTL transfers source knowledge to the target domain by fusing source models as the target model with a dynamic weight calculated through the reconstruction error of target data on source models, which is regarded as a similarity of the source domain and target domain. Simultaneously, DBFTL transfers target knowledge to source domains by integrating the target encoder into source models as a regularization term to reduce the domain discrepancy, which is calculated by the distance between the representation features of source data obtained in the source encoder and those in the target encoder. Therefore, iterative bidirectional knowledge transfer achieves the prediction target model learning without compromising privacy security. To validate the effectiveness of DBFTL, we conduct prediction experiments on four WWTPs.}
}
@article{DELOSSANTOSHERNANDEZ2026115773,
title = {CausalMorph: Preconditioning data for linear non-Gaussian acyclic models},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115773},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115773},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126004995},
author = {Mario {De Los Santos-Hernández} and Samuel Montero-Hernández and Felipe Orihuela-Espina and L. Enrique Sucar},
keywords = {Causal discovery, LiNGAM, Data preconditioning, Assumption violation, CausalMorph, Causal inference},
abstract = {Moving from associative learning to inferring cause–effect relationships remains a central challenge for intelligent systems. The Linear Non-Gaussian Acyclic Model (LiNGAM) family identifies a single, fully directed causal graph from observational data rather than an equivalence class. However, deviations from its assumptions of linearity and non-Gaussian noise limit its applicability. To address this, this paper introduces CausalMorph, a data preconditioning algorithm that projects observational data toward a regime compatible with LiNGAM. The projection employs a three-stage sequence: local linearization of causal mechanisms, synthesis of non-Gaussian residuals, and orthogonalization of parent-residual dependencies. Across an evaluation of 34,560 synthetic paired experiments, CausalMorph yielded significant reductions in Structural Hamming Distance (SHD) of 37.7%  ±  10.8% for DirectLiNGAM and 16.4%  ±  13.8% for ICA-LiNGAM (p < .001). Additionally, the CausalMorph + DirectLiNGAM pipeline achieved a lower mean SHD than the differentiable non-linear baseline algorithm in both linear and non-linear regimes. By operating as a non-iterative, single-pass projection, the method avoids the kiter optimization loops required by continuous frameworks, offering a highly efficient path to structural recovery. The algorithm also systematically rescues baseline solvers from catastrophic large-sample traps under fully Gaussian noise, and maintains an 85.8% win rate over the baseline when utilizing an autonomous data-driven initialization for the prior causal order. These findings suggest statistical projection as a viable and structurally conservative strategy for applying LiNGAM-based causal discovery to data environments that violate its base assumptions.}
}
@article{WANG2026115870,
title = {A niching archive-assisted evolutionary algorithm for multimodal feature selection in high-dimensional data classification},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115870},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115870},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005964},
author = {Yunhe Wang and Zhengyu Du and Zeming Zhou and Xubin Wang and Shengxiang Yang},
keywords = {Feature selection, High-dimensional data, Particle swarm optimization, Multimodal optimization, Niching strategies},
abstract = {The rapid advancement of data collection technologies has resulted in high-dimensional datasets, which pose significant challenges for machine learning classification tasks. These datasets often include redundant, irrelevant, or noisy features that degrade classification accuracy and increase computational costs. In this context, multimodal feature selection becomes crucial, as it enables the identification and extraction of the most relevant features from the high-dimensional data, thereby enhancing the performance of machine learning models. To tackle this problem, we introduce a Niching Archive-Assisted Particle Swarm Optimization (NAPSO) algorithm designed to address multimodal feature selection. Specifically, NAPSO first introduces a unique K-means-based niche-partitioning method that leverages both feature weights and subset sizes for enhanced diversity preservation and global exploration. It then applies a niche-aware dynamic particle-update rule that adaptively adjusts particles according to fitness, fully exploiting high-quality solutions within each niche. Crucially, a novel probability-guided external elite archive continually retains superior feature subsets and dynamically guides the reinitialization of particles, significantly cutting feature redundancy, boosting classification accuracy, and averting premature convergence. This probabilistic guidance mechanism is a key distinction from existing archive-guided methods. Extensive experiments on diverse high-dimensional datasets reveal that NAPSO demonstrates highly competitive performance, often achieving higher classification accuracy with smaller feature sets on a wide range of datasets, particularly for binary classification problems. Moreover, it discovers several equivalently predictive feature subsets, granting practitioners valuable flexibility for real-world knowledge discovery and data-driven decision-making.}
}
@article{LONG2026115810,
title = {Beyond single-source adversaries: Diversity-driven ensemble adversarial training for object detectors},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115810},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115810},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005368},
author = {Sheng Long and Yibin Dong and Shuohao Li and Jun Lei and Roel Leus and Jun Zhang},
keywords = {Object detection, Adversarial robustness, Ensemble adversarial training, Progressive learning, Black-box defense},
abstract = {Object detection, a fundamental computer vision task with broad real-world applications, exhibits vulnerability to adversarial examples comparable to that of classification tasks. The revealed vulnerabilities have become a major bottleneck for its practical deployment. Adversarial Training (AT) is the most effective defense mechanism against such threats. However, existing AT methods for object detection rely on single-source adversarial examples generated from a white-box model, resulting in detectors that remain susceptible to cross-model transferable adversarial perturbations. To address this issue, this study proposed an ensemble adversarial training framework for object detection that leverages multiple models to generate adversarial examples to enrich the training data, coupled with a carefully designed learning strategy. Specifically, we constructed a diverse pool of auxiliary models using publicly available adversarially pretrained backbones, which generate adversarial examples in a round-robin fashion. This operation of enriching adversarial sources helps mitigate architecture-specific overfitting and enhances the black-box defense capability of the detector. In addition, it bypasses the adversarial pretraining step for auxiliary models required in traditional methods, effectively reducing the deployment cost for this computationally intensive task. Furthermore, we introduced a progressive learning strategy to alleviate the white-box performance degradation often associated with ensemble methods. Extensive experiments on the PASCAL VOC and MS-COCO datasets demonstrate that our method is significantly more robust to black-box attacks than single-source AT baselines, achieving performance gains of up to 7%. This work provides valuable insights into promoting the resilience of object detection models against potential real-world attacks. Code and trained checkpoints are available at https://github.com/MonoDone/ODEAT.}
}
@article{LI2026115751,
title = {DC-DPSGD: Double clipping differentially private stochastic gradient descent},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115751},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115751},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126004831},
author = {Pengfei Li and Jinguo Li and Mengcheng Liu and Baoxin Xu},
keywords = {Differential privacy, Gradient sparsification, Deep learning, Privacy-preserving},
abstract = {Safeguarding sensitive information in machine learning processes has become a central issue, as models are increasingly trained on personal or confidential data. Differentially Private Stochastic Gradient Descent (DPSGD) provides strong privacy guarantees but often leads to significant performance degradation, especially for large models and high noise levels. Although model pruning techniques can help mitigate the effects of noise and reduce computational overhead, traditional methods struggle to balance model generalization with privacy preservation. To overcome these challenges, we propose Double-Clipping DPSGD (DC-DPSGD), a novel differential privacy training framework. DC-DPSGD operates in two stages. First, during a lightweight pretraining phase, we introduce a Fisher information-based privacy-preserving approach to accurately estimate the importance of each parameter using a small subset of data and training steps. This process yields an importance matrix while adhering to differential privacy constraints. Second, during the formal training phase, we apply a two-stage clipping strategy: sparsifying the model based on parameter importance, followed by gradient clipping to satisfy sensitivity bounds. By dynamically identifying and preserving critical parameters throughout training, DC-DPSGD effectively reduces noise-induced degradation and enhances model utility. Extensive experiments on the MNIST, FMNIST, and CIFAR-10 datasets show that DC-DPSGD consistently outperforms existing approaches across various pruning rates and privacy budgets. These results demonstrate that DC-DPSGD achieves a superior privacy-utility trade-off while maintaining strong generalization, all with minimal pretraining cost.}
}
@article{YANG2026115831,
title = {Tensor singular value-preserving norm for robust visual data recovery},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115831},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115831},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005575},
author = {Lina Yang and Haoyan Yang and Thomas Xinzhang Wu and Yulong Wang and Tianchuan Yang and Yuan Yan Tang},
keywords = {Tensor recovery, Robust principal component analysis, Tensor singular value-preserving norm, Robust visual data recovery},
abstract = {Tensor robust principal component analysis (TRPCA) has shown significant promise in recovering visual tensor data by separating low-rank components from sparse noise. However, traditional Tensor Nuclear Norm (TNN)-based methods apply uniform linear shrinkage to all singular values, which often introduces structural bias in the recovered tensor. The singular values of visual tensor data typically exhibit a heavy-tailed distribution, where dominant components represent primary structures while smaller ones are often associated with noise. Uniform shrinkage therefore fails to differentiate between these components. To address this limitation, we propose a Tensor Singular Value-Preserving Norm (TSVPN) that adopts a concave penalization on singular values. By imposing less shrinkage on dominant components, TSVPN alleviates structural bias and preserves essential structural information. Based on TSVPN, we develop a TRPCA model for robust visual tensor recovery. Furthermore, real-world visual tensors often exhibit coupled low-rank and smooth characteristics that are challenging to balance. To further improve recovery performance, we fuse TSVPN with gradient tensors to propose a Smoothness TSVPN model (STSVPN). This model balances global low-rankness and local smoothness, preserving structural information while suppressing sparse noise. An efficient Alternating Direction Method of Multipliers (ADMM)-based algorithm with provable convergence is developed to solve the proposed models. Extensive experiments on color images, hyperspectral images, multispectral images, and videos demonstrate improved recovery accuracy and robustness compared with existing methods. The source codes of the proposed methods are available at https://github.com/ytccyw/STSVPN.}
}
@article{NIU2026115757,
title = {Reductions of three-way concept lattices and three-way rules extraction based on Boolean formal contexts},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115757},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115757},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126004880},
author = {Dong-Yun Niu and Ju-Sheng Mi},
keywords = {Boolean formal contexts, Three-way concept lattices, Reductions, Deduction rules, Three-way rules},
abstract = {Concept lattice reductions and rule extraction are two major research areas in formal concept analysis (FCA). The Boolean formal context is an extension of FCA. This study investigates reductions of three-way concept lattices and three-way rule extraction in Boolean formal contexts. In terms of reduction, this study proposes several types of reductions, investigates their relationships, and describes a method for obtaining a reduction that preserves the three-way concept lattices structure. In terms of three-way rule extraction, definitions of three-way rules are introduced, as well as numerous deduction rule.}
}
@article{XIANG2026115823,
title = {Cross-domain fault diagnosis of rotating machinery based on class-imbalanced joint domain adaptation network},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115823},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115823},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005496},
author = {Wei Xiang and Shujie Liu and Hongkun Li and Xiaoyu Cao and Bo Han},
keywords = {Rotating machinery, Fault diagnosis, Class imbalance, Domain adaptation, Subdomain distribution alignment},
abstract = {The widespread prevalence of data distribution differences between different operating conditions of rotating machinery seriously affects the performance of fault diagnosis methods. Domain adaptation technology can improve the generalization performance of models by aligning different distributions in the latent space. However, when there is class imbalance in the target domain, it will cause serious interference to the domain adaptation effect. To solve this issue, a class-imbalanced joint domain adaptation network (CIJDAN) is proposed to tackle the cross-domain diagnosis challenge under class imbalance conditions. First, the predictive information is fully leveraged to extract more discriminative features during domain adversarial training, while an augmented balancing strategy is adopted to alleviate the negative effects caused by the class imbalance. Additionally, by combining the prior knowledge of the source domain label and the distribution estimation and confidence measure of the target domain prediction, a boundary amplifier based on dual-weight subdomain distribution alignment is designed to help the classifier establish clearer and more reliable decision boundaries. As a result, the CIJDAN method combines domain adversarial training and discrepancy measurement to eliminate domain bias and extract reliable and robust domain-invariant features. The CIJDAN method is validated in two cases, demonstrating its feasibility and reliability. Experimental results indicate that CIJDAN achieves high precision and robust diagnostic performance in various class-imbalanced cross-domain scenarios, highlighting its potential for practical engineering applications.}
}
@article{BODAGHI2026115704,
title = {PPO-CIS : A deep reinforcement learning framework for real-time toxicity detection in social media},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115704},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115704},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126004442},
author = {Arezo Bodaghi and Benjamin C.M. Fung and Ketra A. Schmitt},
keywords = {Toxic language detection, Cascaded classifiers, Dynamic inference system, Real-time content moderation},
abstract = {Online platforms face growing challenges in moderating harmful user-generated content due to the large volume and rapid pace of interactions. In existing moderation systems, automated tools assist human moderators, yet they often struggle to balance processing efficiency and reliable classification. When moderation fails to detect harmful content quickly and accurately, platforms risk user harm and noncompliance with content safety regulations. This paper proposes an adaptive moderation method named the Proximal Policy Optimization-based Cascaded Inference System (PPO-CIS). The method integrates multiple toxicity classifiers into a cascaded decision architecture guided by deep reinforcement learning. At each step, PPO-CIS selects the next classifier according to the content difficulty and the expected gain in accuracy relative to computational cost. The system enables rapid filtering of benign content and only activates high-capacity models for uncertain cases. PPO-CIS is the first toxicity detection framework to employ Proximal Policy Optimization for real-time optimization of classifier cascades. Experiments on the AugmenToxic and ToxiGen datasets show that PPO-CIS improves detection accuracy by 2.10 percent while increasing processing speed from 42.74 to 384 samples per second compared with static cascade designs. The findings show that adaptive model selection can better shield users from exposure to harmful content while lowering moderation costs. PPO-CIS provides a practical solution for deploying scalable and timely content moderation in fast-moving online environments.}
}
@article{SINGH2026115775,
title = {FedHC: Enhanced federated learning with Hessian and cosine correlation for proximal correlation},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115775},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115775},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005010},
author = {Kushall Pal Singh and Monu Verma and Dinesh Kumar Tyagi and Santosh Kumar Vipparthi and G. Shankara {Raju Kosuru} and Subrahmanyam Murala and Mohamed Abdel-Mottaleb},
keywords = {Federated learning, Hessian approximation, Cosine similarity, Proximal correction},
abstract = {Federated Learning (FL), a prominent distributed learning approach, involves both collaborative and individual data updates from participants. FL faces a key challenge with heterogeneous data causing local drift. Conventional methods like FedDC, relying on first-order optimization techniques such as Stochastic Gradient Descent (SGD), struggle to address this effectively. These techniques are not fully effective in mitigating local drift or ensuring optimal convergence. There is a growing interest in second-order optimization methods for better convergence. Yet, these advanced methods introduce distinct convergence challenges within the FL framework. To address these challenges, we propose a novel FL method called FedHC. The proposed FedHC integrates proximal correction within the objective function and employs an approximated Hessian optimizer for updating local model parameters. Experimental results, conducted on diverse image classification and synthetic datasets, show that FedHC significantly improves convergence speed and outperforms existing methods, demonstrating robustness across different client settings.}
}
@article{HUANG2026115791,
title = {MasterKey: A multi-target backdoor attack in federated learning},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115791},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115791},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005174},
author = {Yi Huang and Haohe Jia and Hongbin Zhu and Guangnan Ye and Hongfeng Chai},
keywords = {Machine learning security, Federated learning, Backdoor attack, Multi-target attack},
abstract = {Existing research in Federated Learning (FL) primarily focuses on single-target backdoor attacks (SBAs), where the output of a given sample is manipulated to a single fixed target class. However, SBAs have limited scope, as real-world scenarios may involve multi-target backdoor attacks where samples are redirected to different target classes. Therefore, this paper explores multi-target backdoor attacks in FL, enabling the attacker to flexibly select target classes. We propose two types of backdoor attacks, denoted as NaiveAttack and MasterKey. NaiveAttack easily extends SBAs by embedding triggers corresponding to all target classes into the local dataset, while MasterKey trains a target-based attack model locally to generate sample-specific triggers aligned with the attacker’s chosen targets. Extensive experiments demonstrate that MasterKey achieves a high attack success rate (approaching 100% in complex settings) while maintaining benign task performance. More critically, the proposed attack successfully evades five mainstream defenses originally designed for single-target backdoors. Our work highlights the escalating threat posed by multi-target backdoor attacks in federated learning and underscores the pressing need for new defensive paradigms.}
}
@article{SONG2026115783,
title = {HAHGL-CDR: Heterogeneous adaptive hypergraph learning for cancer drug response prediction},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115783},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115783},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005095},
author = {Bangrui Song and Haifan Meng and Wen Zhang and Hang Qiu},
keywords = {Cancer drug response prediction, Adaptive hypergraph, Multi-omics fusion, Hypergraph learning},
abstract = {Accurate prediction of the cancer drug response (CDR) is crucial for advancing personalised medicine. Although recent graph-based methods for predicting the CDR are promising, they suffer from three major limitations: (1) insufficient capture of high-order biological-entity interactions, (2) limited utilisation of response-relevant structural priors, and (3) inadequate fusion of complementary cross-omics information. To address these challenges, we propose a Heterogeneous Adaptive HyperGraph Learning framework for CDR prediction (HAHGL-CDR). Specifically, we first construct omics-specific hypergraphs to capture intra-omics relationships among cell lines. To fully exploit multi-omics complementarity, we present a novel adaptive hypergraph construction and learning strategy that enables cell lines to flexibly engage in cross-omics interactions and comprehensively fuse inter-omics interrelations through adaptive hypergraph convolution. Subsequently, a heterogeneous adaptive hypergraph is constructed to model sensitivity-aware cell line-drug associations. To effectively capture the correlated response patterns, we introduce a noise filter that suppresses misleading connections from structurally similar biological entities with opposing responses, and reinforces response-consistent associations to enhance the semantic coherence within each hyperedge, ultimately improving the overall predictive performance. Comprehensive experiments on two public datasets demonstrate that HAHGL-CDR significantly outperforms state-of-the-art baselines across all evaluation metrics. Notably, on the Genomics of Drug Sensitivity in Cancer dataset, it surpasses the strongest competitor with gains of 1.52 %, 5.68 %, and 4.41 % in Area Under the Curve, Area Under the Precision-Recall Curve and F1 score, respectively. External validation on a clinical dataset, along with a case study, further confirms its practical generalisability. Our codes and datasets are available at https://github.com/Kivenu/HAHGL-CDR.}
}
@article{PHAM2026115803,
title = {Causal reasoning over ontology-enriched graphs for interpretable medical AI},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115803},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115803},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005290},
author = {Thuy T.T. Pham and Trang T.D. Nguyen},
keywords = {Causal inference, Ontology-enriched knowledge graphs, Knowledge graphs, Biomedical reasoning, Causal link prediction},
abstract = {Causal inference is a cornerstone of biomedical reasoning, yet current methods often struggle to integrate domain knowledge, handle uncertainty, and provide interpretable results. In this paper, we propose a novel framework - Causal Reasoning over Ontology-Enriched Graphs (CREOG) - that combines biomedical ontologies with causal discovery and knowledge graph embeddings to facilitate explainable causal analysis. we construct a diabetes ontology and derive a small causal knowledge graph (CKG) and an enlarged SNOMED-anchored diabetes CKG with 21,542 entities and 107,710 causal or associative edges. We additionally validate on a breast cancer ontology (BreastCancer.owl) to assess cross-domain generalizability. CREOG combines association rule mining (Apriori) with multiple causal discovery algorithms (PC, NOTEARS, FCI, GES/GIES) to generate weighted causal triples with textual provenance. To enable robust causal link prediction, we introduce CausE-S, a causal embedding model that leverages edge weighting and structural similarity to prioritize high-confidence relations. Experimental results show that CausE-S significantly outperforms traditional embedding baselines such as TransE, ComplEx, GraIL, and R-GCN on both KGs across multiple evaluation metrics, including MRR, Hits@K, Precision, Recall, and F1-score. Additional comparisons to FCI and GES/GIES confirm that CREOG recovers a large fraction of baseline causal edges while proposing clinically plausible new relations. The proposed framework also supports explainable reasoning through annotated causal links and confidence-aware inference. Our work demonstrates the effectiveness of combining ontological semantics with causal embeddings for interpretable biomedical knowledge discovery.}
}
@article{MALLESH2026115748,
title = {Classification of privacy preserved medical data in cloud based on deep learning with lotus effect honey badger optimization},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115748},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115748},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126004806},
author = {A. Satya Mallesh and Poppoppula T Satyanarayana Murty and Nagaraju Pamarthi and P Raju and Raja Rao PBV},
keywords = {Cloud computing, Data security, Privacy preservation, Data classification, Deep learning},
abstract = {The growing amount of medical data in the healthcare industry brings with it both opportunities and challenges, especially with regard to patient privacy. Traditional data classification techniques generally compromise patient confidentiality due to the sensitive nature of healthcare data. Hence, this research aims to design and develop an effective strategy called Lotus Effect Honey Badger Optimization_Deep Kronecker Network (LEHBO_DKN) for classifying privacy-preserved medical data in the cloud. The cloud is first simulated, and next, the input medical data is converted into arbitrary elliptical polarized data using the proposed LEHBO. The proposed LEHBO is developed by the amalgamation of the Lotus Effect optimization Algorithm (LEA) and the Honey Badger Algorithm (HBA). Thereafter, the Cumulative Arbitrary Elliptical Polarized Data (CAEPD) is produced, and then, the key matrix is constructed. Lastly, privacy-preserved medical data classification is carried out by employing the DKN, which is trained by LEHBO, which combines LEA and HBA. Additionally, the proposed LEHBO_DKN is examined in view of several measures, such as accuracy, True Positive Rate (TPR), and True Negative Rate (TNR) and the outcomes obtained are 93.988 %, 95.655 %, and 90.877 %, respectively.}
}
@article{CHANG2026115765,
title = {EN-thinking: Enhancing entity-level reasoning in large language models for knowledge graph completion},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115765},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115765},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126004922},
author = {Yaoyu Chang and Tao Gao and Ziqi Li},
keywords = {Knowledge graph completion, Entity-level understanding and reasoning, Chain-of-thought, Hybrid entity description consistency loss},
abstract = {Recent advances in large language models (LLMs) show promise for knowledge graph completion (KGC), yet they face two critical, entity-level challenges stemming from their token-by-token nature. First, they struggle with entity conceptualization, failing to recognize multi-token named entities as holistic concepts with specific attributes and structural roles within the KG. Second, their internal reasoning pathways are often unaligned with KG facts, relying on textual co-occurrence rather than verifiable graph-based logic. To address these deficiencies, we propose EN-Thinking, a framework that introduces two core mechanisms to enhance entity-level reasoning in LLMs. To tackle the conceptualization challenge, it enriches the input with a synergistic blend of multifaceted KG context: semantically retrieved descriptions, GNN-derived subgraph features, and explicit entity identifiers, fostering a deep, entity-centric understanding. To align the reasoning process, it employs a guided chain-of-thought (CoT) module that directs the LLM to first generate a descriptive statement about the target entity. Crucially, we introduce a novel Hybrid Entity Description Consistency Loss to ensure the fidelity of this process by optimizing the alignment between the LLM-generated description and the ground-truth entity’s canonical description. This loss effectively steers the LLM’s reasoning to be consistent with factual knowledge. Extensive experiments on diverse benchmarks show that EN-Thinking establishes a new state-of-the-art. It achieves remarkable MRR scores of 47.54 on DB15K and 44.60 on MKG-W, demonstrating its dominance on description-rich datasets. Its superiority is further cemented by a commanding 42.35 MRR on the structurally challenging FB15k-237 benchmark, a result that underscores the robustness and generalizability of our entity-centric design. These findings significantly surpass prior methods and validate the effectiveness of our approach.}
}
@article{NASIF2026115814,
title = {Reinforcement-guided hyper-heuristic hyperparameter optimization for fair and explainable spiking neural network-based financial fraud detection},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115814},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115814},
url = {https://www.sciencedirect.com/science/article/pii/S095070512600540X},
author = {Sadman Mohammad Nasif and Md Abrar Jahin and M.F. Mridha},
keywords = {Spiking neural networks, Hyper-heuristic optimization, Reinforcement learning, Financial fraud detection, Explainable AI, Fairness-aware machine learning},
abstract = {The growing adoption of home banking systems has heightened the risk of cyberfraud, necessitating fraud detection mechanisms that are not only accurate but also fair and explainable. While AI models have shown promise in this domain, they face key limitations, including computational inefficiency, the interpretability challenges of spiking neural networks (SNNs), and the complexity and convergence instability of hyper-heuristic reinforcement learning (RL)-based hyperparameter optimization. To address these issues, we propose a novel framework that integrates a Cortical Spiking Network with Population Coding (CSNPC) and a Reinforcement-Guided Hyper-Heuristic Optimizer for Spiking Systems (RHOSS). The CSNPC, a biologically inspired SNN, employs population coding for robust classification, while RHOSS uses Q-learning to dynamically select low-level heuristics for hyperparameter optimization under fairness and recall constraints. Embedded within the Modular Supervisory Framework for Spiking Network Training and Interpretation (MoSSTI), the system incorporates explainable AI (XAI) techniques, specifically, saliency-based attribution and spike activity profiling, to increase transparency. Evaluated on the Bank Account Fraud (BAF) dataset suite, our model achieves a 90.8% recall at a strict 5% false positive rate (FPR), outperforming state-of-the-art spiking and non-spiking models while maintaining over 98% predictive equality across key demographic attributes. Although RHOSS introduces an offline search cost, this is amortized over deployment, where inference dominates. The architectural sparsity of CSNPC ensures lower energy per transaction compared to dense ANNs, as supported by neuromorphic benchmarks. The explainability module further confirms that saliency attributions align with spiking dynamics, validating interpretability. These results demonstrate the potential of combining population-coded SNNs with reinforcement-guided hyper-heuristics for fair, transparent, and high-performance fraud detection in real-world financial applications.}
}
@article{PONS2026115835,
title = {Capturing and anticipating user intents in data analytics via knowledge graphs},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115835},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115835},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005617},
author = {Gerard Pons and Besim Bilalli and Anna Queralt},
keywords = {Intentional analytics, Knowledge graphs, Link prediction, Graph embeddings, Graph neural networks},
abstract = {In today’s data-driven world, the ability to extract meaningful information from data is becoming essential for businesses, organizations and researchers. For this purpose, a wide range of tools and systems exists addressing data-related tasks, from data integration, preprocessing and modeling, to the interpretation and evaluation of the results. As data continues to grow in volume and complexity, there is an increasing need for advanced yet user-friendly tools, such as intelligent discovery assistants (IDAs) or automated machine learning (AutoML) systems, that facilitate the user’s interaction with data. This enables non-expert users to effectively leverage powerful data analytics techniques. However, the use of these tools still requires non-trivial user input that cannot be anticipated from the analytical problem’s data alone, but must be tailored to each individual user and their specific intents. To this end, this work explores the use of Knowledge Graphs (KG) as a foundational representation for capturing complex analytics workflows, as well as information about the users, their intents and their feedback, in order to facilitate user interaction with IDAs or AutoML tools. This is achieved through established techniques from recommender systems, in particular a link prediction approach based on KG embeddings and graph neural networks. Experimental results show that the proposed method effectively captures the graph structure and produces meaningful suggestions for users. To demonstrate the feasibility of the approach, a working prototype is presented.}
}
@article{LI2026115855,
title = {RAGS: Roughness-aware gaussian splatting for reflective objects surface reconstruction},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115855},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115855},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005812},
author = {Wanjing Li and Qiannan Li and Rongchun Sun and Lei Chen},
keywords = {Gaussian splatting, Surface reconstruction, Rendering equation, BRDF},
abstract = {Reflective surfaces exhibit strong view-dependent appearance variations, which causes severe multi-view inconsistency and makes high-fidelity geometric reconstruction particularly challenging. Existing Gaussian Splatting–based methods often fail in reflective regions because standard α-blending suppresses the contribution of first-surface Gaussians, leading to concave artifacts and missing geometry. Dual-branch optimization and inverse rendering frameworks alleviate these issues but incur high computational cost and may suffer from conflicts between appearance and geometric objectives. To address this issue, we propose a roughness-aware surface reconstruction method based on physical rendering called RAGS. RAGS introduces a differentiable rendering pipeline based on the rendering equation that explicitly models view-dependent highlights and reflection using a Ward BRDF formulation and predicts per-Gaussian roughness. The estimated roughness guides a roughness-aware α-blending strategy that reweights geometric rendering according to material properties, effectively correcting opacity-induced geometric bias. Furthermore, additional geometric information stabilizes roughness estimation, while roughness-guided Gaussian densification and unsupervised reflective regularization further enhance geometric completeness. The experimental results show that RAGS achieves accurate geometric reconstruction and realistic rendering of reflective objects.}
}
@article{GUO2026115712,
title = {3D cross-modality cardiac image segmentation based on causality-driven contrastive learning},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115712},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115712},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126004521},
author = {Saidi Guo and Xiaona Yan and Ying Shen and Weixing Zhang and Guohua Zhao and Cong Yang and Qiujie Lv},
keywords = {Front-door adjustment, Contrastive learning, Cross-modality cardiac image segmentation},
abstract = {Three-dimensional (3D) cross-modality cardiac imaging has emerged as a critical tool in contemporary medical diagnostics. However, it faces the challenges of intra-modality coupling and inter-modality variance. Most existing methods rely on feature correlations across modalities, which makes them susceptible to capturing spurious associations, in turn making it difficult to solve the above challenges. In this paper, we developed a causality-driven contrastive learning (CDCL) method for 3D cross-modality cardiac image segmentation. First, CDCL introduced a causal feature extraction module that used front-door adjustment for explicitly modeling causal feature pathways. This module effectively extracted the core anatomical factor, thereby mitigating the intra-modality coupling. Second, CDCL introduced a modality contrastive learning module to enhance the similarity of the core anatomical factor across modalities and maximize the dissimilarity between the core anatomical factor and the modality-background confounder, thereby reducing the inter-modality variance. Comprehensive evaluations using 3D magnetic resonance imaging and computed tomography datasets confirmed the effectiveness of CDCL (Dice  ≥  0.935), outperforming seven advanced segmentation methods.}
}
@article{ALSULAIMANI2026115631,
title = {Fractional digital asset ownership–an intelligent fractional NFT-based approach to the reliable provenance of digital asset co-ownership},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115631},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115631},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126003710},
author = {Samar Alsulaimani and Ming Zhao and Farookh Khadeer Hussain},
keywords = {FNFTs, Co-ownership, Digital asset, Provenance, NFT, Blockchain},
abstract = {A new generation of digital assets is being managed using blockchain technology and non-fungible tokens (NFTs), which introduce novel opportunities for verifying ownership rights and establishing provenance. This paper presents an innovative framework called Fractional Digital Asset Ownership (FDAO), which aims to create NFTs for digital artifacts, such as software code, and extend their functionality through fractionalized NFTs (FNFT). Leveraging the Model-View-Controller (MVC) design pattern, FDAO enables effective co-ownership tracking across the lifecycle of digital assets, providing a structured and efficient mechanism for defining and managing co-ownership. A system prototype has been developed and tested in an integrated development environment (IDE) using decentralised applications (DApps) and smart contracts. Unlike existing NFT-based models, FDAO incorporates an intelligent, automated fractionalization and verification mechanism that combines the ERC-1155 and ERC-20 standards to enhance co-ownership management and scalability. This integration addresses the critical challenges related to transparency, security, and lifecycle management in digital asset co-ownership. The prototype, implemented using Remix and OpenZeppelin, demonstrates how FDAO enables secure, transparent, and efficient transfer and management of digital assets. By integrating FNFT functionality with smart contracts, the framework provides a robust, scalable, and intelligent method for managing digital assets. It also maintains transparency and trust throughout the asset lifecycle.}
}
@article{SONI2026115692,
title = {I-GNN: Intelligent graph neural network framework for decentralized multi-Robot navigation with dynamic goal reassignment and obstacle handling},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115692},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115692},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126004326},
author = {Ankit Soni},
keywords = {Decentralized information systems, Multi-agent decision-making, Graph neural networks, Dynamic task allocation, Adaptive path planning, Obstacle management},
abstract = {Decentralized multi-robot coordination is a knowledge-driven problem that requires scalable goal allocation, adaptive reasoning, and robustness to dynamic and uncertain environments. We propose I-GNN, a decentralized algorithmic coordination framework that integrates Graph Neural Network (GNN)-based goal assignment with D* Lite-based incremental path replanning. During training, obstacle-aware path costs computed via D* Lite-based incremental path planning are transformed into soft, cost-weighted supervisory distributions derived from Hungarian cost-optimal matching. This dual-assignment formulation enables the GNN to encode relative path feasibility rather than rely on hard optimal labels. At runtime, decentralized GNN inference performs scalable goal allocation without global synchronization or centralized optimization. To address dynamic disturbances, the framework incorporates temporal obstacle-decay modeling and event-triggered reassignment, enabling stable coordination under transient occlusions, congestion, and simulated robot failures. The proposed framework is evaluated in a hospital-inspired occupancy grid testbed under dynamic and partially observable conditions. Experimental results demonstrate high decentralized assignment accuracy (97–99%) with Hungarian-derived cost-optimal assignments under obstacle-aware path costs, low reassignment frequency, and effective collision avoidance across varying robot team sizes. Comparative analysis against centralized Hungarian assignment and hybrid RRT–DWA planning shows improved scalability and robustness within the adopted simulation protocol. These results validate I-GNN as a decentralized coordination framework that combines cost-aware optimization principles with learning-based multi-agent reasoning.}
}
@article{HAN2026115787,
title = {Hyperspectral imaging compressed sensing based on spatial-spectral deep unfolding for agricultural products},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115787},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115787},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005137},
author = {Zhenyu Han and Xuan Liu and Guanghui Yang and Meipan Wang and Jian Li and Yongli Zhang and Tailin Han},
keywords = {Agricultural products, Hyperspectral imaging, Compressed sensing, Deep learning, Deep unfolding network, Spatial-spectral dimension},
abstract = {To address the challenge of balancing compressive-reconstruction performance, reconstruction speed, and interpretability in hyperspectral imaging (HSI) compressed sensing (CS) for agricultural products, this study proposes a spatial-spectral deep unfolding-based HSI CS model (SS-DUHCS). The model leverages the spatial-spectral characteristics of agricultural product HSI by unfolding the datacube row-wise into spatial-spectral slices for block-wise compressive measurement, enhancing compressive-reconstruction performance. A gradient-based optimization strategy embeds the physical characteristics of HSI from various agricultural products into the measurement matrix, improving adaptability to different datasets. During the reconstruction stage, a deep unfolding network transforms a traditional iterative optimization process into a multi-stage, physically interpretable network. This model learns the data characteristics of agricultural product HSI, achieving fast reconstruction while maintaining interpretability. A spatial and channel feature refinement module integrates into each unfolding-stage denoiser to extract effective features and eliminate redundancies, improving reconstruction quality while keeping the model lightweight. Experiments on four public and self-constructed agricultural HSI datasets demonstrate that SS-DUHCS consistently achieves superior reconstruction quality at low sampling rates (1%, 4%, and 10%) compared to iterative and deep learning-based baselines, with minimal model complexity. For instance, on the persimmons dataset at a 1% sampling rate, SS-DUHCS achieves 39.411 dB peak signal-to-noise ratio and 0.953 structural similarity index measure with just 30.69K parameters. The proposed measurement-reconstruction design generalizes well across various agricultural HSI data and is compatible with push-broom line-scan systems, supporting efficient non-destructive quality inspection in practical agricultural scenarios.}
}
@article{RAJACHAKRAVARTHI2026115747,
title = {INCLUDE: A chain-of-thought based mixture of experts for inclusive language generation},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115747},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115747},
url = {https://www.sciencedirect.com/science/article/pii/S095070512600479X},
author = {Bharathi {Raja Chakravarthi} and Shunmuga {Priya Muthusamy Chinnan} and Prasanna {Kumar Kumaresan} and Rahul Ponnusamy},
keywords = {Inclusive language, Chain of thought, Mixture of experts, Retrieval augmented generation, Large language models},
abstract = {Developing intelligent inclusive language generation systems that promote inclusivity and mitigate harmful or exclusive terms is a key challenge in advancing Equity, Diversity and Inclusion (EDI) principles. Using inclusive language in communication helps create a respectful, bias free and mutual understanding between the peers, which is also essential for organizations to promote safe and equitable workspaces. Inclusive language involves neutrality, tone sensitivity and fairness across diverse contexts, enabling meaningful engagement without marginalization. Considering this, we propose INCLUDE, an inclusive language generator designed for promoting respectful and equitable communication in workplaces. We curated a non-inclusive vs inclusive pair dataset including real-world workplace, advertisements and HR policy discourse with annotated inclusive rewrites. The proposed framework employs three experts dedicated to inclusiveness, bias and stereotype free and contextual relevance to facilitate the learning of diverse semantics. To optimize these experts, we propose a self-calibration mechanism using meta-prompting guided by a novel multi-dimensional reward function. Extensive evaluations, including metrics LLM based assessments and human in the loop analysis shows that proposed model effectively counters non-inclusive language into contextually appropriate, inclusive and accessible responses while maintaining the original intent.}
}
@article{ZHANG2026115863,
title = {Manifold-aware triple cooperative multi-population differential evolution with reinforcement learning for irregular 3D UAV path planning},
journal = {Knowledge-Based Systems},
volume = {341},
pages = {115863},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115863},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126005897},
author = {Yunhui Zhang and Guanglong Du and Hao Tang and Ziwei Wang and Xueqian Wang and Cuifeng Du and Quanlong Guan and Xiaojian Qiu},
keywords = {UAV path planning, Differential evolution, Multi-population cooperative optimization, Manifold-aware search, Reinforcement learning, Irregular 3D environments},
abstract = {This study proposes a manifold-aware triple cooperative multi-population differential evolution algorithm with reinforcement learning (MTCMDE) for UAV path planning in irregular three-dimensional environments with obstacle constraints and wind disturbances. The method aims to enhance both global exploration and local refinement, enabling more reliable identification of feasible low-cost paths in cluttered environments. MTCMDE adopts a three-subpopulation co-evolution framework consisting of Scout, Developer, and Balancer. These subgroups exchange information through elite migration, which helps balance exploration and exploitation during the search process. In addition, a manifold-aware perturbation operator is introduced to leverage local topological cues, reducing the risk of premature convergence and improving search efficiency in narrow passages. Furthermore, a reinforcement learning–driven multi-operator scheme based on a bandit model is employed to adaptively allocate mutation strategies, thereby improving convergence accuracy while maintaining population diversity. Experiments were conducted on six wind-affected irregular test cases, including a large-scale, ultra-high-density urban scenario, using a six-dimensional path cost function. The results show that MTCMDE achieves better path feasibility, lower cost, and faster convergence than the compared algorithms. Comprehensive statistical evaluations confirm the robustness and extreme scalability of these improvements. Overall, MTCMDE provides an effective and scalable solution for UAV path planning in irregular 3D environments with wind disturbances.}
}