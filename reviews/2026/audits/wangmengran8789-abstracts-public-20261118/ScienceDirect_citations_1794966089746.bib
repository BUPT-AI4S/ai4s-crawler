@article{COPPOLINO2026116056,
title = {Next-Gen metamorphism: Analyzing the potential of LLM-driven knowledge-based malware evasion},
journal = {Knowledge-Based Systems},
volume = {344},
pages = {116056},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116056},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007823},
author = {L. Coppolino and A. Iannaccone and R. Nardone and A. Petruolo and L. Romano},
keywords = {Malware evasion, Code mutation, Metamorphic engines, Signature-based detection, Large language models, Artificial intelligence},
abstract = {Large Language Models (LLMs) have demonstrated advanced capabilities in code generation and manipulation, inspiring growing concerns about their potential to enhance malware obfuscation. Nevertheless, the cybersecurity literature still lacks wide experimental evidence comparing LLM-driven knowledge-based malware evasion to traditional metamorphic engines. This paper addresses this critical research void through three key contributions: (1) a structured methodology leveraging commercial LLMs (GPT, Claude, DeepSeek, Gemini) against traditional metamorphic engines (MetaMe) using YARA rule detection; (2) experimental evidence demonstrating that LLMs produce variants with significantly higher structural diversity and improved evasion against signature-based detection compared to traditional metamorphic engines, generating variants with substantially greater structural diversity and high evasion rates against signature-based detection; and (3) analysis of LLM-transformed real-world malware (Alina-POS) mutations that systematically evade YARA detection signatures while preserving malicious functionality. Our key insight reveals that LLMs leverage semantic understanding rather than syntactic transformations to achieve effective structural variation in code generation. These findings suggest an emerging trend towards knowledge-based evasion techniques, creating a computational asymmetry where generating sophisticated malware variants requires significantly less expertise and effort than detecting them. This emerging imbalance highlights potential challenges for current malware detection approaches and defensive strategies.}
}
@article{FOLCH2026115996,
title = {MTS-GAN: Synthetic multivariate time series generation with the Mamba architecture},
journal = {Knowledge-Based Systems},
volume = {344},
pages = {115996},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115996},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007227},
author = {Santiago Escuder Folch and Oriol Graupera-Serra and Albert Calvo and Borja Tornos and Gorka Gutiérrez and Josep Escrig and Maxime Compastié},
keywords = {Synthetic data generation, Time-series data, State-space models},
abstract = {The availability of high-quality data is fundamental to the development of robust machine learning workflows. Nevertheless, in complex real-world settings, acquiring qualitative datasets is often both costly and time-consuming. This limitation frequently necessitates the generation of synthetic data, not only to address data scarcity issues but also to provide a mechanism for information sharing while preserving privacy. This paper presents a novel method for multivariate synthetic time-series generation based on a Mamba architecture, namely MTS-GAN, that generates realistic and long-span multivariate time series. Our approach outperforms existing GAN-based methods in generative quality while overcoming the significant computational and inference-time limitations inherent in state-of-the-art diffusion models such as Diffusion-TS. Through a comparative analysis, we demonstrate that MTS-GAN achieves slightly superior results to Diffusion-TS across the majority of tested scenarios, but with a much more efficient architecture that scales linearly with sequence length. We validate our approach using both open-source datasets as a foundational benchmark and a real-world case study centered on predictive maintenance for a milling machine, confirming its practical efficacy and superior efficiency in handling long-sequence data.}
}
@article{HOU2026116042,
title = {Query-guided graph contrastive prototype refined network for cross-domain hyperspectral image change detection},
journal = {Knowledge-Based Systems},
volume = {344},
pages = {116042},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116042},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007689},
author = {Wenhui Hou and Jiangtao Peng and Bing Yang and Lanxin Wu and Weiwei Sun},
keywords = {Hyperspectral image change detection, Few-shot learning, Contrastive learning, Cross-domain},
abstract = {Due to the difficulties in obtaining labeled samples of hyperspectral images (HSI), few-shot learning (FSL) has been applied to hyperspectral change detection (CD) by virtue of its excellent learning ability. However, existing FSL-based methods fail to fully consider the structural correlation between samples and the instability of prototypes. To solve the above issues, this paper proposes a query-guided graph contrastive prototype refined network (QGCPRN) for cross-domain HSI CD, which effectively integrates graph contrastive learning, prototype correction and FSL into a unified framework, alleviating the domain transfer problem caused by differences in data type. Specifically, we designed a graph constraint contrastive module to enhance the compactness of samples within a class and the separability of samples between classes by leveraging the topological structural relationship between samples to strengthen the class boundaries. Meanwhile, in order to further optimize the discriminative power of the prototypes, a top-K query-guided prototype refined module is designed to dynamically correct the support prototypes. In addition, the proposed cross-domain bidirectional prototype-instance contrastive method is constructed to align the feature distribution between the source and target domains. Experiments on three hyperspectral CD datasets show that the proposed QGCPRN algorithm outperforms existing deep learning or small sample learning algorithms.}
}
@article{YUN2026116048,
title = {Unsupervised video stitching via spatiotemporal coupling with temporal propagation and dynamic memory},
journal = {Knowledge-Based Systems},
volume = {344},
pages = {116048},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116048},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007744},
author = {Xiao Yun and Fanfei Yu and Kaiwen Dong and Yanjing Sun},
keywords = {Video stitching, Video stabilization, Unsupervised deep learning, GRU neural network, Spatiotemporal interaction},
abstract = {Video stitching poses a fundamental challenge: while video frames exhibit strong spatiotemporal coupling, prevailing decoupled paradigms artificially separate spatial and temporal information, leading to limited precision and severe efficiency bottlenecks. Consequently, achieving a joint spatiotemporal optimization remains a critical, unresolved objective in this field. To overcome this, we propose an unsupervised video stitching framework that fundamentally reconceptualizes the task as a joint spatiotemporal state estimation problem, driven by temporal propagation and a dynamic memory mechanism. Building upon spatiotemporally decoupled multi-view inputs, we design a Spatially-Aware Gated Recurrent Unit (SA-GRU) structure that mines intrinsic spatiotemporal feature correlations to establish cross-frame temporal propagation and spatiotemporal mapping, thereby compensating for missing temporal information and improving alignment. To overcome the perceptual constraints of sliding windows, we introduce a Temporally-Gated Recurrent Unit (T-GRU) structure integrated with a Spatiotemporal Attention Fusion (STA-Fusion) module, which adaptively integrates long-term historical context with current spatiotemporal constraints to smooth stitching trajectories and enable long-term stabilization with a minimal memory footprint. Evaluations on the Stabstitch-D dataset demonstrate that our method outperforms existing approaches in alignment and geometric fidelity, achieving a PSNR of 31.18, an SSIM of 0.907, and a distortion measure of 0.011. Compared to traditional sliding-window approaches, our framework drastically reduces the memory footprint.}
}
@article{WU2026116069,
title = {RayQ-GAD: Rayleigh Quotient-Driven Graph Pruning for Anomaly Detection},
journal = {Knowledge-Based Systems},
volume = {344},
pages = {116069},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116069},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007951},
author = {Chunqi Wu and Haosen Wang and Chenglong Shi and Pengfei Zheng and Pan Tang},
keywords = {Graph anomaly detection, Rayleigh quotient, Graph pruning},
abstract = {The presence of heterophily in real-world graphs poses a significant challenge for anomaly detection, as the message-passing mechanism of GNNs causes abnormal signals to be overwhelmed by normal neighbors. While edge pruning has emerged as a promising strategy to mitigate this heterophily-induced signal dilution, existing pruning methods frequently result in incomplete or biased edge elimination, limiting their effectiveness. In this paper, we address these limitations by conducting a empirical study, which confirms a strong positive correlation between the Rayleigh quotient of a graph and its level of heterogeneity. Building on this insight, we propose Rayleigh Quotient-Driven Graph Pruning for Anomaly Detection (RayQ-GAD). Our framework begins by sampling seed nodes and iteratively pruning edges within their local subgraphs to minimize the Rayleigh quotient toward a more homophilic configuration, thereby better preserves anomalous signals. Furthermore, we introduce an adaptive representation enhancement mechanism which incorporate pseudo-label representations and community structure information to improve the model’s discriminative capacity. Extensive experiments on multiple benchmark datasets from diverse domains demonstrate that RayQ-GAD outperforms baseline methods, achieving state-of-the-art performance.}
}
@article{LIU2026116084,
title = {Meta-learning-based multi-view multi-label feature selection with streaming labels},
journal = {Knowledge-Based Systems},
volume = {344},
pages = {116084},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116084},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126008105},
author = {Yuzhou Liu and Pengyuan Gao and Long Wang and Jiaqi Sun and Wanfu Gao},
keywords = {Feature selection, Meta-learning, Multi-view learning, Multi-label learning, Streaming labels},
abstract = {Multi-view multi-label feature selection plays a pivotal role in handling high-dimensional heterogeneous data. However, most existing approaches rely on the assumption of a static label space, requiring all class labels to be available prior to training. This limitation renders them ill-equipped for real-world scenarios where labels arrive continuously in a streaming fashion. While Streaming Label Feature Selection addresses the dynamic expansion of label spaces, existing algorithms often overlook the complementary information in multi-view data. To address these challenges, we propose a Meta-learning-based multi-view multi-label Feature Selection with Streaming Labels (MFSSL) method. We formulate streaming label learning as a continuous meta-learning process, employing a gradient-based meta-optimization strategy to achieve fast adaptation to incoming label batches. Specifically, we design a historical stability constraint mechanism that regularizes the current feature mask update using historical memory, thereby effectively preserving valuable historical patterns while maintaining plasticity for new labels. Furthermore, to handle class imbalance and improve feature quality, we introduce a discriminative margin constraint to directly optimize the discrimination capability of the selected features. Extensive experiments on multiple benchmark datasets demonstrate that MFSSL outperforms state-of-the-art methods in terms of classification accuracy and computational efficiency in streaming label environments.}
}
@article{SITU2026116015,
title = {Grounded multimodal named entity recognition via large multimodal models},
journal = {Knowledge-Based Systems},
volume = {344},
pages = {116015},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116015},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007410},
author = {Runwei Situ and Yi Cai},
keywords = {Knowledge-enhanced information extraction, Grounded multimodal named entity recognition, In-context learning, Multiagent debate},
abstract = {Grounded Multimodal Named Entity Recognition (GMNER) is a challenging multimodal information extraction (MIE) task that requires identifying named entities, classifying their types, and grounding them to corresponding regions in images. Despite advancements in large multimodal models (LMMs), their reasoning capabilities in MIE, particularly for GMNER, remain underexplored. To address this gap, we extend GMNER to zero-shot and few-shot scenarios and systematically investigate the reasoning capabilities of LMMs in MIE, focusing on the GPT-4o and GMNER task. Our experiments reveal that GPT-4o struggles in zero-shot GMNER and fails to achieve competitive results in few-shot GMNER when using in-context learning. To overcome the challenges of modality alignment, demonstration quality, and hallucination errors in applying LMMs to GMNER, we propose four tailored strategies: Two-Stage Entity Grounding for bridging the modality gap, Diverse Nearest Search with Entity-Level Self-Consistency Score for enhancing demonstration relevance, and Multiagent Debate and Two-Stage Majority Voting for mitigating hallucinations. Experimental results show that our strategies significantly enhance performance, achieving notable F1 score improvements in zero-shot and few-shot GMNER tasks. Remarkably, our few-shot approach achieves results comparable to fully supervised baselines. Additionally, our investigation of self-correction reveals that LMMs cannot self-refine their reasoning independently without external feedback. Our code and data are available at https://github.com/RunweiSitu/GMNER-LMMs.}
}
@article{JIA2026116076,
title = {Function reliability assessment for mechanical transmission systems based on continuous-state dynamic Bayesian inference},
journal = {Knowledge-Based Systems},
volume = {344},
pages = {116076},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116076},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126008026},
author = {Shuoguo Jia and Yan Ran and Jiawei Wang and Genbao Zhang and Huajun Cao},
keywords = {Function reliability assessment, Mechanical transmission system, Continuous-state dynamic Bayesian inference, Principle of conservation of probability, Meta-action’s SPDF},
abstract = {The reliability assessment is significant for the mechanical transmission system in many advanced pieces of equipment. By focusing solely on the system’s structural integrity, the conventional method adopts the discrete assessment model and the empirical assessment procedure, resulting in reliability assessment results that lack validity. To solve this problem, a function reliability assessment method is proposed for the mechanical transmission system based on continuous-state dynamic Bayesian inference. Integrating multiple factors that may affect the transmission system function state, a continuous-state dynamic Bayesian network is constructed based on the Function-Motion-Action (FMA) decomposition. Through strict mathematical deduction, a continuous-state dynamic Bayesian inference algorithm is presented based on a quantitative analysis of the state propagation mechanism. Resorting to the principle of conservation of probability, the time-varying state probability density function (SPDF) is formulated for meta-actions. The meta-action’s state function is built based on the stochastic process and uncertainty quantification. Finally, the conventional and proposed methods are compared based on the example analysis. The results show that the proposed method yields the transmission system function’s SPDF, which are more generalized and realistic. Moreover, the transmission system function’s state distributions that result from the proposed method are more scientific and valid.}
}
@article{CAO2026115979,
title = {IDEAL: Leveraging infinite and dynamic characterizations of large language models for query-focused summarization},
journal = {Knowledge-Based Systems},
volume = {344},
pages = {115979},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115979},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007057},
author = {Jie Cao and Dian Jiao and Yang Dai and Rolan Yan and Wenqiao Zhang and Siliang Tang},
keywords = {Query-focused summarization, Parameter-efficient fine-tuning},
abstract = {Query-focused summarization (QFS) aims to produce summaries that answer particular questions of interest, enabling greater user control and personalization. The advent of large language models (LLMs), shows their impressive capability of textual understanding through large-scale pretraining, which implies the great potential of extractive snippet generation. In this paper, we systematically investigated two indispensable characteristics that the LLMs-based QFS models should be harnessed, Efficiently Fine-grained Query-LLM Alignment and Lengthy Document Summarization, respectively. Correspondingly, we propose two modules called Query-aware HyperExpert and Query-focused Infini-attention to access the aforementioned characteristics. These innovations pave the way for broader application and accessibility in the field of QFS technology. Extensive experiments conducted on existing QFS benchmarks indicate the effectiveness and generalizability of the proposed approach.}
}
@article{ZHANG2026115932,
title = {CF-AdvGAN: Color-frequency domain adversarial example generation for cross-model attacks},
journal = {Knowledge-Based Systems},
volume = {344},
pages = {115932},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115932},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006581},
author = {Shengcai Zhang and Shibin Wu and Xuan Zhang and Dezhi An},
keywords = {Adversarial attacks, Black-box attacks, Generative adversarial networks, Color space perturbations, Frequency domain optimization},
abstract = {The transferability of adversarial examples is one of the key strategies for black-box attacks on deep neural networks, and its generation efficiency and attack success rate directly affect the effectiveness of the attack. However, existing methods mostly rely on random perturbations or simple gradient guidance, making it difficult to fully model the deep semantic and structural differences between images. This results in limited transfer attack success rates when the generated adversarial examples are used against black-box models with unknown structures. To address this issue, a framework for generating adversarial examples, CF-AdvGAN, is proposed, which combines color space and frequency domain optimization. This method adopts a dual-path collaborative strategy: multiplicative perturbations are introduced in the YCbCr color space to enhance the visual concealment and perceptual consistency of the adversarial examples; at the same time, a frequency domain discrimination mechanism is designed to capture the common feature responses between different models through frequency domain constraints, thereby improving the cross-model transferability of the adversarial examples. Experimental results on the ImageNet dataset show that, under the black-box attack setting, the average attack success rate of CF-AdvGAN is 12.5 percentage points higher than that of the current best baseline. Moreover, under similar perturbation magnitudes, it demonstrates superior and more stable transfer performance for target models of various architectures, fully verifying the effectiveness of the proposed collaborative optimization strategy.}
}
@article{FU2026116090,
title = {Incremental open-set evidential reasoning for uncertainty-aware fault diagnosis in rotating machinery},
journal = {Knowledge-Based Systems},
volume = {344},
pages = {116090},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116090},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126008166},
author = {Haiyue Fu and Qian Wang and Chaoyu Gong and Zhi-gang Su},
keywords = {Rotating machinery, Fault diagnosis, Open-set recognition, Dempster–Shafer theory, Uncertainty estimation},
abstract = {Open-set fault diagnosis must not only detect previously unseen faults but also adapt to newly emerging variants of known faults during operation. Without timely adaptation, distributional drift can undermine diagnostic reliability, whereas frequent retraining may destabilize decision boundaries. To address these challenges, we propose an Incremental Open-Set Evidence Reasoning Framework (IOS-ERF). The framework first assigns evidential masses based on local neighbor distances to derive an ignorance-driven uncertainty score for open-set recognition. A risk-calibrated decision boundary is then obtained from the empirical distribution of this score using leave-one-out quantiles, providing a data-driven criterion for distinguishing known from unknown faults. Finally, within the uncertainty domain, candidate samples are evaluated for distributional discrepancy with respect to existing data to determine whether incremental updating is required. Experimental results demonstrate that the proposed IOS-ERF achieves over 97% recognition accuracy in both gear open-set identification and incremental open-set bearing fault diagnosis tasks, confirming its robustness and stability in handling previously unknown fault categories.}
}
@article{LI2026116021,
title = {TCDNet: Compression-decompression network via time–frequency feature fusion for multivariate time series forecasting},
journal = {Knowledge-Based Systems},
volume = {344},
pages = {116021},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116021},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007471},
author = {Peng-Cheng Li and Jiang-Wen Xiao and Yan-Wu Wang},
keywords = {Time series forecasting, Time series imputation, Time–frequency feature fusion, Few-shot time series forecasting, Multistep ahead forecasting},
abstract = {Multiscale analysis has emerged as a critical approach for capturing complex temporal dynamics in multivariate time series forecasting. However, existing multiscale models predominantly focus on inter-scale fusion while neglecting intra-scale dependencies—the unique temporal patterns and relationships that exist within specific sampling resolutions. Relying on simple pooling operations and fixed receptive fields, these models often blur resolution-specific information before it can be effectively integrated. To address these limitations, we propose the Time Compress-Decompress Network (TCDNet). TCDNet introduces two key innovations: (1) a multiple-kernel feature extraction (MKFE) block that leverages attention mechanisms and diverse receptive fields to explicitly model intra-scale dependencies and adaptively extract robust features; and (2) a time-frequency feature fusion (T3F) mechanism that captures latent, underrepresented information from the compressed representations and injects it into the decompression stages to ensure a balanced, holistic information flow. By progressively compressing temporal data to isolate salient macroscopic trends and subsequently decompressing it to reconstruct fine-grained predictive details, TCDNet enables highly accurate forecasting. Extensive experiments across diverse forecasting tasks demonstrate that TCDNet establishes a new state-of-the-art, outperforming leading models — including TimeMixer, UnetTSF, and iTransformer — by an average of 12.3%.}
}
@article{SEBASTIAN2026116043,
title = {Adaptive clustering-driven imputation with A Priori suitability estimation for unlabeled data},
journal = {Knowledge-Based Systems},
volume = {344},
pages = {116043},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116043},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007690},
author = {Anu Maria Sebastian and David Peter and Rinu Ann Sebastian},
keywords = {Reconstruction errors, Significant dependencies, Unlabeled data, Imputation, Dunn index, Unsupervised learning},
abstract = {Missing data is a pervasive challenge in real-world datasets, often impairing the performance of unsupervised learning algorithms and compromising the integrity of downstream analyses. In this work, we propose a novel Dunn Index-Based Clustering Imputation (DBCI) algorithm that adaptively imputes missing values while preserving the underlying latent data structure. Unlike conventional approaches, DBCI is training-free, domain-agnostic, and explicitly leverages both intra-cluster cohesion and inter-cluster separation during imputation. To address the limitations of traditional ablation-based and posterior validation approaches, which rely on ground truth that is typically unavailable in most real-world settings, we further introduce an a priori suitability assessment mechanism. This mechanism evaluates the expected effectiveness of DBCI prior to imputation, shows strong association with downstream imputation performance, and generalizes to other centroid-based imputation methods. Experimental results demonstrate that DBCI achieves lower imputation errors, maintains structural integrity, and improves performance on downstream unsupervised tasks, including projection methods and self-organizing maps. These properties make it particularly valuable in data-scarce domains such as healthcare, environmental monitoring, and finance. Overall, our work lays a foundation for real-time, suitability-aware imputation within unsupervised machine learning pipelines.}
}
@article{DONG2026115983,
title = {Dual-branch attention network with multi-level spectral–spatial fusion for hyperspectral image classification},
journal = {Knowledge-Based Systems},
volume = {344},
pages = {115983},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115983},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007094},
author = {Liang Dong and Yuanlin Dang and Lei Zhu and Xiaofei Yang},
keywords = {Grouped self-attention, Shifted-window spatial enhancement, Depth-weighted spectral–spatial fusion, CNN–transformer, Hyperspectral image classification},
abstract = {Hyperspectral image (HSI) classification is a challenging task due to the high dimensionality of spectral data and complex correlations between spectral and spatial domains. Existing approaches generally assign uniform weights to all bands and apply shallow fusion, limiting the exploitation of discriminative information and introducing redundancy. To address these limitations, we propose a dual-branch multi-level spectral–spatial feature fusion (DMSSFF) network. The proposed model integrates Transformer and convolutional neural networks (CNNs) to jointly enhance spectral–spatial representations. A grouped cross-block interactive self-attention (GCISA) branch extracts detailed spectral features and learns representations sensitive to similarity, while a multi-layer shifted window spatial feature enhancement (SW-SFE) branch captures multi-scale spatial–spectral dependencies. An efficient depth-weighted cross-attention fusion (E-DCF) module further integrates the complementary features through adaptive attention and weighting. Experiments on three benchmark datasets demonstrate that DMSSFF achieves superior accuracy over state-of-the-art methods, confirming its ability to effectively capture and fuse spectral–spatial knowledge for robust HSI classification. The corresponding code is available at https://github.com/cgma-1/DMSSFF.}
}
@article{YAO2026116054,
title = {Category guided keyphrase generation via alternate meta-tuning},
journal = {Knowledge-Based Systems},
volume = {344},
pages = {116054},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116054},
url = {https://www.sciencedirect.com/science/article/pii/S095070512600780X},
author = {Yu Yao and Peng Yang},
keywords = {Natural language generation, Keyphrase generation, Contrastive learning, Meta-learning},
abstract = {Existing keyphrase generation (KG) methods typically employ a weight subnetwork to combine the copy and generating probability distributions when producing target keyphrases. However, these methods are hampered by irrational copy and generating distribution proportions from the weight subnetwork. To tackle this problem, we propose a category guided meta-tuning keyphrase generation method called CMeta-KG, which utilizes category information and alternate meta-tuning to optimize the weight subnetwork more accurately. With contrastive learning, CMeta-KG adopts a retriever to mine richer category information and yields more accurate distribution proportions. Moreover, CMeta-KG revises the standard meta-learning pipeline with an alternate parameter update strategy to refine the weight subnetwork. Notably, we provide a theoretical analysis based on information theory to explain the choice of focusing on the meta-tuning weight subnetwork instead of the overall model parameters. Experiments on the scientific article and social media datasets demonstrate the effectiveness of the contrastive setup and meta-tuning pipeline.}
}
@article{IDOWU2026116067,
title = {Mapping human anti-collusion mechanisms to multi-agent AI systems},
journal = {Knowledge-Based Systems},
volume = {344},
pages = {116067},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116067},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007938},
author = {Jamiu Idowu and Ahmed S. Almasoud and Ayman Alfahid},
keywords = {Collusion, Multi-agent ai systems, AI safety, Anti-collusion mechanisms, Human domains},
abstract = {As multi-agent AI systems become increasingly autonomous, evidence shows they can develop collusive strategies similar to those long observed in human markets and institutions. While human domains have accumulated centuries of anti-collusion mechanisms, it remains unclear how these can be adapted to AI settings. This paper addresses that gap by (i) developing a taxonomy of human anti-collusion mechanisms, including sanctions, leniency & whistleblowing, monitoring & auditing, market design, and governance and (ii) mapping them to potential interventions for multi-agent AI systems. For each mechanism, we propose implementation approaches. We also highlight open challenges, such as the attribution problem (difficulty attributing emergent coordination to specific agents), identity fluidity (agents being easily forked or modified), the boundary problem (distinguishing beneficial cooperation from harmful collusion), and adversarial adaptation (agents learning to evade detection).}
}
@article{TAZ2026115968,
title = {Predicting student satisfaction in metaverse platform using deep learning},
journal = {Knowledge-Based Systems},
volume = {344},
pages = {115968},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.115968},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126006945},
author = {Shaik Shameen Taz and B.Narendra Kumar Rao},
keywords = {Metaverse, Deep learning, Virtual reality, Student satisfaction prediction, Long Short-Term memory},
abstract = {Predicting student satisfaction on Metaverse platforms can improve educational effectiveness by analyzing factors like engagement, interaction, and content delivery. The benefits include personalized, immersive learning experiences and real-time feedback. However, the existing schemes suffer from overfitting issues due to highly imbalanced data and fail to generalize to diverse content. To address these limitations, a robust model, Deep High Attention Long Short-Term Memory Forward Harmonic Network (DHA-LSTM-FH Net), is proposed to predict student satisfaction in Virtual Reality (VR) teaching within the Metaverse. The model utilizes data from Metaverse platforms, including virtual spaces, Augmented Reality (AR)/VR devices, learning materials, and student information. Initially, interaction logs from VR sessions and student profiles are collected as input. The data undergoes softmax normalization to ensure consistency. Feature selection is conducted using Recursive Feature Elimination (RFE) and Elastic Net to select the key features. Local Density-based Synthetic Minority Over-Sampling Technique (LD-SMOTE) is then applied to address data imbalance. Student satisfaction prediction is done by DHA-LSTM-FH Net, which is developed by combining Deep High Attention Neural Network (DHA-Net) and Long Short-Term Memory (LSTM) using Harmonic Analysis. Experimental results show that the model achieves a precision of 93.765 %, a recall of 95.755 %, an F1 Score of 94.750 %, and a Cohen’s Kappa of 0.838, outperforming baseline methods. However, the model is trained on a specific VR/Metaverse platform, so its performance may drop when applied to different Metaverse setups or content types.}
}
@article{XU2026116065,
title = {Interaction makes better segmentation: An interaction-based framework for temporal action segmentation},
journal = {Knowledge-Based Systems},
volume = {344},
pages = {116065},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116065},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007914},
author = {Minjie Xu and Jinrong Zhang and Jiajun Fan and Chenyu Xiao and Shenglan Liu and Zehao Wang and Lin Feng},
keywords = {Video understanding, Temporal action segmentation, Frame-action interaction, Query-based modeling},
abstract = {Temporal action segmentation (TAS) aims to classify the action category of each frame in untrimmed videos, with RGB videos or skeleton sequences as common inputs. Most existing methods follow a two-stage pipeline of feature extraction and temporal modeling. However, we observe two key limitations in their spatio-temporal modeling: (i) Existing temporal modeling modules conduct frame-level and action-level interactions at a single fixed temporal resolution, which over-smooths temporal features and blurs action boundaries; (ii) Skeleton-based methods generally adopt temporal modeling modules originally designed for RGB video data, causing a misalignment between extracted features and temporal modeling modules. To address these issues, we propose a novel Interaction-based framework for Action segmentation (InterAct). Firstly, we introduce multi-scale frame-action interaction (MFAI) to facilitate frame-action interactions across varying temporal scales. This enhances the model’s ability to capture complex temporal dynamics, producing more expressive temporal representations and alleviating the over-smoothing issue. Meanwhile, recognizing the complementary nature of different spatial modalities, we further propose decoupled spatial modality interaction (DSMI). It decouples the modeling of spatial modalities and applies a deep fusion strategy to interactively integrate multi-scale spatial features. This results in more discriminative representations that better support temporal modeling. Extensive experiments on seven large-scale benchmarks show that InterAct significantly outperforms state-of-the-art methods on both RGB-based and skeleton-based TAS. Further evaluations on multi-person interactions and simulated occlusions demonstrate improved robustness under imperfect skeleton observations. The code is available at https://github.com/gdxxu/InterAct-main.}
}
@article{ZOU2026116094,
title = {MS-DDI: A multi-scale representation learning approach for drug-drug interaction prediction},
journal = {Knowledge-Based Systems},
volume = {344},
pages = {116094},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116094},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126008208},
author = {Zhilin Zou and Peiying Li and Bin Sheng and Liming Xin},
keywords = {Drug–drug interaction, Joint molecular representation, Self-attention, Hierarchical representation, Molecular graph},
abstract = {Accurate prediction of drug–drug interactions (DDI) is essential for preventing adverse events. Most existing studies encode drugs separately and then model their relationships, often overlooking the joint chemical context and the hierarchical relationships between atom-level and motif-level structures. To address this issue, we present MS-DDI, a framework for DDI prediction based on multi-scale molecular representation learning. We propose a Joint Molecular Representation (JMR) module that integrates two drugs into a unified computational framework while preserving the inherent topological structure of each molecule, thereby facilitating the learning of multi-scale features. To enable deeper interaction across hierarchical features, we further propose a Hierarchical Feature Interaction (HFI) module. HFI leverages reciprocal cross-attention between motif-level and atom-level features, allowing bidirectional feature querying. In addition, a maco-attention mechanism is introduced for synergistic feature fusion and precise localization of interaction hotspots. MS-DDI achieves accuracies of 97.24% on DrugBank and 87.89% on Twosides. Under the challenging cold-start setting, MS-DDI demonstrates stronger generalization and robustness for unseen drugs, achieving a 6-percentage-point improvement in accuracy over the DeepDDI baseline. Ablation studies validate the contribution of each component, and attention visualizations indicate that the model focuses on chemically salient atoms and functional groups, further enhancing interpretability. Overall, MS-DDI provides a robust and interpretable approach to DDI prediction by unifying multi-scale feature representation with hierarchical feature interaction.}
}
@article{ZHAO2026116055,
title = {ReSemGS-SLAM: Real-time semantic Gaussian Splatting SLAM based on semantic consistency perception},
journal = {Knowledge-Based Systems},
volume = {344},
pages = {116055},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116055},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007811},
author = {Zhangzhen Zhao and Qiang Liu and Dingli Li and Zilong Li and Tianzhi Xia and Chunxiang Yan and Qing Li},
keywords = {Slam, 3D Gaussian Splatting, Semantic slam, Semantic consistency perception, Real-time},
abstract = {Real-time dense semantic simultaneous localization and mapping (SLAM) remains challenging owing to the substantial computational cost of semantic inference and the difficulty of preserving cross-frame consistency. To address these limitations, we propose ReSemGS-SLAM, a real-time dense semantic SLAM framework built upon 3D Gaussian Splatting. ReSemGS-SLAM introduces a semantic state modeling mechanism that aggregates weighted multi-frame observations to estimate robust class distributions for each Gaussian primitive, thereby reducing semantic ambiguity and suppressing noisy predictions. Additionally, we develop a semantic consistency-driven pyramid mapping strategy that enforces cross-scale coherence through Jensen–Shannon divergence-based regularization, enabling efficient and accurate hierarchical reconstruction while maintaining real-time performance. Extensive evaluations on the Replica, TUM EuRoC, and real-world datasets demonstrate that ReSemGS-SLAM attains state-of-the-art performance in both mapping and localization, achieving an absolute trajectory error of 0.524 cm, a semantic mean Intersection over Union of 96.79%, and a real-time mapping rate of 35.80 FPS. Notably, the system sustains robust real-time operation even on resource-constrained platforms such as the Jetson AGX.}
}
@article{CHEN2026116095,
title = {GeoWaveNet: A geometric wavelet transformer for spatiotemporal traffic flow prediction},
journal = {Knowledge-Based Systems},
volume = {344},
pages = {116095},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116095},
url = {https://www.sciencedirect.com/science/article/pii/S095070512600821X},
author = {Linlong Chen and Qingfang Wu},
keywords = {Traffic flow prediction, Wavelet embedding, Geometric attention, Multi-Scale Transformer},
abstract = {In complex urban road networks, traffic flow data exhibit pronounced nonstationarity and multi-scale structure. They comprise low-frequency long-term trends and high-frequency transient events, which hinder single-scale spatiotemporal models from capturing both global evolution and local dynamics. To address this issue, a spatiotemporal prediction model, GeoWaveNet, built on the Geometric Wavelet Transformer, is presented. The model uses Multi-Scale Wavelet Embedding to decouple time-frequency structure, separating long-term trends from short-term event signals in the energy space and providing a stable basis for multi-scale representation. Building on this, Geometric Attention jointly models amplitude similarity and directional consistency, while the Learnable Projector adaptively reweights them to achieve direction-robust spatiotemporal alignment and dynamic weight allocation. Furthermore, Cross-Scale Geometric Attention builds sparse dependencies and enforces energy conservation across scales, thereby promoting consistent information propagation and steady-state fusion between trend and event components. Finally, the encoded representations are reconstructed via inverse wavelet transformation and fed to a linear prediction head to produce traffic flow predictions. Experiments on multiple real-world traffic datasets show that GeoWaveNet consistently surpasses existing approaches, confirming its effectiveness and generalization in multi-scale modeling and direction-adaptive fusion.}
}
@article{NI2026116071,
title = {Interpretable knowledge tracing via explicit–implicit alignment},
journal = {Knowledge-Based Systems},
volume = {344},
pages = {116071},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116071},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007975},
author = {Ersheng Ni and Jiaxin Wang and Jining Luan and Jiacheng Liu and Shuyan Xiong and Sibo Xu and Weihua Cheng and Mengmeng Chen and Yongxin Ni and Youhua Li},
keywords = {Interpretable knowledge tracing, Large language models, Student modeling, Personalized feedback},
abstract = {Interpretability in Knowledge Tracing (KT) is crucial for personalized learning. Current mainstream Deep Learning-based KT (DLKT) achieves strong predictive performance with ID-based representations, but students’ latent knowledge states remain opaque to teachers and learners. Large Language Models (LLMs) can generate human-readable text, but explanations from existing LLM-augmented KT approaches are either detached from the predictive state or insensitive to individual trajectories. To bridge this gap, we propose Interpretable Knowledge Tracing via Explicit–Implicit Alignment (IKT-EIA), which anchors implicit student knowledge representations with LLM-derived explicit textual insights. IKT-EIA consists of: (1) Context-Guided Knowledge Integration (CGKI) uses LLMs to generate trajectory-aware textual knowledge from student metadata; (2) Query-Driven Knowledge State Alignment (QKSA) treats the implicit state as a query to retrieve and fuse explicit semantics, producing an aligned knowledge state that supports subsequent explanation analysis; (3) Personalized Explainability Adaptation (PEA) generates structured and adaptive feedback by reading the aligned state together with raw interaction records, tailoring explanations to students’ evolving mastery. Experiments on benchmark datasets show that IKT-EIA maintains competitive predictive performance while producing state-aware explanations that were found useful in a controlled evaluation setting.}
}
@article{LIU2026116086,
title = {Real or fake, a real–fake category aware fake news detection model based on pseudo-siamese image–text hybrid encoder},
journal = {Knowledge-Based Systems},
volume = {344},
pages = {116086},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116086},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126008129},
author = {Shouxin Liu and Hongran Zeng and Junfeng Guo and Chongyang Zhang and In-Kwon Lee and Yushu Zhang and Xiaowei Li},
keywords = {Fake news detection, Hybrid encoding, Category aware attention, Hard feature mining},
abstract = {Existing multimodal fake news detection methods typically treat multimodal information encoding and interaction as two separate stages, lacking a unified single-stage framework for joint encoding and feature interaction. Moreover, widely used attention mechanisms struggle to clearly distinguish between real and fake related features and are insufficient in mining hard features. To address these issues, we propose a multimodal fake news detection method that integrates a vision-language encoder with a category aware attention mechanism. Specifically, we first design a single-stage multimodal hybrid encoding and feature interaction module that simultaneously encodes and interacts image–text features to generate deeply fused multimodal representation. Then, we introduce a text guided real–fake category aware attention mechanism to explicitly guide the model to focus on regions associated with real and fake content, and further mine and learn hard features based on the distribution differences between real and fake features. Finally, a non-gated mixture-of-experts strategy is employed to collaboratively model real, fake and hard features, and generate the final discriminative representation. Experimental results on the public datasets PolitiFact and GossipCop show that the proposed method achieves accuracy improvements of 5.1% and 1.3%, respectively. Furthermore, validation results on diverse datasets such as Twitter and Pheme demonstrate that our method also exhibits satisfactory detection performance.}
}