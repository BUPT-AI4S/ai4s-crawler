@article{LI2026116085,
title = {Fractal knowledge-guided diffusion representation learning framework for self-supervised crack segmentation},
journal = {Knowledge-Based Systems},
volume = {344},
pages = {116085},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116085},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126008117},
author = {Xinran Li and Xiangyang Xu and Hao Yang},
keywords = {Contrastive learning, Diffusion learning, Fractal knowledge, Crack segmentation, Self-supervised},
abstract = {Fine-scale crack segmentation is a fundamental task for large-scale infrastructure condition assessment. However, existing supervised deep learning approaches rely heavily on large-scale pixel-level annotations, which are costly and difficult to obtain due to the irregular geometry, elongated structures, and complex morphological characteristics of pavement cracks. To address these challenges, this paper proposes a novel fractal knowledge-guided diffusion representation learning framework for unlabeled pavement crack segmentation. Specifically, a fractal knowledge synthesis strategy is introduced to model the intrinsic self-similar structural patterns of cracks through a stochastic affine fractal system, providing topology-consistent structural priors for unlabeled learning. Guided by this structural knowledge, multi-scale gated diffusion representation learning is proposed to progressively enhance crack feature modeling and improve structural awareness. In addition, a dual-stream spatially adaptive denormalization mechanism was proposed to enable adversarial training between synthesized crack images and real crack images, thereby comprehensively extracting crack semantics. Finally, the contrastive loss based on contrastive unpaired translation is developed to encourage true and reliable crack representation. Comparative and ablation experiments have shown that the proposed method outperforms existing self-supervised methods in crack segmentation performance, compared to the optimal method among the comparison methods, its F1-score, AP, and IoU increased by 15.32%, 11.76% and 10.98%, respectively. The proposed paradigm provided a robust and scalable solution for intelligent infrastructure condition assessment in real-world scenarios with unlabeled data.}
}
@article{GUAN2026116024,
title = {Graph unlearning: Efficient node removal in graph neural networks},
journal = {Knowledge-Based Systems},
volume = {344},
pages = {116024},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116024},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007501},
author = {Faqian Guan and Tianqing Zhu and Zhoutian Wang and Wei Ren and Wanlei Zhou},
keywords = {Graph neural networks, Node unlearning, Privacy protection, Graph unlearning},
abstract = {With increasing concerns about privacy attacks and potential sensitive information leakage, researchers have actively explored methods to efficiently remove sensitive training data and reduce privacy risks in graph neural network (GNN) models. Node unlearning has emerged as a promising technique for protecting the privacy of sensitive nodes by efficiently removing specific training node information from GNN models. However, existing node unlearning methods either impose restrictions on the GNN structure or do not effectively utilize the graph topology for node unlearning. Some methods even compromise the graph’s topology, making it challenging to achieve a satisfactory performance-complexity trade-off. To address these issues and achieve efficient unlearning for training node removal in GNNs, we propose three novel node unlearning methods: Class-based Label Replacement, Topology-guided Neighbor Mean Posterior Probability, and Class-consistent Neighbor Node Filtering. Among these methods, Topology-guided Neighbor Mean Posterior Probability and Class-consistent Neighbor Node Filtering effectively leverage the topological features of the graph, resulting in more effective node unlearning. To validate the superiority of our proposed methods in node unlearning, we conducted experiments on three benchmark datasets. The evaluation criteria included model utility, unlearning utility, and unlearning efficiency. The experimental results demonstrate the utility and efficiency of the proposed methods and illustrate their superiority compared to state-of-the-art node unlearning methods. Overall, the proposed methods efficiently remove sensitive training nodes and protect the privacy information of sensitive nodes in GNNs. The findings contribute to enhancing the privacy and security of GNN models and provide valuable insights into the field of node unlearning.}
}
@article{FENG2026116040,
title = {Privacy-preserving Federated Graph Neural Network with Global Semantic Augmentation and Layer-Wise Node Alignment for Social Analysis},
journal = {Knowledge-Based Systems},
volume = {344},
pages = {116040},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116040},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007665},
author = {Yan Feng and Quan Qian},
keywords = {Social network analysis, Federated graph learning, Privacy protection, Structure discrepancy, Attribute discrepancy, Graph neural network},
abstract = {Exploring the intrinsic value of social data has long been a central focus in research. Currently, social network data are dispersed across multiple platforms. While federated learning enables collaborative model training among clients while preserving privacy, structure and attribute discrepancies across clients’ data continue to present significant challenges, including performance degradation and potential privacy leakage. To address these limitations, we propose a Privacy-preserving Federated Graph Neural Network Learning with Global Semantic Augmentation and Layer-wise Node Alignment for Social Analysis (PPFedSALA), which achieves both performance improvement and privacy protection. To mitigate structure discrepancy under privacy constraints, we design a Federated Global Semantic Augmentation (FedGSA) module. It reconstructs the global graph structure based on node importance and utilizes cross-layer attention fusion to obtain enhanced node representations. Furthermore, an efficient dual encryption privacy protection mechanism (EDPP) is introduced to protect the model parameters involved in semantic augmentation, effectively ensuring privacy while reducing performance degradation and improving communication efficiency. To address attribute discrepancy while preserving privacy, we propose a Federated Layer-wise Node Alignment (FedLNA) module. It performs hierarchical push-pull operations between node representations and global class centroids, aligning local and global distributions more closely to capture richer global information. In addition, we design an attention-based encryption mechanism (AHE) to ensure privacy during the node alignment process, reducing performance loss and optimizing communication overhead. We evaluate PPFedSALA on five datasets, achieving accuracy scores of 0.893, 0.747, 0.606, 0.89, and 0.903, outperforming other methods. Ablation studies further validate the effectiveness of global semantic augmentation and layer-wise node alignment. Moreover, we demonstrate that the proposed security mechanisms are effective and introduce minimal impact on model performance.}
}
@article{SOJO2026116077,
title = {Transfer learning for nonparametric Bayesian networks},
journal = {Knowledge-Based Systems},
volume = {344},
pages = {116077},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116077},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126008038},
author = {Rafael Sojo and Pedro Larrañaga and Concha Bielza},
keywords = {Bayesian network, Transfer learning, Kernel density estimation, Nonparametric distribution},
abstract = {This paper introduces two transfer learning methodologies for estimating nonparametric Bayesian networks under scarce data. We propose two algorithms, a constraint-based structure learning method, called PC-stable-transfer learning (PCS-TL), and a score-based method, called hill climbing transfer learning (HC-TL). We also define particular metrics to tackle the negative transfer problem in each of them, a situation in which transfer learning has a negative impact on the model’s performance. Then, for the parameters, we propose a log-linear pooling approach. For the evaluation, we learn kernel density estimation Bayesian networks, a type of nonparametric Bayesian network, and compare their transfer learning performance with the models alone. To do so, we sample data from small, medium and large-sized synthetic networks and datasets from the UCI Machine Learning repository. Then, we add noise and modifications to these datasets to test their ability to avoid negative transfer. To conclude, we perform a Friedman test with a Bergmann–Hommel post-hoc analysis to show statistical proof of the enhanced experimental behavior of our methods. Thus, PCS-TL and HC-TL demonstrate to be reliable algorithms for improving the learning performance of a nonparametric Bayesian network with scarce data, which in real industrial environments implies a reduction in the required time to deploy the network.}
}
@article{YUAN2026116010,
title = {Motion–disturbance decoupling with interaction-aware association for satellite video multi-object tracking},
journal = {Knowledge-Based Systems},
volume = {344},
pages = {116010},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116010},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007367},
author = {Yuman Yuan and Tianyu Deng and Hongyang Bai and Shuai Guo and Yuanbo Chen},
keywords = {Satellite video, Multi-object tracking, Small object detection, Detection-by-tracking},
abstract = {Multi-object tracking (MOT) in satellite video remains challenging because weak target responses, large static backgrounds, and frequent target interactions degrade both detection reliability and data association quality. To address these challenges, a motion–disturbance decoupling network, termed MI-ED, is proposed. The framework models target dynamics with two components: a predictable motion component and an interaction- or occlusion-induced disturbance component. This decoupling is then used to improve detection and association within a unified framework. On the detection side, a motion prior perception module integrates long-term, short-term, and reversed temporal cues, while a motion-guided cross-scale attention feature pyramid network enhances sparse dynamic responses and suppresses static background interference. On the tracking side, an environmental disturbance inference module estimates local interaction risk and recalibrates detection confidence, and a disturbance-aware multi-stage association strategy is used to preserve reliable weak detections and recover targets after short-term misses. Extensive experiments on AIR-MOT and VISO show that, relative to a strong competing method, MI-ED yields MOTA gains of 2.7 and 7.9 points while reducing FP/FN by 19.0%/6.2% and 13.6%/24.4%, respectively, demonstrating strong robustness in dense and occluded satellite scenarios.}
}
@article{LI2026116083,
title = {Multi-Hypergraph fusion for network-wide traffic flow prediction: A spatiotemporal hypergraph neural network},
journal = {Knowledge-Based Systems},
volume = {344},
pages = {116083},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116083},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126008099},
author = {Minze Li and Feng Shao and Pengjie Liu and Wenhao Liu and Hu Shao and Liang Shen},
keywords = {Traffic flow prediction, Hypergraph neural network, Multi-hypergraph integration, Spatiotemporal modeling},
abstract = {Accurate traffic flow prediction is a cornerstone of intelligent transportation systems (ITSs), yet achieving high precision remains a critical challenge due to the complex and nonlinear spatiotemporal dynamics of real-world traffic. Conventional graph convolutional approaches often fall short as they primarily model pairwise spatial dependencies, failing to capture the higher-order interactions inherent in large-scale road networks. To address this limitation and provide a more comprehensive understanding of traffic evolution, this paper proposes the Spatiotemporal Multi-Hypergraph Neural Network (STMHGNN), a novel framework for network-wide traffic flow prediction. STMHGNN explicitly captures higher-order spatial correlations through three purpose-built hypergraphs: (1) an upstream–downstream adjacency hypergraph that encodes directional interactions between connected road segments; (2) a regional hypergraph that reflects shared traffic patterns within geographic neighborhoods; and (3) a historical pattern hypergraph that links road segments exhibiting similar temporal dynamics. These hypergraph representations are integrated using HGNNs in the spatial module, while a long short-term memory network is employed to model temporal dependencies. Experiments conducted on real-world freeway traffic data from Los Angeles demonstrate that STMHGNN consistently outperforms state-of-the-art benchmarks across all evaluation metrics, achieving a root mean square error (RMSE) of 27.257, a mean absolute error (MAE) of 17.019, and a mean absolute percentage error (MAPE) of 6.21 %. By effectively capturing complex multi-way spatial relationships and temporal dynamics, this study not only provides a superior predictive tool but also offers valuable theoretical insights for advancing ITS, ultimately supporting more proactive traffic management and sustainable urban mobility.}
}
@article{CHEN2026116089,
title = {CHIME: Conditional hallucination and integrated multi-scale enhancement for time series diffusion model},
journal = {Knowledge-Based Systems},
volume = {344},
pages = {116089},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116089},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126008154},
author = {Yuxuan Chen and Yuxuan Wu and Haipeng Xie},
keywords = {Time series, Diffusion model, Multi-scale integration, Feature hallucination},
abstract = {The denoising diffusion probabilistic model has emerged as a leading generative model, demonstrating significant success in various computer vision tasks. Recently, initial explorations have applied diffusion models to time series tasks; however, existing studies encounter challenges in multi-scale feature alignment and generative capabilities across different entities and few-shot scenarios. This study proposes CHIME, a conditional hallucination and integrated multi-scale enhancement framework for time series diffusion models. By utilizing multi-scale decomposition and integration, CHIME captures the decomposed features of time series, achieving in-domain distribution alignment between generated and original samples. Additionally, we introduce a Feature Hallucination (FH) module in the conditional denoising process to enable generic temporal semantic knowledge transfer. Experimental results on publicly available real-world datasets demonstrate that CHIME achieves state-of-the-art performance and exhibits excellent generalization capabilities in few-shot scenarios}
}
@article{SANG2026116081,
title = {Latent Transformer Diffusion Domain-adaptive network for cross-domain seismic data reconstruction},
journal = {Knowledge-Based Systems},
volume = {344},
pages = {116081},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116081},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126008075},
author = {Yu Sang and Siman Li and Xinjun Zhang and Hongyan Guo and Anlong Yuan and Desheng Dong and Mingde Lu and Yunan Liu},
keywords = {Seismic data reconstruction, Weak seismic signals, Domain adaptation, Diffusion transformer attention, Sparse cross-domain structural alignment},
abstract = {Seismic data reconstruction is essential for accurate subsurface imaging and reliable hydrocarbon exploration. However, two major challenges remain in practical applications. First, weak seismic signals are often masked by strong noise, which limits fine structural interpretation and reservoir prediction in seismic exploration. Second, in low signal-to-noise ratio (SNR) conditions, it is difficult to obtain high-quality labels from real data, forcing models to rely on synthetic data for training. However, discrepancies in waveform and noise distributions between synthetic and real data introduce a domain shift that can undermine the reliability of the reconstructed data. To tackle these challenges, we propose a Latent Transformer Diffusion Domain-adaptive (LTDD) network for synthetic to real adaptation, which adopts diffusion-based iterative denoising to suppress strong noise and recover weak signals, and performs domain adaptation via latent-space structural alignment. Specifically, to mitigate the loss of weak signals and alleviate over-smoothing, we design a Diffusion Transformer Attention (DTA) module and integrate it with prior-guided adaptive frequency-domain decomposition, which jointly encodes low-frequency geological structures and high-frequency details into the latent space, effectively preserving weak signal features. Furthermore, to address cross-domain distribution shifts between synthetic and real data, we propose a Sparse Cross-domain Structural Alignment (SCSA) strategy, which instead sparsely aligns key structural relationships in the latent space. When evaluated on synthetic and real well data, our method outperforms state-of-the-art methods. Ablation studies validate the effectiveness of each component in LTDD. When processed on real field data, LTDD successfully restores more effective weak signals and generates a resolution-enhanced seismic data.}
}
@article{TANG2026116087,
title = {SAformer: A time series anomaly detection model based on Similarity-Aware attention},
journal = {Knowledge-Based Systems},
volume = {344},
pages = {116087},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116087},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126008130},
author = {Yunkai Tang and Guiling Li and Zongda Wu and Philip S. Yu},
keywords = {Time series, Anomaly detection, Attention mechanism},
abstract = {Time series anomaly detection has become a prominent research topic in recent years. Reconstruction-based methods have demonstrated strong performance on this task. However, existing approaches still struggle to detect shapelet anomalies and multi-peaked anomalies, as traditional attention mechanisms fail to comprehensively capture potential abnormal patterns. To address this limitation, we propose SAformer, a novel time series anomaly detection model based on Similarity-Aware attention. SAformer incorporates shape similarity between subsequences to enhance traditional attention mechanisms and leverages a global dictionary to improve the detection of multi-peaked anomalies. In addition, it introduces the concepts of strong and weak similarity domains to further enrich similarity representation, while integrating sequence-level information to refine anomaly scores. Experimental results on five public benchmark datasets demonstrate that SAformer achieves state-of-the-art performance in anomaly detection, validating the effectiveness and robustness of the proposed SAformer attention mechanism.}
}
@article{NAIR2026116079,
title = {Tri-projection gated cross-modal fusion for robust multilingual emotion recognition},
journal = {Knowledge-Based Systems},
volume = {344},
pages = {116079},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116079},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126008051},
author = {Suja C. Nair and Asha S. and Priya K.V. and Kavya Clare P. Shaji and Balakrishnan C. and T. Kokilavani},
keywords = {Confidence-aware multimodal fusion, Code-switched emotion recognition, Cross-modal modeling, Multilingual analysis, Affective computing},
abstract = {Existing multimodal approaches in emotion recognition (ER) rely on static or pairwise fusion strategies. These systems do not adequately address the challenges in real-world conversational systems, which require resilience to both multilingual code-switching and variable reliability of multiple modalities. We propose a transformer-based tri-modal emotion identification framework with a novel Tri-Projection Gated Cross-Modal Fusion (T-GCMF) module — the first multimodal emotion recognition architecture explicitly designed for code-switched conversational input. T-GCMF simulates tri-modal interactions by explicitly calculating modality-specific confidence and cross-modal consistency, allowing for dynamic suppression of unreliable modalities during inference. Acoustic and visual cues are retrieved using CNN–LSTM and deep CNN encoders, respectively. Textual representations are generated using XLM-RoBERTa to handle code-switched language reliably. We introduce Hinglish-MELD, the first multimodal emotion recognition dataset with aligned text, audio, and visual streams containing code-switched conversational content, filling a critical gap in the literature. With an accuracy of 88.3% and an F1-score of 87.0, the suggested confidence-aware fusion technique greatly surpasses unimodal, monolingual, and non-gated multimodal baselines. These findings demonstrate T-GCMF as a successful approach for emotion recognition in linguistically heterogeneous, real-world interactive systems and emphasize the significance of confidence-driven tri-modal integration.}
}
@article{LI2026116014,
title = {FLEX: Robust client selection for dynamic federated learning environments},
journal = {Knowledge-Based Systems},
volume = {344},
pages = {116014},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116014},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126007409},
author = {Mao Li and Hao Li and Weiwei Lin and Dongdong Li and Li Zhang and James Z. Wang},
keywords = {Federated learning, Client selection, Dynamic environment, Page-Hinckley test, Multi-armed bandit},
abstract = {Federated Learning (FL) faces significant challenges in dynamic client environments where data distributions, computational capabilities, and availability continuously evolve. Existing client selection strategies suffer severe performance degradation under such non-stationarity. We propose FLEX (Federated Learning with Environment-aware Client eXploration), a novel algorithm that maintains robust performance in dynamic settings. FLEX enhances the classical EXP3 framework with three key components: (1) a Page-Hinckley test-based change detection module, (2) a time-varying adaptive threshold mechanism, and (3) a system-level restart strategy. Theoretical analysis shows FLEX achieves improved regret bounds in dynamic environments. Extensive experiments on MNIST, CIFAR-10, CIFAR-100, and SVHN demonstrate that FLEX significantly outperforms state-of-the-art methods, achieving 4.30–7.00% improvements in d-index, maintaining 94.2% performance retention across scenarios (vs. 45%–65% for baselines), and approaching oracle-level performance with an average gap of only 1.34%. FLEX also converges faster, reaching high performance within 25 rounds compared to 40–60 rounds for baselines, making it well-suited for practical FL systems in non-stationary conditions.}
}
