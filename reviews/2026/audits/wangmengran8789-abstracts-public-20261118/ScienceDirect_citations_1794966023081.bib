@article{WU2026116422,
title = {A Dynamic Multi-Source Domain Adaptive Transfer Learning Approach for Rolling Bearing Composite Fault Diagnosis Based on Proximal Policy Optimization (PPO)},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116422},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116422},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011482},
author = {Shengli Wu and Chuanjiang Zhang and Wenting Xing},
keywords = {Composite fault diagnosis, Cross-condition transfer learning, Blind deconvolution;Proximal policy optimization, Multi-source domain adaptation},
abstract = {Reliable composite fault diagnosis of rolling bearings under varying operating conditions remains challenging because of strong coupling among fault components, severe noise contamination, limited labeled samples, and pronounced cross-condition domain shifts. To address these issues, this study proposes a Proximal Policy Optimization (PPO)-driven Dynamic Multi-Source Domain Adaptive Transfer Learning framework, termed PPO-MSDATL. First, a signal enhancement module based on Teager Energy-Harmonic Product Spectrum-guided Adaptive Cyclostationary Blind Deconvolution (TE-HPS-ACYCBD) is developed to suppress noise, decouple coupled fault components, and generate more discriminative time-frequency representations through the Continuous Wavelet Transform (CWT). Second, a dynamic multi-source domain adaptation model is constructed on the basis of a Deep Adversarial Residual Network (DARNet), in which adversarial learning and Multiple Kernel Maximum Mean Discrepancy (MK-MMD) are jointly introduced to reduce inter-domain distribution discrepancies and enhance the learning of domain-invariant features. Third, a PPO agent is incorporated to adaptively optimize the loss-balancing coefficient during training, thereby enabling dynamic coordination between domain alignment and fault classification. Extensive experiments on the Paderborn University (PU) dataset show that the proposed method achieves an average accuracy of 99.23% and consistently outperforms representative baseline methods. Further experiments on the Jiangnan University (JNU), Case Western Reserve University (CWRU), and XJTU-SY datasets also verify its superior robustness and cross-dataset generalization capability. Ablation and comparative studies further confirm the effectiveness of both the ACYCBD-based signal enhancement module and the PPO-based dynamic weighting strategy. Overall, the proposed framework provides an efficient and robust solution for cross-condition composite fault diagnosis of rolling bearings.}
}
@article{PENG2026116364,
title = {Unsupervised graph poisoning via augmentation-free cluster contrast},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116364},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116364},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010907},
author = {Xingyu Peng and Ke Xu},
keywords = {Graph poisoning attack, Graph contrastive learning, Graph neural networks},
abstract = {Unsupervised graph poisoning attacks have garnered increasing attention due to their practicality in label-scarce scenarios. A dominant paradigm involves gradient-based strategies that attack graph contrastive learning objectives to disrupt representation learning. However, the reliance on data augmentation poses a fundamental challenge: the stochastic and non-differentiable nature of augmentations induces biased and high-variance gradients, resulting in suboptimal perturbations. To overcome this limitation, we propose a novel augmentation-free cluster-contrastive attack that operates directly on the original graph. By leveraging clustering-derived pseudo-labels and jointly maximizing intra-cluster inconsistency and node-prototype misalignment, our method yields faithful and potent gradient signals. Furthermore, we introduce a disjoint multi-edge perturbation strategy to update multiple structurally independent edges in parallel. This approach mitigates gradient interference and ensures uniform disruption, significantly enhancing both efficiency and effectiveness. Extensive experiments demonstrate that our method consistently outperforms existing unsupervised attack baselines across diverse graph settings, while exhibiting strong scalability and transferability.}
}
@article{SOROKIN2026116258,
title = {TreeDQN: Sample-efficient off-policy reinforcement learning for combinatorial optimization},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116258},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116258},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009846},
author = {D. Sorokin and A. Kostin and L. Savchenko and G. Gusev and A.V. Savchenko},
keywords = {Mixed Integer Linear Programs (MILP), Reinforcement learning, Tree Markov Decision Process, Bellman operator’s contraction},
abstract = {A convenient approach to optimally solving combinatorial optimization tasks is the Branch-and-Bound method. Its branching heuristic can be learned to solve a large set of similar tasks. The promising results here are achieved by the recently appeared on-policy reinforcement learning method based on the tree Markov Decision Process. To overcome its main disadvantages, namely, very large training time and unstable training, we propose TreeDQN (Tree Deep Q-Network), a sample-efficient off-policy RL method trained by optimizing the geometric mean of expected return. To theoretically support the training procedure for our method, we prove the contraction property of the Bellman operator for the tree MDP. As a result, our method requires up to 10 times less training data and performs faster than known on-policy methods on synthetic tasks. Moreover, TreeDQN significantly outperforms the state-of-the-art techniques on a challenging practical task from the ML4CO competition.}
}
@article{ZHOU2026116366,
title = {Hessian-Informed Residual Alignment for Heterogeneous Contrastive Graph Condensation},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116366},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116366},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010920},
author = {Hui Zhou and Boyang Ren and Zhongying Zhao and Maoguo Gong},
keywords = {Graph neural networks, Graph condensation, Heterogeneous graphs, Node classification},
abstract = {Graph neural networks (GNNs) have shown remarkable performance on diverse graph-structured data. However, scaling them to large-scale graphs is challenging due to high computational and memory demands, especially for heterogeneous graphs with diverse composition types and scarce labels. To address this challenge, we propose Hessian-Informed Residual Alignment for Heterogeneous Contrastive Graph Condensation (H2C-GCond), a novel heterogeneous graph condensation framework that synthesizes compact yet highly representative graphs while preserving critical structural properties for effective GNN training. The framework introduces: (1) a three-step gradient alignment strategy that dynamically prioritizes critical layers and parameters based on learning progression, (2) residual gradient refinement enhanced by Hessian-vector products to incorporate second-order optimization insights, and (3) a layer-correlated orthogonal parameter initializer combined with gradient-aligned multi-view learning to improve condensation robustness. Extensive experiments on node classification and generalization tasks demonstrate that H2C-GCond consistently outperforms state-of-the-art baselines, including GCond and HGCond, across multiple datasets. Remarkably, at a 0.5% compression rate, H2C-GCond maintains performance nearly equivalent to full-scale graph training on both DBLP and IMDB datasets while drastically reducing computational overhead.}
}
@article{WANG2026116346,
title = {STANAP: Spatiotemporal adaptive neighborhood-aware prediction with multimodal evolution},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116346},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116346},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010725},
author = {Ling Wang and Qinchun Xu and Zezhong Li},
keywords = {Spatiotemporal data, Multimodal, Context-aware neighborhood, Adaptive neighbor-awareness, Spatiotemporal forecasting},
abstract = {Effective characterization of multimodal transitions in spatio-temporal evolving process remains critical for accurate forecasting. However, existing methods face three key limitations: inadequate characterization of temporal evolving patterns across modalities, restricted learning of inter-modal transition relationships, and insufficient adaptation to temporal distribution shifts. To overcome these limitations, we propose STANAP (Spatiotemporal Adaptive Neighborhood-Aware Prediction), a novel algorithm that enhances multimodal representation through adaptive neighboring perception mechanisms. Our framework comprises four synergistic components. First, the multimodal preprocessing module executes temporal segmentation with joint feature extraction to identify phase-specific temporal patterns. Building on this, the multimodal representation module performs dynamic spatiotemporal clustering and cross-phase feature aggregation, effectively capturing evolutionary multimodality. Third, the context candidate pool module introduces an adaptive similarity metric that fuses current and subsequent modality characteristics, explicitly modeling contextual transition relationships. Finally, the adaptive neighborhood perception predictor employs a sliding historical window as neighborhood anchor, dynamically determining neighborhood radius of the context candidate pool while learning local modal transitions via temporal-adaptive weighting. This architecture systematically addresses both multimodal evolution tracking and distribution shift adaptation. Comprehensive experiments demonstrate that STANAP significantly outperforms existing methods in terms of prediction accuracy across multiple benchmarks. The results confirm our solution effectively resolves challenges in capturing multimodal evolutionary dynamics while maintaining robustness against non-stationary data distributions.}
}
@article{ZENG2026116375,
title = {Beyond shortcuts: Mitigating spurious correlations in radiological diagnosis with causal intervention},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116375},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116375},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011019},
author = {Xinyi Zeng and Jia Wang and Jian Zhang and Yi Dong and Wei Wang and Yanji Jiang and Yonggang Zhang and Haiyang Zhang},
keywords = {Radiological image classification, Causal inference, Causal intervention, Explainable medical AI},
abstract = {While deep learning models show promise in radiological diagnosis, their clinical utility is limited by a lack of robustness and fairness. This challenge may arise in part from their tendency to exploit shortcut cues associated with sensitive patient attributes (e.g., scanner type, demographics), rather than focusing on true pathological evidence. Existing debiasing methods are often ill-suited for complex radiological images, risking information loss, or can only mitigate a single attribute at a time. In this paper, we propose a two-stage causal intervention framework to mitigate confounding biases in radiological classification at both the image and latent-space levels. First, during training, a Patchwise Counterfactual Debiasing (PCD) module systematically disrupts visual cues associated with sensitive attributes, forcing the model to learn pathology-invariant features. Second, at inference, a Lightweight Latent Subspace Correction (LSC) module prunes residual feature dimensions correlated with confounders, suppressing spurious correlations. By jointly optimising these stages, the framework isolates genuine pathological signals, improving fairness without sacrificing accuracy. Extensive experiments conducted on two public radiology datasets show that our framework consistently outperforms state-of-the-art debiasing methods, achieving significantly improved fairness and robustness.}
}
@article{ZHANG2026116427,
title = {Adapt-then-fuse: Instance feature adaptation for multi-modal test-time adaptation},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116427},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116427},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011536},
author = {Boyuan Zhang and Jie Pan and Shuai Yang and Lichuan Gu},
keywords = {Test-time adaptation, Multi-modal, Transfer learning},
abstract = {Multi-modal test-time adaptation (MM-TTA) tackles distribution shifts in multi-modal data by adapting models with only unlabeled target samples, without accessing source data. Most existing MM-TTA methods rely on attention-based fusion to re-balance cross-modal contributions, which works well when at least one modality remains relatively clean. However, under simultaneous shifts across modalities, no reliable anchor exists and attention scores tend to lose discriminative power, yielding brittle fusion and degraded representations. To address this challenge, we propose Adapt-Then-Fuse (ATF), a new MM-TTA framework that performs instance-level adaptation prior to multi-modal integration. ATF comprises two components: Instance-Aware Mixture-of-Experts Adapter (IAMA) and Stratified Entropy Modulation (SEM). IAMA equips each modality with a pool of lightweight expert adapters and uses a context-conditioned router to compute per-instance mixing weights, enabling flexible token modulation that can accommodate diverse shift patterns. After per-modality modulation, the refined representations are fused to produce predictions. SEM further stabilizes adaptation by partitioning test instances into reliability strata and applying stratum-specific entropy objectives, reducing the adverse effects of overconfidence and noisy pseudo-signals during optimization. Extensive experiments on challenging multi-modal corruption benchmarks verify the effectiveness of ATF, delivering consistent improvements over prior methods, with gains of 3.4% and 2.0% on VGGSound-MC and Kinetics50-MC, respectively.}
}
@article{YAN2026116362,
title = {WR-MDGCN: Wavelet residual and multi-scale dynamic graph convolution network for traffic flow prediction},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116362},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116362},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010889},
author = {Jianqiang Yan and Beibei Dong and Boting Qu and Yuan Gao},
keywords = {Traffic flow prediction, Wavelet transform, Residual decomposition, Multi-scale dynamic graph convolution, Recurrent neural network, Periodic signals, Anomalous signals},
abstract = {Traffic flow prediction is a critical task in Intelligent Transportation Systems (ITS). However, traffic data usually contain both periodic patterns and anomalous fluctuations, which exhibit distinct spatiotemporal characteristics and are difficult to model effectively within a unified framework. To address this issue, this paper proposes a Wavelet Residual and Multi-Scale Dynamic Graph Convolution Network (WR-MDGCN), which explicitly differentiates periodic and anomalous signals before spatiotemporal modeling. Specifically, the model first employs discrete wavelet transform (DWT) together with layer-wise residual refinement to separate traffic flow into periodic and anomalous components, providing a basis for signal-specific modeling. Based on this explicit differentiation, WR-MDGCN further constructs signal-specific dynamic graphs to capture time-varying spatial dependencies for the two signal types. For periodic signals, dynamic graph convolution is used to model relatively stable and recurrent spatial patterns, while for anomalous signals, hierarchical diffusion convolution is introduced to better capture abrupt local changes and their long-range propagation effects. In addition, a differentiated global information processing mechanism is designed to match the distinct characteristics of the two signal types. Specifically, a global memory mechanism is used to strengthen long-term dependencies of periodic signals, whereas a dynamic global pooling mechanism is adopted to provide adaptive feedback from the whole graph for anomalous signals. Experiments on six real-world datasets show that WR-MDGCN achieves strong and competitive performance in terms of prediction accuracy, while also exhibiting relatively stable behavior across different traffic scenarios.}
}
@article{SAFOUAN2026116354,
title = {SOM-GAT: Topological graph clustering via Self-Organizing Maps and Graph Attention Networks},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116354},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116354},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010804},
author = {Safaa Safouan and Karim {El Moutaouakil}},
keywords = {Self-organizing maps, Graph attention networks, Topology-preserving clustering, Unsupervised learning, Deep embedded clustering, Graph neural networks},
abstract = {Self-Organizing Maps (SOM) preserve topological structure through competitive learning but lack adaptive relational reasoning, while Graph Attention Networks (GAT) excel at learning feature-dependent neighborhoods yet remain sensitive to noisy graph inputs. This paper bridges these complementary strengths through SOM-GAT, a hybrid architecture that unifies topology-preserving compression with attention-driven representation learning for unsupervised clustering. The model first projects high-dimensional data onto a fixed SOM grid, generating prototypes enriched with local density and variance statistics. A sparse graph constructed from the lattice topology enables subsequent GAT layers to refine these prototypes through learnable attention weights. We theoretically prove that GAT attention can approximate the continuous positive neighborhood kernel, including the fixed SOM function, to arbitrary precision, while learning strictly more expressive data-adaptive relationships. Clustering is performed via a self-training objective on the refined embeddings. A detailed hyperparameter sensitivity analysis is performed to assess the impact of the SOM grid size, GAT learning rate, and hidden dimension on the effectiveness of the clustering algorithm and the stability of the model. Empirical evaluation across nine benchmark datasets spanning images, sensor records, text, and citation networks demonstrates that SOM-GAT achieves state-of-the-art accuracy on six datasets while maintaining competitive structural metrics. The framework exhibits 76.7% increased inter-prototype similarity with positive information gain (+0.6828 bits), converges faster than baseline GAT with smoother optimization trajectories, and retains 94.9% of clustering performance under 20% label noise. Statistical significance tests confirm substantial accuracy improvements over traditional spectral approaches and several deep graph clustering methods, while delivering structural performance comparable to leading autoencoder-based techniques. By eliminating reliance on reconstruction objectives and preserving a stable topological layout throughout training, SOM-GAT establishes a principled approach to interpretable, noise-robust graph clustering.}
}
@article{LI2026116370,
title = {PARCNet: Phase-aware residual correction network for efficient multivariate time series forecasting},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116370},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116370},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010968},
author = {Ziqiong Li and Heyu Chai and Zhangyao Song and Shengjun Liu and Xinru Liu},
keywords = {Hilbert transform, Envelope, Phase, Attention, Time series forecasting},
abstract = {In multivariate time series forecasting, incorporating oscillation-related representations has attracted increasing attention. However, most existing studies primarily emphasize amplitude-based modeling, while overlooking phase information. Under strong non-stationary disturbances, this omission may cause feature misalignment and unreliable fusion, leading to amplified error accumulation in long-horizon forecasting. To address this issue, we propose PARCNet (Phase-Aware Residual Correction Network), a framework that explicitly models envelope and phase to characterize local oscillatory states and improve long-horizon forecasting stability. Specifically, PARCNet adopts a Hilbert analytic-signal perspective to transform real-valued sequences into amplitude–phase descriptors aligned in time. A lightweight one-dimensional convolutional gating mechanism then produces time-channel adaptive weights, which drive a phase-aware residual correction to refine features in a structure-consistent manner. This design enhances representational expressiveness, corrects local oscillatory deviations, and improves the temporal consistency of cross-variable coupling. Moreover, PARCNet is implemented as a plug-and-play module that can be seamlessly integrated into existing forecasting backbones to strengthen multivariate modeling capability. Extensive experiments on twelve real-world datasets demonstrate that PARCNet consistently outperforms state-of-the-art methods, achieving higher accuracy and robustness across diverse prediction horizons and evaluation settings. The code and datasets are available at https://github.com/9527dandelion/PARCNet.}
}
@article{CHENG2026116357,
title = {DynaMind: A dynamic learned index for update-intensive workloads},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116357},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116357},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601083X},
author = {Jingxian Cheng and Yingfang Wang and Tianqing Zhu and Xu Yang and Ningning Cui and Jianxin Li},
keywords = {Dynamic learned index, Frequent update, Incremental learning, Unlearning},
abstract = {Learned indexes leverage machine learning models to approximate data distributions and predict key positions, offering better performance than traditional index structures such as B+Trees. As data in real-world applications evolve rapidly, the timely and efficient updating of learned indexes has become an increasingly important research problem, attracting growing attention in recent studies. However, under update-intensive workloads with frequent insertions and deletions, existing learned indexes cannot update the model in a timely manner. Moreover, they ignore the impact of deletions on model accuracy. These limitations lead to degraded prediction accuracy and increased query latency, undermining the core advantage of learned indexes. To fill in this gap, in this paper, we design a dynamic learned index (denoted as DynaMind) that is able to timely update the model with the frequent change of data. Specifically, we propose a novel score function to determine the appropriate timing at which a learned index should initiate an update by measuring the influence of updated data on the model accuracy. To enable efficient model updates, we devise a timely learned index update algorithm that implements both lightweight incremental learning for insertions and machine unlearning for deletions together, ensuring the model continuously evolves without full retraining. Extensive experiments on real-world and synthetic datasets show that DynaMind achieves competitive throughput compared to state-of-the-art works while improving the prediction accuracy. The proportion of keys with zero prediction error increases by more than 10% after updates.}
}
@article{K2026116318,
title = {Sentimental analysis and word pair-based parts of speech (PoS) tagging aware recommendation algorithm in business for brand-brisking},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116318},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116318},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010440},
author = {Subhashree K and Manoj Kumar S},
keywords = {Sentiment analysis, Deep learning, Word2Vec, Natural language processing, Riemannian residual neural networks},
abstract = {Sentiment analysis has become a widely explored area in data mining, especially due to the rapid growth of platforms like Twitter, where users share emotions, opinions, and attitudes. Despite the achievements made, current approaches to sentiment classification still experience difficulties in terms of contextual preservation, syntactic-semantic fusion, and domain-wise generalizability. These limitations underscore the need for a more reliable, context-aware framework that supports real-world decision-making and business intelligence applications. To address these challenges, this work proposes a hybrid sentiment classification architecture that integrates a combined Word2Vec and Term Frequency–Inverse Document Frequency (TF-IDF) feature extraction scheme to effectively capture syntactic-semantic cues. The extracted features are further processed using an End-to-End Deep Riemannian Residual Neural Network (EEDRRNN), which leverages Riemannian manifolds to convert the high-dimensional feature spaces representing the text into curved, smooth surfaces. A Linear Constrained Optimization Method (LCOM) is incorporated to optimize network parameters and reduce computational complexity. Additionally, a Word Pair-based Part-of-Speech Tagging (WPPOST) recommendation module identifies syntactically related word pairs to enhance sentiment-aware suggestions. Experimental validation on four benchmark datasets, RES14, LAP14, RES15, and RES16, demonstrates the model’s superiority, achieving accuracy scores of 93.19%, 89.72%, 91.78%, and 95.76%, with corresponding F-measure values of 85.45%, 81.31%, 84.37%, and 88.43%. The framework also achieves an 11–15% reduction in execution time compared with recent state-of-the-art models. Statistical tests and ablation studies confirm the significance of each component and the robustness of the proposed framework for practical sentiment-driven applications.}
}
@article{ROHINI2026116407,
title = {RePa-ViT: A Reparameterized Vision Transformer framework for insider threat detection with grayscale and color image analysis},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116407},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116407},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011330},
author = {Valaparla Rohini and R Mohan},
keywords = {Insider threat detection, Cyber security, Reparameterized vision transformer, Grayscale and color modalities, Behavioral image representation},
abstract = {Insider threat is one of the persistent and damaging cybersecurity problem for organizations. It comes from trusted users, and their malicious or negligent actions are often similar to those of normal users. The detection of such threats is challenging, as existing monitoring systems do not effectively identify small abnormal deviations across large datasets of user activity. Previous machine learning (ML) and deep learning (DL) methods have made substantial contributions. However, raw numerical features fail to capture complex temporal and behavioral patterns. Transforming these user activities into image-based representations allows spatial and temporal dependencies to be encoded more effectively, enabling the model to learn subtle deviations in behavior. Nevertheless, relying on a single form of representation may still overlook important behavioral cues, which can lead to poor generalization, overfitting, and high false positive rates. To overcome these issues, we introduce a Reparameterized Vision Transformer (Repa-ViT) framework that processes two complementary image modalities: grayscale transformed features and color-imaged spatio-temporal representations of user behavior. Within this framework, the grayscale images signify the daily intensity of user activities taken from the numerical features, and the color images depict the inter-feature relationships of the same day by assigning different behavioral categories to RGB channels. The CERTr4.2 publicly available dataset is used for the evaluation. The experimental results confirm the effectiveness of both modalities, with grayscale and color representations achieving 99.98% and 99.99% accuracy, respectively. Although findings demonstrate that both modalities are capable of effectively capturing behavioral patterns, they also validate their significance for insider threat detection.}
}
@article{CHAI2026116379,
title = {Multi-Scale and multi-level feature enhanced meta-learning for few-shot fault diagnosis},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116379},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116379},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011056},
author = {Jingxuan Chai and Jie Cao and Xiaoqiang Zhao and Jinghua Wang},
keywords = {Fault diagnosis, Few-shot learning, Meta-learning, Deformable convolution, Attention mechanism},
abstract = {In practical industrial environments, intelligent fault diagnosis is often challenged by the scarcity of labeled fault samples, severe noise contamination, and frequent variations in operating-condition distributions. Deep learning approaches that rely heavily on large-scale labeled datasets tend to suffer from limited generalization capability, leading to overfitting and significant performance degradation under cross-condition scenarios. To address these issues, this paper proposes a dual-branch meta-learning fault diagnosis framework with multi-scale and multi-level feature enhancement. By jointly modeling time-frequency representations and raw temporal vibration signals, the proposed framework introduces complementary structural inductive biases that enable rapid adaptation to unseen operating conditions and novel fault categories. In the time-frequency branch, high-resolution time-frequency representations are generated using the continuous wavelet transform (CWT). A soft-thresholding denoising strategy is embedded in the wavelet domain to perform adaptive noise suppression on multi-scale sub-bands. In addition, a wavelet packet-inspired multi-scale convolution architecture is designed to explicitly enlarge the receptive field, thereby enhancing the extraction of impulsive transient signatures and fine-grained texture patterns. In the temporal branch, an improved residual dilated temporal convolutional network (TCN) is introduced to directly model the temporal dependency structures of raw vibration signals, which strengthens weak fault features and improves noise robustness. To further enhance task adaptability, a meta-aware deformable convolution module is developed to achieve dynamic feature alignment conditioned on task context. Meanwhile, a lightweight Swin-Tiny Fusion structure combined with a multi-scale channel attention mechanism is introduced to perform hierarchical cross-modal feature fusion. Within the prototypical network framework, a scaled cosine similarity metric with an adaptive threshold regulation strategy is adopted to construct a smoother and more discriminative embedding space for robust few-shot classification. Extensive experiments conducted on the Paderborn bearing dataset and the LUT-WFD wind turbine fault dataset demonstrate that the proposed method achieves superior diagnostic accuracy under few-shot learning, strong noise interference, and cross-condition transfer scenarios, while exhibiting improved training stability and generalization consistency. The proposed framework provides a knowledge-guided and transferable solution for intelligent fault diagnosis in data-scarce industrial environments.}
}
@article{RAHAYU2026116398,
title = {MSTGNet: Multi-scale temporal graph network for video-level deception detection from multimodal behavioral landmarks},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116398},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116398},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601124X},
author = {Yeni Dwi Rahayu and Chastine Fatichah and Anny Yuniarti and Yusti Probowati Rahayu and Mathias Adya Diwangkara Suganda},
keywords = {Deception detection, Multi-scale temporal modeling, Temporal graph networks, Model-level saliency, Video-level evaluation},
abstract = {Deception detection from behavioral landmark trajectories remains challenging because behavioral cues unfold across different temporal scales and may vary across cultural and interview contexts. We propose MSTGNet, a multi-scale temporal graph network that represents each modality as a learned temporal graph within 50-frame windows and applies local-to‑meso multi-scale convolution to capture short behavioral variations. Video-level predictions are obtained by deterministic averaging of overlapping window outputs rather than by explicit long-context modeling. Evaluated under leakage-aware video-level stratified cross-validation with validation-only threshold selection using Youden's J statistic on an Indonesian dataset (I3D: 1568 videos) and a Western-context dataset (RLT: 121 videos), MSTGNet achieved 78.2% accuracy (AUC 0.835, MCC 0.566) on I3D and the highest threshold-free performance on RLT (AUC 0.799). Multi-seed Wilcoxon tests showed that the AUC improvement over a comparable-capacity Transformer baseline remained significant on both datasets after Holm–Bonferroni correction (p < 0.001). Gradient attribution produced model-level saliency patterns consistent with modality ablation results, but these patterns should not be interpreted as causal behavioral evidence. Cross-dataset transfer remained limited, suggesting domain shift beyond threshold miscalibration. The I3D dataset is publicly released to support reproducible cross-cultural research in video-based deception detection.}
}
@article{YANG2026116358,
title = {Evidence-chain-driven multimodal retrieval question answering},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116358},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116358},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010841},
author = {Shuwen Yang and Anran Wu and Xingjiao Wu and Jiabao Zhao and Linlin Wang and Liang He},
keywords = {Visual question answering, Deep learning, Transformer, Contrastive learning, Multimodal retrieval question answering},
abstract = {Multimodal retrieval question answering is a critical task in Artificial General Intelligence. Existing methods typically retrieve key evidence by measuring semantic similarity between questions and retrieval information. However, they often fail to effectively distinguish between direct and indirect evidence in retrieving information, resulting in the oversight of some indirect evidence. Furthermore, current methods overlook the logical relationships between evidence, thus hindering the formation of complete evidence chains and impacting the accuracy of answer inference. To address this, we propose an Evidence-Chain-Driven Retrieval Question Answering Framework to effectively differentiate between direct and indirect evidence and form complete evidence chains through logical associations. Our framework consists of three modules. The question-evidence matching module identifies direct evidence from candidates and filters out irrelevant ones using a dual-encoder structure. It enhances discrimination against irrelevant evidence through semi-supervised contrastive learning. The indirect evidence retrieval module is utilized to further retrieve indirect evidence based on the question and the retrieved direct evidence. This module adopts a multi-layer transformer structure, with its core focusing on leveraging cross-attention mechanisms to effectively capture contextual relationships among the question, direct evidence, and indirect evidence. The logical correlation module is responsible for synthesizing the retrieved evidence into a coherent chain, which is then used to infer the final answer. We validated our proposed approach on two publicly available datasets, and the results demonstrate that our method outperforms existing approaches, achieving state-of-the-art (SOTA) performance. Extensive comparisons with contemporary LLM-based RAG baselines further show that our lightweight retrieval achieves superior precision and efficiency over LLM-guided evidence selection. Additionally, we conducted a series of ablation experiments to further validate the significance of the proposed method.}
}
@article{LIU2026116383,
title = {CyBond Net: Rethinking message passing mechanism via graph edge space},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116383},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116383},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011093},
author = {Sihao Liu and Zhiheng Zhou and Weihua He and Guiying Yan},
keywords = {Graph representation learning, Graph-level tasks, Algebraic graph theory, Edge space, Long-range interactions},
abstract = {Graph Neural Networks (GNNs) have proven highly effective across a wide range of graph-based tasks. However, traditional message-passing GNNs mainly capture local information within a k-hop neighborhood, which limits their performance on graph-level tasks that require long-range interactions. From the perspective of algebraic graph theory, message-passing GNNs aggregate information through edge cuts and therefore operate only within the bond space of a graph. The edge space of a graph decomposes into two orthogonal components: the bond space and the cycle space. To achieve a more comprehensive graph representation, it is crucial to capture information from both spaces. While the bond space relates to local interactions, the cycle space encodes features associated with long-range dependencies. Building on this insight, we propose a novel GNN architecture, CyBond Net, that integrates bond-space and cycle-space information to form a more complete representation of the graph. CyBond Net achieves strong results on both graph classification and regression, effectively capturing global graph structure. It attains 0.080 MAE on ZINC and outperforms strong baselines on multiple TUDatasets. Its capacity for modeling long-range interactions is further validated on LRGB, achieving state-of-the-art performance on Peptides-Functional (0.6588 AP) and Peptides-Structural (0.2511 MAE).}
}
@article{MENG2026116399,
title = {DATR: Depth-aware transformer for hierarchical and fine-grained scene graph generation},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116399},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116399},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011251},
author = {Qinghao Meng and Xu Zhang and Jiaxin Yang and Yuwen Fu and Xuehu Duan and Shuohao Li and Jun Lei and Jun Zhang},
keywords = {Scene graph generation, Visual relationship detection, Multimodal fusion, Transformer, Hierarchical relations},
abstract = {Scene Graph Generation is a fundamental task for structured visual understanding, yet existing methods suffer from relation omission or confusion caused by intra-class inconsistency of relations and target occlusion. While recent approaches introduce auxiliary modalities such as word embeddings and knowledge graphs, their static nature restricts adaptability to dynamic relational variations. To address the above issues, we propose DATR, a depth-aware one-stage transformer architecture that leverages geometric hierarchies for fine-grained relation reasoning. DATR comprises three modules: a Cross-Modal Feature Adapter for adaptive RGB-depth fusion to reduce modality heterogeneity; a Bi-modal Guided Encoder that enhances entity discrimination with depth spatial priors; and a Gated-Aware Relation Extraction module that conducts relation classification via adaptive modality weighting. To enable comprehensive evaluation across relation classes, we propose a supercategory-level metric called S-mR@K. Experiments on the Visual Genome and Open image V6 datasets demonstrate the effectiveness of the proposed framework, highlighting the depth map as an effective geometric prior for SGG.}
}
@article{XUE2026116423,
title = {Adversarial aerial multi-threat assessment: A reinforcement learning approach with dynamic feature fusion and expert reward shaping},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116423},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116423},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011494},
author = {Dingrui Xue and Yuqing Lin and Jiancheng Liu and Wanlong Qi and Ke Li and Bo Li and Kang Sun and Zhipeng Zhang and Xiaolong Su and Kai Xu and Kexin Wang},
keywords = {Aerial threat assessment, Dynamic cross-network, Inverse reinforcement learning, Reinforcement learning, Combat simulation},
abstract = {Aerial threat assessment (ATA) remains a critical component in modern military operations, particularly within highly dynamic and uncertain combat environments. Traditional methodologies struggle to effectively handle multi-target threats, real-time decision cycles, and the inherent uncertainties present in such settings. To address these limitations, this paper introduces the Dynamic Cross-Attention and Adaptive Entropy Shaped Threat assessment (DCA-AEST) framework, which combines two novel components: Dynamic Cross-Attention Feature Extraction (DCAFE) and Adaptive Entropy Shaped Threat assessment (AEST). DCAFE utilizes hierarchical cross-attention mechanisms to dynamically extract high-order feature interactions from complex, multi-source battlefield observations, enhancing the accuracy of threat detection and prioritization. Meanwhile, AEST integrates reinforcement learning with expert-guided reward shaping and entropy regularization, allowing the model to adaptively optimize its threat evaluation strategy during training while supporting real-time threat evaluation at deployment. The proposed DCA-AEST framework is rigorously validated through extensive experiments in a high-fidelity simulator. The results demonstrate its superior performance in comparison to representative baselines, showcasing significant improvements in adaptability, decision-making stability, and ATA accuracy in dynamic, uncertain combat scenarios. Our code used in this study are publicly available at: https://github.com/DaXiaXue/env.git.}
}
@article{LI2026116391,
title = {Explainable attributed graph clustering via Multi-Agent Opinion Game},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116391},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116391},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011172},
author = {Hui-Jia Li and Jiajun Gao and Yao Zhang and Qiqi Wang and Huanhuan Chen},
keywords = {Attributed graph clustering, Multi-Agent Opinion Game, Distributed system, Pareto optimality, Explainability},
abstract = {Efficient attribute graph clustering is among the most important and challenging research topics, and it has attracted a lot of attention from many research fields. However, several key issues remain insufficiently addressed, particularly how to explain the intrinsic opinion dynamics underlying cluster formation. Moreover, existing methods often fail to reconcile clustering effectiveness with computational complexity on massive attributed graphs. In this paper, to overcome these limitations, we introduce an explainable and robust attributed graph clustering algorithm by incorporating cluster formation interpretation together with multi-source information fusion. Firstly, we introduce a generalized Multi-Agent Opinion Game model to model and explain the dynamic formation of opinion clusters, which consider the real networks as a discrete-time physical system. We demonstrate that local Pareto optimality can be obtained by addressing a finite set of generalized ordinal potential games, after carefully specifying the feasible strategy set and the utility function for each node. Then, by selecting suitable belief functions, we propose an explainable graph clustering algorithm based on Multi-Agent Opinion Game (MAOG) which include three interdependent components: (1) a robust opinion dynamics model that predicts each user’s “stable” opinion vector, (2) initialization of cluster formation and (3) a dynamic game model that simulates realistic group formation to reach a local Pareto-optimal solution. The proposed MAOG algorithm is very efficient. In sparse networks, MAOG has computational complexity that is close to linear with network scale, making it faster than most existing attributed graph clustering algorithms. The experimental results on multiple datasets verify that it achieves superior performance, making it very suitable for clustering on massive attributed networks.}
}
@article{NAHI2026116365,
title = {Contrastive graph clustering with a topology-sensitive noise augmentation framework},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116365},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116365},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010919},
author = {Mohammad Saeb Nahi and M.A. Balafar and Jafar Tanha and Nazila Pourhaji Aghayengejeh},
keywords = {Graph clustering, Contrastive learning, Topology-aware Hybrid Noise Augmentation, Contrastive Learning with Topology-aware Noise},
abstract = {Contrastive deep graph clustering has become as a prominent research direction owing to its self-supervised learning paradigm and superior clustering results. However, most existing contrastive learning approaches rely on global Gaussian noise to generate perturbations, yet such noise is inherently insensitive to node-level structural context. Consequently, the resulting negative samples are often semantically irrelevant and structurally inconsistent. Moreover, the filtering mechanisms employed to extract node characteristics overlook fine-grained topological properties, such as heterophilic relationships and boundary structures. This lack of structural awareness ultimately leads to distorted representations that fail to preserve cluster boundaries. To address these issues, this paper proposes a novel Contrastive Graph Clustering with a Topology-sensitive Noise Augmentation Framework (CGC-TNAF) that consists of two main modules: Topology-aware Hybrid Noise Augmentation (THNA) and Contrastive Learning with Topology-aware Noise (CLTN). The THNA module combines graph components corresponding to high and low frequencies to model global similarities and fine-grained node distinctions, while introducing Gaussian noise that considers the topology as useful perturbation to enhance the representation diversity. The CLTN module introduces a novel mechanism for generating exclusive, negative samples guided by noise, enabling the construction of triplet contrastive pairs (Target, Positive, Negative) based on topology. This design effectively reduces contrastive bias, eliminates false negatives, and achieves more precise semantic alignment within the embedding space. Comprehensive experiments conducted on six widely used datasets, namely Citeseer, Cora, EAT, AMAP, BAT, and UAT, demonstrate that CGC-TNAF consistently achieves superior clustering performance compared to existing state-of-the-art methods. The codes are publicly available at .}
}