@article{OISHI2026116367,
title = {Physically plausible data augmentations in contrastive learning for wearable IMU-based activity recognition},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116367},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116367},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010932},
author = {Nobuyuki Oishi and Philip Birch and Paula Lago and Daniel Roggen},
keywords = {Contrastive learning, Data augmentation, Human activity recognition, Inertial measurement unit, Physics simulation},
abstract = {Wearable inertial measurement unit (IMU)-based human activity recognition (HAR) is a key enabler of mobile and pervasive computing applications. To address the scarcity of labeled data, self-supervised contrastive learning has been adopted. It leverages data augmentations to generate diverse views of sensor data, using them as positive pairs in a pretext task to learn representations from unlabeled data. However, conventional signal transformation-based data augmentations (STDAs) are poorly grounded in the realistic variability that affects IMU readings, e.g., diverse motion patterns and device positioning, often resulting in unstable downstream task performance. In this work, we investigate the effectiveness of ensuring physical plausibility in data augmentations within contrastive learning. Specifically, we compare physically plausible data augmentations (PPDAs), realized via physics simulation to incorporate domain knowledge, against legacy STDAs. Evaluated on three public datasets covering daily activities and fitness workouts (8 to 34 classes), models pretrained with PPDAs consistently outperform STDA-pretrained models and fully supervised baselines, improving the downstream classification macro-F1 score by 3 to 14 percentage points. Qualitative analyses reveal that PPDAs shape the learned representation space into a more physically grounded topology. Furthermore, PPDAs achieve fully supervised-level performance with less than 10% of labeled data. We also demonstrate the robustness of physically grounded augmentations, showing they remain effective with lower-fidelity simulation data and generalize across different encoder architectures and contrastive learning frameworks. These findings suggest that incorporating physical domain knowledge to ensure physical plausibility enables the generation of semantically consistent positive pairs, helping models learn representations more relevant to HAR.}
}
@article{WYSOCKI2026116331,
title = {Sizing the risk: Kelly, VIX, and hybrid approaches in put-writing on index options},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116331},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116331},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010579},
author = {Maciej Wysocki},
keywords = {S&P 500 index options, Implied volatility, Dynamic sizing, VIX, Short put, Kelly criterion},
abstract = {This paper examines systematic put-writing strategies applied to S&P 500 Index options, with a focus on position sizing as a key determinant of long-term performance. Despite the welldocumented volatility risk premium, where implied volatility generally exceeds realized volatility, the practical implementation of short-dated volatility-selling strategies remains underdeveloped in the literature. To address the non-linear, fat-tailed risks inherent in put-writing, this study introduces a novel algorithmic framework for dynamic position sizing — a hybrid architecture that integrates Monte Carlo-derived Kelly sizing with real-time VIX-regime scaling. Using at-the-money and out-of-the-money SPXW options with expirations ranging from 0 to 5 days, the analysis explores a broad design space, including moneyness levels, volatility estimators, and memory horizons. The results demonstrate that ultra-short-dated, far out-of-the-money options deliver superior risk-adjusted returns. The hybrid sizing method consistently balances return generation with robust drawdown control, particularly during low-volatility periods such as those observed in 2024. Ultimately, this research offers new insights into volatility harvesting through a novel adaptive sizing approach that responds to shifting market regimes. It provides practical guidance on constructing short-dated option strategies that can withstand diverse market environments. These findings have direct applications for institutional investors seeking to enhance portfolio efficiency through systematic exposure to volatility premia.}
}
@article{KHAN2026116232,
title = {Enhancing thermal attack resilience in Multi-Processor System-on-Chip through synthetic data generation using LLMs},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116232},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116232},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009585},
author = {Md Rahat Kader Khan and Samiul Islam Niloy and Mahdi Hasanzadeh and Ahmad Patooghy and Kasem Khalil},
keywords = {MPSoC, Reliability, Fault detection, Machine learning, Edge devices, Large Language Models (LLMs), Synthetic data},
abstract = {The security of Multi-Processor System-on-Chip (MPSoC) architectures has become a critical concern due to their widespread integration into modern computing systems. However, the lack of quality data capturing the behavior of these systems under attack scenarios hinders the development of effective countermeasures. In this study, we propose a framework that facilitates the collection and enrichment of thermal datasets using machine learning for MPSoC security analysis against two distinct thermal attack patterns. To address the limitations associated with imbalanced data, the proposed framework leverages Large Language Models (LLMs) to generate synthetic data, incorporating a feedback-driven optimization mechanism to enhance data quality and alignment with real-world distributions, we developed a prompt-based LLM pipeline for schema-conformant tabular synthesis and evaluate its downstream utility by training standard off-the-shelf ML models on the generated tables. The framework employs a novel prompting method to ensure compatibility across various LLMs, thereby optimizing the synthetic data generation process. Experimental evaluations provide empirical evidence substantiating the framework’s efficiency in generating and enriching synthetic data for training machine learning models. The experimental evaluation reveals that the Light Gradient Boosting Machine algorithm achieved the best performance among all tested models, attaining an accuracy of 93% and an F1-score of 92.80% when trained only on synthetic data and evaluated on real data. The findings highlight its potential as a powerful tool for strengthening MPSoC security by improving the robustness and adaptability of machine learning-based security mechanisms.}
}
@article{HU2026116380,
title = {Causal-Guided Disentanglement for debiasing Recommendation via counterfactual reasoning},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116380},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116380},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011068},
author = {Jiaxin Hu and Tao Wang and Fei Wang and Hongrun Wang and Jingshuai Cao},
keywords = {Recommender systems, Causal inference, Representation disentanglement, Counterfactual reasoning, Debiasing},
abstract = {Modern recommender systems have achieved remarkable success in capturing user interests. However, their heavy reliance on correlations within observational data renders them susceptible to confounding biases, such as item popularity and exposure effects. These biases cause the model to learn spurious correlations between user behaviors and item attributes, thereby compromising fairness, novelty, and the ability to generalize to users’ true preferences. To address this fundamental challenge, we propose a novel debiasing framework, Causal-Guided Disentanglement for debiasing Recommendation (CGDR), which causally separates latent preference factors from confounding effects at the representation level. We first construct a Structural Causal Model (SCM) to explicitly delineate the generative process of user–item interactions, postulating that a user’s action is determined by both their intrinsic preference and a set of confounding factors. Guided by this causal graph, our framework employs a novel Causal-Guided mechanism that leverages auxiliary supervisory tasks to provide the disentanglement process with a clear causal direction. This decomposes the latent representation into two independent components: one capturing robust, transferable true preferences, and the other explicitly modeling dynamic confounding effects. Upon achieving this disentanglement, we generate debiased recommendations via Counterfactual Reasoning, performing interventions on the confounder representation to simulate a bias-free environment while leveraging the preference representation for prediction. We demonstrate our framework using item popularity bias as a canonical and challenging example, and this framework is generalizable to other quantifiable confounders. Extensive experiments on multiple real-world datasets demonstrate that our proposed model not only significantly outperforms state-of-the-art baselines in recommendation accuracy, particularly in enhancing long-tail item performance, but also exhibits superior robustness and interpretability.}
}
@article{ZHAO2026116432,
title = {FedBRDO: A bias-aware and representation-decoupled dynamic optimization framework for federated long-tailed learning},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116432},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116432},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011585},
author = {Lujin Zhao and Yunlong Zhao and Pengfei Gong and Wenmin Li and Yijie Shi and Zhengping Jin and Sujuan Qin},
keywords = {Federated learning, Long-tailed learning, Representation decoupling, Sharpness-aware minimization, Dynamic client selection},
abstract = {Federated long-tailed learning (Fed-LT) remains challenging because real-world client data are typically non-independent and non-identically distributed (non-IID), while the global class distribution is severely long-tailed. Their interaction biases optimization toward dominant head classes, aggravates client drift, and ultimately degrades minority-class generalization. Existing methods, including representation alignment, synthetic data generation, and classifier calibration, provide partial remedies, but often rely on impractical assumptions such as global distribution priors, centralized calibration, public auxiliary data, or static objectives that fail to adapt to dynamic shifts. To address these limitations, we propose FedBRDO, a bias-aware and representation-decoupled dynamic optimization framework for Fed-LT that jointly tackles statistical heterogeneity and global class imbalance without requiring distribution priors. On the client side, FedBRDO introduces the bias-aware representation alignment (BARA) module to disentangle shared representations from client-specific biases, and the dynamic tail enhancement sharpness-aware minimization (DTESAM) module to enhance minority-class generalization through head-tail decoupled optimization. On the server side, the layered selection optimization (LSO) and adaptive weight redistribution (AWR) modules implement a loss-aware dynamic aggregation strategy that prioritizes underperforming clients and stabilizes convergence. In addition, a differential privacy (DP) mechanism based on Gaussian perturbation is incorporated to protect client privacy. Extensive experiments on multiple benchmarks show that FedBRDO consistently outperforms state-of-the-art methods under heterogeneous and imbalanced federated settings.}
}
@article{PI2026116311,
title = {Stealing supervised fine tuning samples: A data extraction attack driven by token modulation and loss ratio},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116311},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116311},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010373},
author = {Jiawei Pi and Senlin Luo and Limin Pan and Chengke Xu and Ji Zhang},
keywords = {Data extraction attack, Privacy, LLMs security},
abstract = {Extraction attacks aim to steal Supervised Fine-Tuning (SFT) samples from fine-tuned Large Language Models (LLMs), posing severe threats to commercial assets and user privacy. Mainstream attack methods typically induce fine-tuned LLMs to generate candidate samples and then select one as the extracted sample. However, existing approaches struggle with two primary challenges. First, generated candidates often suffer from structural and stylistic deviations. Because fine-tuned models retain strong pre-training priors, their outputs tend to drift toward general corpora rather than the exact SFT format. Second, extracting the correct sample is hindered by semantic overlap. Current methods rely on semantic similarity for screening, which evaluates semantic equivalence rather than exact data memorization, leading to high mis-selection rates. To address these issues, a Token Modulation and Cross-Model Loss Ratio-Guided SFT Sample Extraction Attack method named TCEA is proposed. To overcome structural drift, TCEA employs a contrastive text generation module. By superimposing the logits difference between the fine-tuned and pre-trained models during decoding, this method dynamically modulates token probabilities to amplify SFT-specific features. Furthermore, to ensure accurate sample selection, TCEA evaluates the cross-model conditional loss ratio. This explicitly quantifies the fitting discrepancy between models, verifying verbatim text memorization rather than mere semantic similarity. Experimental results demonstrate that TCEA surpasses existing state-of-the-art methods across multi-domain datasets. Ultimately, by effectively quantifying cross-model fitting discrepancies, TCEA achieves high- accuracy extraction of SFT samples, demonstrating the genuine severity of this privacy threat.}
}
@article{LI2026116363,
title = {TDiscNet: Topological discrepancy-guided adaptive semantic modeling for dynamic text-attributed graphs},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116363},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116363},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010890},
author = {Hao Li and Liang Du and Yixue Huang and Hao Jiang},
keywords = {Dynamic text-attributed graphs, Dynamic link prediction, Persistent homology, Multi-modal representation learning},
abstract = {Dynamic text-attributed graphs (DTAGs) contain time-stamped interactions with evolving textual information. Existing DTAG models, including recent LLM-based approaches, typically perform semantic modeling at uniformly sampled timestamps, despite the fact that semantic changes and structural evolution are often asynchronous. This leads to redundant semantic computation at uninformative times and missed moments of significant semantic shift. We propose TDiscNet, a topology-guided framework that adaptively decides when to perform semantic modeling by measuring the mismatch between semantic and structural evolution. TDiscNet constructs direction-aware semantic graphs from historical texts, computes persistence diagrams under a shared time-based filtration, and defines a Topological Discrepancy Score via the Wasserstein distance between diagrams. The resulting score serves as a criterion for node-wise timestamp sampling, assigning higher priority to timestamps with stronger semantic-structural discrepancy. Experiments on multiple real world DTAG benchmarks demonstrate that TDiscNet improves temporal link prediction while performing semantic modeling on a smaller subset of sampled timestamps, thereby reducing semantic computation compared with uniform schedules.}
}
@article{LU2026116416,
title = {DIVCOM: Adaptive graph division for scalable detection of overlapping communities},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116416},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116416},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011421},
author = {Yun Lu and Wenyu Chen and Peng He and Yanglei Gan and Peiyuan Jiang and Yao Liu and Qiao Liu},
keywords = {Community detection, Overlapping communities, Graph partitioning, Scalable algorithms, Parallel processing},
abstract = {Detecting overlapping communities in large-scale networks presents a fundamental trilemma, which requires simultaneously balancing accuracy, scalability, and practicality. However, existing approaches are not effective: modularity-based methods inherently cannot detect overlaps, embedding-based approaches demand extensive hyperparameter tuning, and divide-and-conquer strategies often fragment communities by severing crossboundary edges. We introduce DIVCOM, an adaptive graph division framework that differentiates overlapping community detection into three phases: (i) adaptive partitioning that preserves community boundaries, (ii) parallel disjoint detection within cohesive subgraphs, and (iii) global optimization that transforms local results into a consistent overlapping structure. Extensive experiments on eight real-world networks (3.6 K to 4.0 M nodes) demonstrate that DIVCOM—with average gains of +12.6% in thye F1-score and +18.3% in the Jaccard index—exhibits significant improvements over state-of-the-art unsupervised baselines. On the massive LiveJournal3 network (4 M nodes; 664 K communities), DIVCOM exhibits the highest accuracy while running 107-fold faster than SLPA and 1.5-fold faster than NcGame. Furthermore, DIVCOM outperforms four representative semisupervised methods (Bespoke, SEAL, CLARE,and ProCom) by an average relative improvement of 3.9% in the F1 score on medium-scale datasets, despite using no labeled data. All key parameters of DIVCOM are automatically configured from graph properties, eliminating per-dataset manual tuning.}
}
@article{WAN2026116343,
title = {FSPA-Net: Frequency–structural prior guided dual-stream dynamic fusion for remote sensing scene classification},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116343},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116343},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010695},
author = {Yifeng Wan and Zhicheng Xiong},
keywords = {Spatial-frequency dual-stream, Cross-modal attention, Frequency-driven dynamic fusion, Attention mechanism, Remote sensing scene classification},
abstract = {Remote sensing scene classification benefits from powerful spatial feature extractors, yet current methods often overlook the synergistic coupling of structural topology and frequency-domain characteristics, leading to the loss of fine-grained geometric details in complex multi-scale contexts. This paper presents FSPA-Net, a dual-stream architecture that synergistically exploits frequency and structural priors through dynamic cross-modal fusion. A lightweight frequency stream processes joint magnitude and phase spectra to yield discriminative spectral representations, which are progressively injected into the spatial backbone via multi-level cross-attention. We propose a Frequency-Aware Dynamic MLP Fusion (FDMF) module that conditionally generates scale-specific projection matrices and gating weights from compressed global frequency context, enabling content-adaptive feature recalibration. A novel Frequency–Structural Prior Attention (FSPA) mechanism is further introduced, explicitly incorporating Sobel-derived edge priors and high-frequency components to enhance spatially discriminative regions. Extensive experiments on the UC Merced Land Use, WHU-RS19, and NWPU-RESISC45 benchmarks demonstrate state-of-the-art performance, achieving 92.85% accuracy on NWPU-RESISC45 with only a 10% training ratio. Ablation studies and visualizations validate the contribution of each prior-guided component and the interpretability of the learned representations.}
}
@article{LI2026116420,
title = {Fine-grained visual classification network with background suppression and key feature enhancement},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116420},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116420},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011469},
author = {Xi Li and Wei Liu and Yi Xi Ding},
keywords = {Fine-grained visual classification, Improved global covariance pooling, Background activation suppression},
abstract = {Fine-grained visual classification (FGVC) tasks face the dual difficulties of a small spatial scale of discriminative regions and complex background interference. To cope with the diversity of samples, most existing methods utilize convolutional neural networks (CNNs) to extract features, extract and downsize the features through pooling, and then make classification predictions. However, first-order pooling (such as max pooling and average pooling) only describes a single statistical property, making it difficult to effectively extract weak and minor features that play a key role in fine-grained classification. In addition, the interference from complex backgrounds further exacerbates the difficulty for networks in extracting key features. This paper proposes a Fine-Grained Classification Network with Background Suppression and Key Feature Enhancement. First, the pooling mechanism of the cross-layer mutual attention learning network (CMAL) is improved, and an improved global covariance pooling module (IGCP) is designed. This module can more finely characterize the correlation between channels and construct high-order features, thereby preserving key features. Second, a background activation suppression module (BASM) is designed to address the interference caused by complex backgrounds. Placed at the front end of the backbone network, it provides refined images with background removed as input, enabling the backbone network to focus on target regions and thus achieve better classification performance. Experimental results on datasets like CUB-200-2011, FGVC-Aircraft, Stanford Cars and Flowers 102 demonstrate that the proposed method significantly enhances classification accuracy over existing methods, underscoring its ability to extract fine-grained features more effectively.}
}
@article{TANG2026116359,
title = {FedSGK: Data-free subgraph federated distillation with a public embedding proxy for triple heterogeneity},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116359},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116359},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010853},
author = {Min Tang and Rishu Li and Guoqiang Deng},
keywords = {Graph neural networks, Federated learning, Knowledge distillation, Model heterogeneity},
abstract = {Graph neural networks are increasingly applied in distributed environments, driving the development of subgraph federated learning. Existing methods often rely on global parameter aggregation, which struggles with highly non-IID client subgraphs. They also ignore differences in model architectures and device capabilities, reducing global model performance and increasing communication overhead. To address these challenges, we propose FedSGK, a novel data-free subgraph federated distillation framework that simultaneously handles the triple heterogeneity in data, models, and systems. Unlike traditional federated distillation methods that require public datasets or expensive generators, FedSGK builds a globally representative embedding proxy in a latent space to enable knowledge transfer. We further introduce a personalized distillation mechanism to retain client-specific features and an unreliable knowledge filtering module to improve teacher knowledge quality. Extensive experiments on multiple datasets show that FedSGK effectively handles triple heterogeneity while achieving superior performance and communication efficiency compared to existing methods.}
}
@article{GAO2026116440,
title = {SA-FTM: A structure-aware feature tuning framework for enhancing targeted adversarial transferability},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116440},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116440},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011664},
author = {Yufei Gao and Shuai Li and Yucheng Shi and Yan Cao and Lei Shi and Mengyang He},
keywords = {Deep neural networks, Black-box attacks, Targeted adversarial attacks, Transferability},
abstract = {Targeted transfer-based adversarial attacks aim to induce a specific misclassification in black-box models and remain one of the most challenging problems in adversarial robustness. Unlike non-targeted attacks, targeted transferability critically depends on aligning class-conditional feature representations across heterogeneous architectures. However, most existing feature-level attacks rely on isotropic or stochastic feature mixing, implicitly assuming structure-invariant representations and overlooking systematic misalignment in both spatial and spectral dimensions. We revisit targeted adversarial transfer from the perspective of conditional representation alignment and propose Structure-Aware Feature Tuning Mixup (SA-FTM), a principled extension of feature tuning that explicitly incorporates structural priors into feature-level perturbations. SA-FTM characterizes feature structure through the joint distribution of spatial saliency and spectral energy allocation, and introduces structure-aware feature tuning to reduce cross-model misalignment during targeted optimization. By emphasizing spatially discriminative regions and compensating for architecture-induced spectral bias, SA-FTM stabilizes targeted adversarial transfer across diverse model families. Extensive experiments on the ImageNet-compatible benchmark show that SA-FTM consistently outperforms state-of-the-art feature-level attacks across a wide range of CNNs, Vision Transformers, and adversarially trained models. Under standard evaluation settings, SA-FTM improves the targeted transfer success rate by 3.0 percentage points on average, with only marginal additional computational cost.}
}
@article{BAI2026116424,
title = {BGV-TCF: A trust-guided homomorphic protocol for scalable privacy-preserving collaborative filtering},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116424},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116424},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011500},
author = {Yanan Bai and Hongbo Zhao and Xiaoyu Shi and Liji Xiao and Zepeng Gong and Yanglei Lu},
keywords = {Privacy-preserving collaborative filtering, Fully homomorphic encryption, Trust-based filtering, Homomorphic parallelism, Recommender system},
abstract = {Protecting user privacy in recommender systems, particularly in collaborative filtering (CF), remains a major challenge due to the reliance on sensitive user data. Existing encryption-based privacy-preserving CF (PPCF) protocols provide strong security guarantees but often incur prohibitive computational latency and communication overhead, which severely limit their scalability in practice. In this paper, we propose BGV-TCF, a trust-guided homomorphic protocol for privacy-preserving collaborative filtering. Unlike most PPCF schemes that rely on a trusted third-party key server, BGV-TCF designates the target user as the key authority. This architectural shift reduces ciphertext exchange, alleviates server-side computation, and eliminates key escrow risks. Moreover, we introduce an Encrypted Trust Gate mechanism that privately evaluates encrypted trust scores to filter unreliable neighbors prior to similarity computation, thereby reducing redundant homomorphic operations without revealing trust values or relationships. Finally, BGV-TCF exploits homomorphic parallelism through the BGV fully homomorphic encryption scheme with Smart–Vercauteren packing, enabling parallel processing of multiple ratings within a single ciphertext and significantly improving throughput. We provide formal proofs of correctness and privacy under the semi-honest model, together with a quantitative analysis of computational and communication costs. Extensive experiments on real-world datasets demonstrate that BGV-TCF consistently outperforms state-of-the-art PPCF methods, achieving substantial efficiency gains while maintaining comparable recommendation accuracy.}
}
@article{CORK2026116376,
title = {Selecting test problems from benchmark suites in constrained multiobjective optimisation},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116376},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116376},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011020},
author = {Jordan N. Cork and Tea Tušar and Bogdan Filipič},
keywords = {Constrained multiobjective optimisation, Benchmarking, Test problems, Multiobjective evolutionary algorithms, Problem selection},
abstract = {Benchmarking is essential to the effective conduct of algorithm development and selection. However, current benchmark suites in constrained multiobjective optimisation, consisting of constrained multiobjective optimisation problems (CMOPs), are lacking in many areas, particularly regarding their diversity and ability to differentiate among algorithms. This limits the ability to adequately conduct benchmarking in this domain. Despite the inadequacies of existing benchmark suites, there do exist CMOPs which are satisfactory according to certain criteria. This paper proposes a benchmark suite called the Selected Test Problems (STEP) suite. It is derived from a methodology for selecting the satisfactory CMOPs from the set of all CMOPs provided by the existing benchmark suites. The STEP suite is analysed in both the feature and performance spaces and is found to be diverse and able to distinguish among algorithms, in addition to other desirable characteristics.}
}
@article{ZHANG2026116400,
title = {Flow-RAG: Retrieval-augmented generation for knowledge graph question answering via gated flow propagation},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116400},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116400},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011263},
author = {Weina Zhang and Junsheng Huang and Zhongqin Bi and Baonan Wang},
keywords = {Knowledge graph question answering, Retrieval-augmented generation, Large language model},
abstract = {Large Language Models (LLMs) demonstrate strong reasoning capabilities but are constrained by inherent limitations, including hallucinations and knowledge obsolescence. Retrieval-Augmented Generation (RAG) based on Knowledge Graphs (KGs) alleviates knowledge-intensive problems by grounding LLM outputs in structured external knowledge. However, existing KG-based retrievers still encounter three major challenges: (1) limited generalization caused by overfitting to specific graph structures; (2) predominant reliance on QA-pairs or the shortest paths between them as supervision signals, which may introduce noise into training; and (3) inefficient context utilization constrained by static or fixed-size retrieval scales. To address these limitations, we propose Flow-RAG: Retrieval-Augmented Generation for knowledge graph question answering via gated flow propagation. Our method reformulates multi-hop reasoning as a constrained flow propagation process over a Time-State Trellis. To improve robust generalization, dynamic intent tracking is used to prevent overfitting to specific graph structures. Furthermore, a Bidirectional Flow Distillation paradigm is introduced to extract high-quality reasoning paths and guide the model in learning retrieval logic on KGs. Finally, a Distribution-Aware Adaptive Pruning mechanism dynamically adjusts a context-adaptive decision boundary through log-space clustering. Extensive evaluations on the WebQSP and CWQ benchmark datasets show that Flow-RAG achieves highly competitive performance. It not only demonstrates robust cross-dataset generalization and reduced retrieval latency but also markedly decreases the context overhead for the downstream LLM compared with existing advanced models while maintaining high accuracy. Our code is available on GitHub.}
}
@article{PENG2026116303,
title = {Dual Feature Progressive Disentanglement for generalizable face forgery detection},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116303},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116303},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010294},
author = {Shufan Peng and Tianliang Lu and Miaoxuan Shan and Bowen Ding},
keywords = {Face forgery detection, Feature disentanglement, Adversarial learning, Orthogonal projection, Adaptive normalization},
abstract = {Existing face forgery detection (FFD) models often generalize poorly across datasets and manipulation types because their features entangle genuine content and method-specific artifacts with forgery cues. We propose Dual Feature Progressive Disentanglement (DFPD), a unified framework that learns robust, domain-invariant forgery representations by disentangling both local spatial regions and common forgery semantics. A Local Feature Disentanglement (LFD) module exploits pixel-wise entropy to build entropy-guided spatial masks, emphasizing transferable regions while suppressing ambiguous backgrounds and low-confidence patches. In parallel, a Common Forgery Disentanglement (CFD) module couples adaptive balanced normalization with adversarial learning to attenuate domain-specific style variations and promote cross-domain alignment. To further prevent residual content leakage, we adopt an orthogonal feature projection that explicitly removes content components from the learned forgery embedding. These components are trained under a Progressive Feature Disentanglement Strategy (PFDS), which applies fine-to-coarse disentanglement constraints from shallow to deep network stages to stabilize optimization. Extensive cross-dataset and cross-manipulation evaluations, including robustness tests under common image degradations and benchmarks with emerging diffusion-based generative forgeries, show that DFPD consistently outperforms state-of-the-art detectors on unseen domains and attacks. Ablation studies further validate the complementary contributions of LFD, CFD, and PFDS within the proposed framework.}
}
@article{ZHU2026116264,
title = {Dr.MEA: Leveraging large language model to enhance multi-modal entity alignment},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116264},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116264},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009901},
author = {Jizhao Zhu and Quanxin Jin and Xiang Li and Xinlong Pan and Lei Lin},
keywords = {Multi-modal knowledge graph, Multi-modal entity alignment, Large language model, Representation learning, Deep reasoning},
abstract = {Multi-modal entity alignment (MMEA) aims to identify entities representing the identical real-world object across two multi-modal knowledge graphs (MMKGs), serving as a crucial and challenging task in MMKG fusion. Prior methods rely on the integration of various uni-modal representations of entities within MMKGs, and employ similarity-based measures (e.g., Euclidean distance or cosine) to determine whether entity pairs from different MMKGs refer to the same real-world object. However, these methods suffer from two key limitations: (i) If there is a lack of semantic similarity between the uni-modal features of two entities, the fused cross-modal representations struggle to achieve high semantic matching; (ii) Using a simple similarity-based calculation for entity alignment seriously lacks deep reasoning. To address these issues, we propose Dr.MEA, a novel MMEA method enhanced by large language model (LLM) , leveraging the powerful generation and deep reasoning capabilities of LLM. First, by taking advantage of the structural, relational, attribute, and image information of entities within the MMKG, we further employ LLM to generate holistic and coherent textual descriptions of entities from a global perspective, compensating for the limitations and fragmentation of uni-modal information. Second, we design a multi-turn conversational deep reasoning mechanism based on LLM to enhance the reliability of alignment results. Extensive experiments on public benchmark datasets demonstrate that Dr.MEA significantly outperforms existing works, outperforming state-of-the-art performance in MMEA, with an average improvement of 13.03% on the Hits@1 metric. In addition, it has significant advantages especially in few-shot scenarios. Our code is available at https://github.com/quanquan01/Dr.MEA.}
}
@article{JIA2026116344,
title = {Universal Attack based Focal Enhancement for Bearing Fault Diagnosis},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116344},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116344},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010701},
author = {Puhua Jia and Xinghao Yang and Yongwei Tang and Baodi Liu and Wei Li and Weifeng Liu},
keywords = {Deep Neural Network (DNN), Bearing fault diagnosis, Universal adversarial perturbation},
abstract = {Deep Neural Network (DNN) is the foundation component of an intelligent bearing fault diagnosis system, but it shows great vulnerability to adversarial attacks, such as FGSM and PGD. However, these one-by-one attack strategies are time-consuming and ineffective in bearing diagnosis attack scenarios, where the detection signals are passed very fast and the observation of the detection signals is generally impermissible. To fit the real attack situation, this paper proposes the Universal Attack based Focal Enhancement for Bearing Fault Diagnosis (UAFE). Specifically, we made the following contributions: (1) We propose the first universal attack strategy against bearing fault diagnosis systems and demonstrate the existence of universal adversarial perturbations (UAPs) in bearing fault diagnosis systems. (2) We develop the focal enhancement mechanism for the universal attack, which adaptively allocates the optimization attention to different signal attacks to improve the universality of the UAP. (3) UAFE can accomplish targeted or untargeted attacks by slightly changing the objective function. (4) We evaluate the effectiveness of UAFE on three popular data sets. Experimental results validate that UAFE shows an outstanding attack performance.}
}
@article{XU2026116197,
title = {Batched verifiable distributed secure matrix polynomial computation},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116197},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116197},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009238},
author = {Yi Xu and Weijie Tan and Chunguo Li and Minyao Ma},
keywords = {Verifiable, Matrix polynomial, Large-scale matrix, Distributed secure computation},
abstract = {Massive matrix operations are fundamental to large-scale machine learning, and distributed computing frameworks with multiple workers and a master enable parallel sub-tasks execution for acceleration. However, the acceleration effect is hindered by two key issues: performance bottlenecks from stragglers and security risks from collusion attacks. Although matrix coding can mitigate these problems, existing works either optimize performance for a single distributed matrix multiplication or support semi-honest secure consecutive distributed matrix multiplication for matrix polynomial, failing to address efficient verification for distributed matrix polynomial computation robust to malicious collusion attacks. To fill this gap, we propose a new batched Verifiable Distributed Secure Matrix Polynomial Computation (VDSMPC) framework. It supports one-time verification for continuous distributed matrix multiplications even when subject to malicious collusion attacks. Performance evaluations confirm that the scheme outperforms existing approaches significantly in online communication overhead, computational complexity, and verification cost for distributed workers.}
}
@article{XU2026116360,
title = {Future horizon-guided trend projection: A proactive mapping framework for long-term time series forecasting},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116360},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116360},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010865},
author = {Runxuan Xu and Siyuan Huang and Yepeng Liu},
keywords = {Long-term time series forecasting, Seasonal-trend decomposition, Future horizon-guided dual attention, Depthwise separable convolution},
abstract = {Long-term time series forecasting (LTSF) has become increasingly pivotal across diverse domains, including energy management, transportation, and healthcare. Existing Transformer-based architectures, however, primarily rely on attention mechanisms that are confined to the passive evolution of historical sequences. These models often overlook the extensible global trends within future target sequences, failing to proactively perceive the complex mapping between historical contexts and future horizons. Consequently, their ability to model sequences with high volatility is hindered, leading to constrained predictive precision. To address these challenges, we introduce STDCformer, a Seasonal-Trend Dual-Attention Convolutional Transformer. STDCformer integrates a dual-decomposition strategy — utilizing Fourier Transform for seasonal components and multi-scale moving averages for trend components — coupled with patching techniques to extract semantically meaningful features. Specifically, the seasonal component employs self-attention to capture localized periodicities, while the trend component introduces a novel Future-Attention mechanism. By utilizing a learnable query matrix as a surrogate for future horizons, this mechanism actively projects historical trends into the future, thereby explicitly modeling the temporal mapping relationships. Furthermore, residual connections are employed for information integrity, followed by depthwise separable convolutions for efficient feature refinement and deep fusion. Extensive experiments on real-world benchmarks demonstrate that STDCformer not only surmounts the limitations of existing models but also achieves superior performance in both predictive accuracy and computational efficiency.}
}
@article{ZHAI2026116371,
title = {MH-DNT: Noise-robust model-heterogeneous federated learning for medical image classification via dual noise tolerance},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116371},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116371},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601097X},
author = {Chenhan Zhai and Hui Liu and Ertong Shang and Jingchao Lu and Zeyu Qiu and Junzhao Du},
keywords = {Federated learning, Model heterogeneity, Noise label, Medical image classification},
abstract = {Model-heterogeneous federated learning enables multiple medical institutions deploying models with different architectures to collaboratively train while preserving data privacy. Because of annotation uncertainty in medical institutions, the collected datasets inevitably contain noisy labels, whose overfitting and propagation can adversely affect the accuracy performance. Existing methods primarily focus on correcting noisy labels for supervised training and reducing the contribution of low-quality clients in shared knowledge. However, they lack effective modeling and communication of the generalized class-invariant features that are shared between mislabeled samples and their true classes, leading to suboptimal classification accuracy. To address these challenges, we propose MH-DNT, a noise-robust model-heterogeneous federated learning method for medical classification. It adopts dual noise-tolerance strategies in both the local training and knowledge communication to effectively capture generalized class-invariant features and enhance robustness to noisy labels. First, to effectively learn intrinsic class-invariant features within each client, we propose a consistency-guided noise-robust loss, which utilizes robust predictions to enforce consistent learning across multi-view augmented samples, thereby enabling the modeling of common class patterns. Second, to facilitate the communication of reliable shared class-invariant knowledge among clients, we design quality consensus-enhanced knowledge distillation, which leverages both individual and consensus knowledge from high-quality clients to guide collaborative learning, thereby enabling effective cross-client knowledge transfer while reducing the influence of collaborative bias. We conduct extensive experiments on four medical image datasets under intrinsic and synthetic label noise, demonstrating that MH-DNT outperforms seven state-of-the-art baselines, achieving up to 4.67% improvement in the accuracy and 3.97% improvement in the F1 score.}
}
@article{XU2026116368,
title = {GALACLIP: Bridging global alignment and local reasoning via cost aggregation for zero-shot semantic segmentation},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116368},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116368},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010944},
author = {Dan Xu and Guoshu Song and Wei Teng and Jinlong Shi},
keywords = {Zero-shot semantic segmentation, Vision-language models, Cost volume, Local aggregation},
abstract = {The powerful zero-shot generalizability of contrastive language-image pretraining (CLIP) has significantly advanced zero-shot semantic segmentation (ZSS). However, a fundamental challenge remains in bridging the gap between its image-level pretraining and pixel-level dense prediction, particularly for capturing fine-grained semantic structures. To address this issue, we propose a novel framework termed GALACLIP (global alignment and local aggregation learning for CLIP). It features a global–local dual-branch architecture, comprising a global alignment branch for cross-modal semantic alignment and a local aggregation branch for pixel-level structural reasoning. Specifically, a visual–textual correlation cost volume is constructed, upon which a guided cost aggregation mechanism is applied to model local semantic relationships without directly perturbing pretrained visual features. Additionally, a dynamic gating strategy is employed to adaptively fuse the outputs of the two branches at the pixel-class level. Extensive experiments on benchmark datasets demonstrate that GALACLIP delivers superior performance, particularly on unseen classes, while maintaining strong generalizability. Moreover, the proposed local aggregation branch module is plug-and-play and can be seamlessly integrated into existing ZSS frameworks, consistently yielding performance improvements. Our source codes are available at https://github.com/JoJoSoooooong/GALACLIP.git.}
}
@article{ZHANG2026116405,
title = {Decoupling forward and feedback flows: A dual-attention framework for relational inference},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116405},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116405},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011317},
author = {Juyuan Zhang and Xiaoxiao Liang and Chenghua Gong and Rui Sun and Liming Pan and Linyuan Lü},
keywords = {Relational inference, Attention mechanism, Dynamics modeling},
abstract = {Inferring latent interaction structures from observational time series is a fundamental yet challenging problem in dynamical systems. Existing deep learning methods employ unidirectional information aggregation via incoming edges, failing to identify the mutual dependencies prevalent in real dynamics as well as the feedback effects induced by sampling intervals, which leads to inferential bias. To address this, we propose the Dual-Attention Relational Inference (DARI), a framework designed to learn latent interaction structures from dynamical observations. DARI employs a coupled bidirectional attention mechanism to model forward and feedback dynamics, effectively decoupling information flow from the underlying interaction structure. Extensive synthetic experiments demonstrate competitive structural recovery performance across diverse graph topologies, including undirected, directed, and weighted graphs. Experiments on COVID-19 data further show that the inferred transmission structures are consistent with real-world population mobility patterns. In addition, the elimination of costly edge-wise computations in DARI leads to substantial gains in both runtime and memory efficiency. Code is available at https://github.com/Bill-Ju/DARI.}
}
@article{AN2026116348,
title = {Advancing multi-subject text-to-image synthesis via Attention Refinement and Inheritance},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116348},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116348},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010749},
author = {Jinyang An and Yisu Liu and Wanqian Zhang and Lin Wang and Xiaohua Chen and Zexian Yang and Zheng Lin and Weiping Wang},
keywords = {Text-to-image synthesis, Diffusion models, Attention mechanism},
abstract = {Recent text-to-image diffusion models have achieved remarkable progress in high-quality image synthesis. Representative methods such as Stable Diffusion have been widely applied in areas including art design, digital content creation, and personalized generation. However, these models still struggle to produce images that properly comply with complex text prompts, particularly in scenarios involving multiple subjects. Current approaches for multi-subject synthesis focus on latent code optimization at specific timesteps, yet yielding compromised text-image alignment. In this paper, we investigate diffusion-based image generation from the perspectives of both noise initialization and the denoising process, and propose an effective two-stage Attention Refinement and Inheritance (ARI) approach. First, we refine the initial noise by updating cross-attention maps associated with different subject tokens, employing strategies of separation, energization, and centralization. Then, we introduce attention-level interpolation as an inheritance mechanism to explicitly guide the denoising process. This design ensures that the generated images remain highly consistent with the refined initial attention, enabling more controllable and faithful synthesis. Extensive experiments show that our approach achieves more faithful alignment between generated images and text prompts compared with state-of-the-art multi-subject image synthesis methods.}
}
@article{LIAKATH2026116233,
title = {Scalable task scheduling in internet of things networks: Integrating coati optimization with distributed reinforcement learning},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116233},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116233},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009597},
author = {Javid Ali Liakath and Raman Chidambaram Janaki and Chinnasamy Ambayiram and Manikandan Nanjappan},
keywords = {Coati optimization algorithm, Deep reinforcement learning, Edge computing, Fog computing, Resource allocation},
abstract = {Edge and Fog computing have emerged as an effective paradigm to meet the increasing demand for resources of the Internet of Things. However, existing task scheduling models exhibit reduced effectiveness due to high latency and limited resource allocation capability. To overcome these limitations, this paper proposes a novel Multi-Agent Distributed Reinforcement-based Crossover Coati Optimization Algorithm to perform effective task scheduling. The proposed model integrates the adaptive learning capability of deep reinforcement learning with the exploration and exploitation strengths of the Coati Optimization Algorithm. A crossover mechanism is incorporated with the Coati optimization process to enhance the search capability and solution diversity by combining multiple candidate solutions, thereby reducing premature convergence to local optima. The proposed model adopts a multi-agent architecture in which individual agents learn scheduling policies from local environments and optimize resource allocation, enabling adaptive and real-time task scheduling in dynamic environments. The proposed model enhances task scheduling performance and provides an efficient resource allocation strategy for large-scale edge and fog computing systems. In addition to this, it improves system efficiency by maintaining balanced workload distribution and reducing processing delay. Experimental results demonstrate that the proposed model reduces the response time to 2.3 s under dynamic conditions. These results confirm the effectiveness of the proposed approach in handling complex and dynamic scheduling scenarios.}
}
@article{ZHOU2026116324,
title = {LGMT: Logic-Grounded Metamorphic Testing for evaluating the reasoning reliability of LLMs},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116324},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116324},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010506},
author = {Zenghui Zhou and Man Li and Xiaoke Fang and Xinyi Zhou and Weibin Lin and Zheng Zheng},
keywords = {Large Language Models, Metamorphic testing, Logical reasoning, First-order logic},
abstract = {Large Language Models (LLMs) achieve strong performance on logical reasoning benchmarks, yet their reliability remains uncertain. Existing evaluations rely on static benchmarks, which fail to assess robustness under logically equivalent transformations and often overestimate reasoning capability. We propose LGMT (Logic-Grounded Metamorphic Testing), an oracle-free framework that leverages first-order logic (FOL) to evaluate LLM reasoning. By deriving metamorphic relations from formal logical equivalences, LGMT constructs semantically invariant test cases and detects reasoning defects through cross-case consistency checking. Experiments on six state-of-the-art LLMs show that LGMT exposes substantial hidden defects missed by traditional reference-based evaluations. We further find that models are particularly sensitive to symbol-level and conclusion-level variations, and that advanced prompting such as Few-shot CoT only partially mitigates these issues. These results suggest that LLM evaluation should move beyond isolated correctness toward robustness under logical invariance. LGMT provides a principled and scalable approach for diagnosing reasoning failures.}
}
@article{ZHU2026116261,
title = {PathLens: A lightweight multimodal reasoner for in-depth pathology insights},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116261},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116261},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009871},
author = {Zhu Zhu and Huangwei Chen and Zhenyu Yan and Donghao Zhang and Yueyi Wu and Yuqi Zhan and Weihao Cheng and Manli Zhao and Weizhong Gu and Yifei Chen and Feiwei Qin and Gang Yu},
keywords = {Multimodal large language model, Chain-of-thought reasoning, Pathology visual question answering, Reinforcement learning, Pediatric pathology},
abstract = {Pathological diagnosis is crucial for clinical decision-making; however, most existing AI systems provide only direct predictions, lacking the detailed reasoning processes essential for clinical practice. To address this limitation, we introduce PathLens, a lightweight multimodal pathology reasoner designed to deliver interpretable and efficient diagnostic reasoning. Built upon HealthGPT, PathLens avoids costly pretraining by leveraging fine-tuning on synthetic data and emulates the step-by-step diagnostic workflow of pathologists in a transparent and clinically meaningful manner. This is achieved by Patho-CoT, a novel multi-agent pipeline that synthesizes high-fidelity multimodal Chain-of-Thought data, followed by Reasoning Alignment Learning, a training paradigm that integrates supervised and reinforcement learning to align the model with expert clinical workflows. To facilitate evaluation, we also introduce PedPathVQA, the first pilot dataset dedicated to pediatric pathology visual question answering (VQA). Experimental results demonstrate that PathLens achieves a favorable balance between performance and parameter efficiency, delivering competitive results across diverse pathology VQA benchmarks while maintaining substantially lower training costs than those of comparable or larger models. Additionally, PathLens offers a clinically deployable alternative that avoids patient data transmission to external servers, addressing a key requirement in privacy-sensitive clinical environments. The code is available at https://github.com/hovchen/PathLens.}
}
@article{ZHANG2026116356,
title = {Image classification with sparse deep transfer learning at edge: A lottery pruning approach},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116356},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116356},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010828},
author = {Xu Zhang and Zhikui Chen and Hao Ren and Suhua Zhang and Yang Tian and Longxiang Zhang},
keywords = {Deep transfer learning, Edge computing, Lottery ticket pruning, Neural network compression},
abstract = {The volume of deep neural networks (DNNs) warrants increased attention to facilitate their deployment in resource-constrained edge environments. Consequently, leveraging edge computing through DNNs can significantly alleviate the burden of transmitting raw data, thereby reducing energy consumption. While designing a sufficiently compact architecture from scratch is often costly and lacks versatility, existing DNNs can be effectively compressed while enhancing parameter performance through deep transfer learning (DTL). However, traditional transfer learning approaches frequently struggle to filter out redundant parameters with low contributions. In this paper, a Lottery-based Image classification with Sparse DTL (LICS) method is designed, tracing the transferability of the optimal subnetwork, transferring knowledge by refined parameters. It flexibly generates compact, efficient DNNs while inheriting knowledge, ensuring sparsity in both structure and feature representation. The method further incorporates optimizations through teacher–student mutual learning and a foreground attention mechanism, thereby enriching transferred knowledge by refining high-value parameters. The proposed LICS method is evaluated on representative datasets, using remote sensing image classification as a simulation scenario. The resulting accuracy proves its performance advantage with adjustable parameters who can achieve a lightweight level suitable for edge devices. Since the method derived from transfer learning, it is also helpful for reusing knowledge, retrofitting existing models for rapid deployment.}
}
@article{LU2026116412,
title = {SHMG: Semantic-guided Human Motion Generation for action recognition},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116412},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116412},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601138X},
author = {Kai Lu and Long Liu and Xin Wang and Xinzhe Wang},
keywords = {Action recognition, Motion generation, Motion style transfer, Vision-language model, Active learning},
abstract = {Data generation is an effective solution to address data scarcity in skeleton-based action recognition. Existing motion generation methods often generate motions that deviate from the real motion distribution, which degrades the accuracy of downstream action recognition tasks. To tackle this challenge, we propose Semantic-guided Human Motion Generation (SHMG), a novel generative framework through motion style transfer. SHMG generates motions through a Semantic-guided Generation Module (SGM) and refines them using an Active Selection Module (ASM). In SGM, we propose a Semantic Distribution Correction Mechanism (SDCM), which corrects the distribution of style features toward that of content features under the guidance of semantic information. This allows the distribution of the generated motions to better align with real motions, thereby improving the applicability of the generated motions to action recognition tasks. Additionally, the SGM incorporates a Dual-Branch Motion Transformer (DBMT) in the encoder to preserve the independence of spatio-temporal skeleton features. The ASM consists of an action recognition network and an active selection layer, which further optimizes the distribution of the generated motion using uncertainty metrics from active learning. The SGM and ASM alternately work to generate new motions. Extensive experiments demonstrate the effectiveness of our proposed framework.}
}
@article{WU2026116372,
title = {Prototype-driven open-set domain generalization for rotating machinery fault diagnosis via multiview adversarial purification},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116372},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116372},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010981},
author = {Zhangjun Wu and Miao Chen and Shiyuan Zheng and Yaguang Guo and Haidong Shao},
keywords = {Rotating machinery fault diagnosis, Open-set domain generalization, Multiview adversarial purification, Prototype-driven Out-of-Distribution synthesis, Hyperspherical discriminative learning},
abstract = {Rotating machinery diagnosis faces critical challenges from non-stationary domain shifts and the presence of Out-of-Distribution samples. Existing domain generalization methods often suffer from feature pseudo-alignment where models align domain-specific noise rather than intrinsic fault features. They also typically rely on closed-set assumptions which limit their applicability in open-world scenarios. This paper proposes a novel open-set domain generalization framework named Multiview Adversarial Purification Network to address these limitations. The method introduces a purification mechanism that utilizes complementary information from multiview signals. By integrating intra-branch adversarial learning with cross-view consistency regularization, the model suppresses domain-specific noise and extracts robust invariant representations. Furthermore, the feature space is reshaped into a hyperspherical discriminative structure through an additive angular margin loss and an intra-class variance penalty. This ensures high intra-class compactness for known categories. A prototype-driven active out-of-distribution learning strategy transforms rejection from a passive thresholding task into an active learning process. This strategy uses variance-aware dynamic prototype updates and synthesizes pseudo-outliers to maximize the prediction entropy of Out-of-Distribution (OOD) samples. Experimental results on three public datasets demonstrate that the proposed method significantly outperforms state-of-the-art approaches in both diagnostic accuracy and open-set rejection capabilities under complex working conditions. To support reproducibility, the implementation is publicly accessible at https://github.com/simonhfut/MVAPN.}
}
@article{SHAO2026116401,
title = {ALRcallerX: Creating data-driven simulations by bridging R-based machine learning and AI-powered modeling in AnyLogic},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116401},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116401},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011275},
author = {Hang Shao and Shan-e-hyder Soomro and Xiaotao Shi and Dan Liu and Yunfei Liu and Chunpeng Bao and Junbin Cao and Xiaoyu Xie and Wei Shao and Tianyi Zhao and Fan Yang and Mengru Lee},
keywords = {Simulation-ML integration, AI-powered modeling, Process optimization, AnyLogic software, Plug-in library},
abstract = {Simulation technique, used for exploring solutions to risky real-world problems in a risk-free modeling world, is highlighted by recent studies that shed light on the power of combining simulation and machine learning. However, there is still a lack of effective tools for deploying machine learning modules for simulation experiments in popular simulation software such as AnyLogic. Herein, we propose a method for running R code and deploying machine learning algorithms in AnyLogic's simulation environment and its plug-in library ALRcallerX, which is available at GitHub. ALRcallerX enables non-programmer learners to easily deploy machine learning modules in simulation experiments. Intriguingly, this library enables R-based machine learning to be seamlessly embedded into AnyLogic native tool modules such as process modeling library and system dynamics through GUI, integrating with AnyLogic's discrete events, system dynamics, and agent-based modeling methods for AI-powered simulation. Additionally, it also profoundly changes the underlying mechanism of AnyLogic traditional simulation method. Besides using R code to interact and control the simulation flow in AnyLogic, this library can also call AnyLogic's optimization toolbox to optimize parameters of R-based machine learning algorithms. Overall, ALRcallerX upgrades the problem deconstruction pattern from traditional deterministic simulation to data-driven intelligent simulation, enabling humans to explore solutions that cannot be developed under traditional simulation frameworks. This has clear practical significance at the innovation level of research paradigms.}
}
@article{REN2026116328,
title = {A Lyapunov-based client selection approach to handle system-induced heterogeneity in federated learning},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116328},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116328},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010543},
author = {Tian Ren and Hao Zhang and Jian Chen and Weilin Liao and Siyao Cheng and Jie Liu},
keywords = {Federated learning, System heterogeneity, Client selection, Lyapunov optimization},
abstract = {With the proliferation of smart devices and intelligent applications, there is an increasing concern about data privacy protection. To better protect users’ privacy when utilizing their data to train machine learning models, a promising paradigm called federated learning (FL) emerges, enabling model training without uploading the local data to the public server. However, in FL, as device capacities of different clients and network conditions can be inherently heterogeneous, the “straggler” problem arises which results in poor model performance and low system efficiency. Most existing methods either only focus on optimizing the training time or simply considering improving model accuracy, yet they fail to address both aspects in a coordinated manner. In this paper, we formulate an optimization problem to take into account both latency and clients’ contribution to the model training, while satisfying fairness and energy consumption constraints. To tackle this issue, we propose a Lyapunov optimization-based algorithm and devise a novel System Heterogeneity and Individual Reputation-aware Client Selection (SHIR-CS) algorithm. Specifically, we propose a historical time decay-based method and a reputation-based method to effectively evaluate clients’ latency and contribution, respectively. Then based on this, we leverage the Lyapunov framework to transform the problem into the drift-plus-penalty form and design an online algorithm. Extensive experiments on three well-known datasets demonstrate an effective trade-off between learning performance and training efficiency in comparison with state-of-the-art baselines.}
}
@article{WANG2026116323,
title = {MEDP: Multimodal-Enhanced Dynamic Prototype learning for few-shot dynamic scene graph generation},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116323},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116323},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601049X},
author = {Xuejiao Wang and Ziheng Huang and Weiliang Meng and Changbo Wang and Gaoqi He},
keywords = {Dynamic scene graph generation, Few-shot learning, Multimodal feature enhancement, Dynamic prototype matching},
abstract = {The current dynamic scene graph generation (DSGG) methods rely on dense annotations, which are costly and have significant limitations in fine-grained relationship prediction. Although few-shot learning can achieve rapid adaptation with a small number of annotated samples, the diversity of object-predicate combinations in video scenes leads to significant feature heterogeneity, while the temporal complexity of dynamic scenes increases the difficulty of predicate prediction. Therefore, this paper pioneers a DSGG method for few-shot learning of multimodal enhanced dynamic prototype learning (MEDP). Specifically, the method comprises two key modules: (1) Multimodal Feature Enhancement (MFE), which generates textual descriptions of the scene via a visual language model and fuses them with frame-level visual features to enhance the representation of dynamic scene graphs. Additionally, MEDP learning uses temporal modeling to capture dynamic changes and long temporal dependencies in videos to enhance the capacity of models to understand the temporal context. (2) Dynamic Prototype Matching (DPM) achieves predicate matching in a few-shot setting by dynamically modeling each prototype based on object category and positional encoding; it computes relational instance prototypes across the textual, frame and serial levels, combining them via a weighted fusion of predicate predictions. Experiments demonstrated that the method exhibited remarkable generalizability and stability in few-shot DSGG.}
}
@article{MA2026116397,
title = {WOCD: A semi-supervised method for overlapping community detection using weak cliques},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116397},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116397},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011238},
author = {Shaozhen Ma and Hanchen Wang and Dong Wen and Wenjie Zhang and Wei Huang and Ying Zhang},
keywords = {Overlapping community detection, Semi-supervised learning, Graph neural networks, Graph transformer, Pseudo-labels, Weak cliques},
abstract = {Overlapping community detection (OCD) is a fundamental graph data analysis task for extracting graph patterns. Traditional OCD methods can be broadly divided into node clustering and link clustering approaches, both of which rely solely on link information to identify overlapping communities. In recent years, deep learning-based methods have made significant advancements for this task. However, existing GNN-based approaches often face difficulties in effectively integrating link, attribute, and prior information, and struggle to capture long-range dependencies due to their limited receptive fields, which hinders their performance on complex overlapping community detection. In this paper, we propose a Weak-clique based Overlapping Community Detection method, namely WOCD, which incorporates prior information and optimizes the use of link information to improve detection accuracy. Specifically, we introduce pseudo-labels within a semi-supervised framework to strengthen the generalization ability, making WOCD more versatile. Furthermore, we initialize pseudo-labels using weak cliques to fully leverage link and prior information, leading to better detection accuracy. Additionally, we employ a single-layer Graph Transformer combined with GNN, which achieves significant performance improvements while maintaining efficiency. We evaluate WOCD on eight real-world attributed datasets, and the results demonstrate that it outperforms the state-of-the-art semi-supervised OCD methods by a significant margin in terms of accuracy. The code is available at https://github.com/Grasszhenzhen/WOCD.}
}
@article{WANG2026116336,
title = {PIGaze: Personalized in-vehicle gaze estimation with plug-and-play adaptation},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116336},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116336},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010622},
author = {Yafei Wang and Haiheng Nan and Runze Yan and Xueyan Ding and Jianda Wang and Xianping Fu},
keywords = {Gaze estimation, Driving environment, Personalization, Gaze adaptation, Feature representation},
abstract = {Personalized gaze estimation is essential for robust driver monitoring systems, as it mitigates deployment biases induced by inherent individual variations and dynamic in-vehicle environments. Most existing methods achieve reliable performance through model fine-tuning with supervised calibration images and labels, yet they ignore the practical challenges of acquiring calibration data during real-world deployment. To address this, this paper proposes a novel personalized in-vehicle gaze estimation method termed PIGaze, which integrates self-calibration and plug-and-play baseline model adaptation in naturalistic driving scenarios. Specifically, we first design a gaze zone calibrator that automatically generates key image sequences based on the geometric consistency of gaze. The images and labels corresponding to the left-side mirror, right-side mirror, rear-view mirror, and frontal windshield are extracted for self-calibration. Building on this, we further develop a gaze adapter that infers potential gaze points via the baseline model adaptation. Here, pre-trained baseline models are employed as frozen feature extraction, feeding both calibration and target images to learn the relative gaze mapping. Experimental results show that the proposed method outperforms fine-tuning approaches on both the IVGaze and the LBW datasets. Specifically, compared to baseline models, it yields an average accuracy improvement of 23% and a maximum of 40% on the IVGaze dataset, and an average improvement of 18% and a maximum of 27% on the LBW dataset.}
}
@article{NGUYEN2026116417,
title = {Deep reinforcement learning to select efficient portfolios of search heuristics for solving dynamic job shop scheduling},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116417},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116417},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011433},
author = {Vu-Tien Nguyen and Su Nguyen and Van-Hop Nguyen},
keywords = {Combinatorial optimization, NP-hard problems, Deep reinforcement learning, Proximal policy optimization, Dynamic job shop scheduling problem},
abstract = {Dynamic Job Shop Scheduling (DJSSP) involves unpredictable uncertain events like random job arrivals, making it challenging for traditional heuristic methods to maintain efficiency. Although many recent studies apply machine learning to enhance heuristics or metaheuristics to handle DJSSP under uncertainties, most focus on static settings and address only a single optimization policy such as a construction or improvement heuristic. This research introduces a novel deep reinforcement learning system that adaptively selects portfolios of search strategies for the dynamic job shop scheduling problem. This approach enhances solution quality and runtime efficiency by leveraging a multi-strategy capability to dynamically adapt to problem characteristics. Numerical experiments illustrate that the proposed method outperforms original solver configurations, a wide range of dispatching rules, and a double deep Q-network-based approach. The results demonstrate that the proposed deep reinforcement learning model offers a practical and scalable approach for real-world dynamic scheduling applications.}
}
@article{LI2026116300,
title = {Federated Learning for Edge Computing Enabled Artificial Intelligence of Things: A comprehensive survey},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116300},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116300},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010269},
author = {Qilei Li and Mingliang Gao and Wenzhe Zhai and Wentai Wu and Chen Wang and Ahmed M. Abdelmoniem},
keywords = {Artificial Intelligence of Things, Federated Learning, Edge Computing, Privacy, Data security},
abstract = {Among contemporary AI computing paradigms, Federated Learning (FL) stands out as an innovative method and has shown great potential in conjunction with edge computing. The two techniques combined serve as a building block forthe development of the Artificial Intelligence of Things (AIoT). This paper sheds light on the synergistic integration of FL with edge computing to propel AIoT’s capabilities in decentralized environments. By executing computing tasks closer to the data, FL at the edge not only alleviates latency and bandwidth limitations inherent in cloud-centric architectures, but also presents a robust solution to privacy concerns—a crucial obstacle in traditional centralized training setups. This paper delves into how FL tackles these privacy issues, providing an intricate explanation of its operational principles, applications, and the resultant benefits for AIoT systems. Through this scrutiny, we highlight FL’s potential in bolstering the efficiency and privacy of AIoT deployments while also delineating future research directions and the expected impact across various domains. This study aims to comprehensively comprehend FL for Edge Computing-enabled AIoT and foster developments in intelligent technologies and applications in an interconnected world.}
}
@article{HUO2026116352,
title = {A multi-level contrastive learning framework with reliability estimation for multimodal recommendation},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116352},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116352},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010786},
author = {Yifan Huo and Hang Li and Ruobing Wang and Ming Liu and Junhong Zheng and Lili He},
keywords = {Multimodal recommendation, Reliability-aware learning, Uncertainty modeling, Contrastive learning},
abstract = {Existing multimodal recommendation systems often face content-level and interaction-level uncertainty: multimodal item content may contain contextual or weakly preference-indicative semantics, while observed user–item interactions may provide heterogeneous levels of preference evidence. Most existing methods treat content uncertainty and interaction uncertainty separately, which limits their ability to control the propagation of low-confidence signals throughout multimodal fusion, graph learning, and representation alignment. To address this issue, we propose a Multi-Level Contrastive Learning Framework with Reliability Estimation for Multimodal Recommendation (MRCL). First, we design a Dual-Prototype Residual Purification module, which constructs semantic and behavioral prototypes to refine multimodal representations by softly adjusting low-confidence feature components toward a fused prototype that integrates semantic neighborhood evidence and collaborative behavioral evidence. Second, we develop a cross-level reliability co-refinement mechanism to jointly refine item-level content reliability and edge-level interaction reliability, enabling reliability-aware graph propagation with soft confidence weights. Third, we introduce a Reliability-Stratified Cross-view Contrastive Learning objective that aligns semantic and collaborative views while emphasizing reliable anchors and medium-reliability semi-hard negatives. Extensive experiments on three public datasets demonstrate the superiority and robustness of MRCL over strong baselines.}
}
@article{WANG2026116393,
title = {Frequency-context dynamic convolution and a large-scale benchmark dataset for underwater dense image prediction},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116393},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116393},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011196},
author = {Xingfa Wang and Chenggang Dai and Chengjun Chen and Kunhua Liu and Mingxing Lin},
keywords = {Underwater dense prediction, Dynamic convolution, Frequency-domain modeling, Context-aware attention, Large-scale dataset},
abstract = {Absorption and scattering effects cause color distortion, poor contrast, and blurred details in underwater images, degrading feature discriminability and accuracy of underwater object prediction. Moreover, the scarcity of underwater samples and fine-grained annotations further limits the training effectiveness and generalization capability of models. To address these issues, we propose a weight-adaptive calibration strategy that integrates frequency-domain channel modulation with context-aware attention. According to this strategy, a frequency-context dynamic convolution (FCDConv) is designed to simultaneously calibrate convolutional weights in frequency and spatial domains, thereby improving the feature representations of underwater objects. FCDConv comprises two branches: (i) the modulation branch of the frequency-domain channel introduces discrete cosine transform to adaptively reweight responses across different frequency bands, highlighting informative frequency components and suppressing noise in degraded regions, and (ii) the context-aware attention branch, guided by global semantics, generates a token-wise intra-kernel spatial weight distribution and injects global contextual information into the dynamic convolution kernels to enhance the global adaptivity of dynamic convolution. A large-scale underwater dataset for instance segmentation is constructed, with 20,000 real-world underwater images, 15 representative object categories, and fine-grained pixel-level mask annotations. Comprehensive experiments demonstrated that the proposed FCDConv exhibited improved performance across various backbones, tasks, and datasets, exhibiting superior generalization and transferability. The dataset and code are available at https://github.com/xfwang-qut/MarIS20K-QUT.}
}
@article{HASSAN2026116377,
title = {FireSegUNet: Exploring computationally efficient fire segmentation network for Unmanned Aerial Vehicles},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116377},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116377},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011032},
author = {Ali Hassan and Johan Johansson and Stefan Schulte and Tingting Zhang and Karen Egiazarian and Mårten Sjöström},
keywords = {Channel attention, Convolutional neural network, Fire segmentation, Optimization, UNet},
abstract = {Semantic segmentation on resource-constrained hardware remains a key challenge in deep learning, particularly for deployment on edge devices and embedded systems. In this study, we propose FireSegUNet, a lightweight and computationally efficient deep-learning architecture tailored for such environments. The model integrates an optimized inverted bottleneck layer for feature extraction within an encoder–decoder framework, reducing computational complexity by up to 51%. It also improves segmentation accuracy through an efficient squeeze-and-excitation block, while reducing inference time by up to 7.3× and energy consumption by up to 4.6× compared to conventional attention mechanisms. Extensive evaluation on diverse fire segmentation datasets demonstrates that FireSegUNet achieves competitive segmentation accuracy while reducing the number of parameters and storage requirements by up to 81%. Additionally, we provide a detailed analysis of the relationship between model complexity metrics and actual inference time, memory usage, and energy consumption. This comprehensive evaluation confirms that FireSegUNet delivers better performance on edge devices and generalizes well to unseen datasets. These findings position FireSegUNet as a practical solution for efficient image segmentation in resource-constrained environments. Although primarily validated on fire segmentation, the modular design of FireSegUNet makes it adaptable to other computer vision tasks. The source code of FireSegUNet is publicly available at https://github.com/Realistic3D-MIUN/FireSegUNet.}
}
@article{GOLAFROUZ2026116250,
title = {Deep learning-based emotion recognition using unimodal facial expressions or physiological signals: A review},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116250},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116250},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126009767},
author = {Mohsen Golafrouz and Houshyar Asadi and Mohammad Anwar Hosen and Mohammad Reza Chalak Qazani and Amin Khatami and Mojgan Fayyazi and Li Zhang and Siamak Pedrammehr and Lei Wei and CP Lim and Saeid Nahavandi},
keywords = {Deep learning, Emotion recognition, Physiological signals, Emotion induction dataset, Emotion stimuli, Facial expressions},
abstract = {Emotion recognition has become a key component of intelligent systems, enabling improved human–computer interaction across domains such as healthcare, education, and robotics. Progress has been achieved using facial expressions and physiological signals, particularly Electroencephalography (EEG) and Electrocardiogram (ECG), supported by advances in deep learning. This paper presents a comprehensive review of unimodal emotion recognition based on facial expressions or physiological signals, with each modality analysed independently to understand signal-specific characteristics and modelling strategies. In addition to commonly studied modalities, this review covers physiological signals including Galvanic Skin Response (GSR), Photoplethysmography (PPG), Electrooculography (EOG), Electromyography (EMG), Respiration Rate (RR), Skin Temperature (SKT), and functional near-infrared spectroscopy (fNIRS). The review emphasises the design and evaluation of deep learning architectures, including Convolutional Neural Networks (CNNs), Recurrent Neural Networks (RNNs), Long Short-Term Memory (LSTM), Gated Recurrent Units (GRU), and emerging approaches such as transformer-based models, Vision Transformers (ViTs), and transfer learning techniques. Studies are analysed using a structured evaluation framework considering model design, preprocessing strategies, datasets, evaluation protocols, and performance. Unlike existing surveys, this work provides a critical analysis of prior studies, highlighting strengths, limitations, and trade-offs, with emphasis on generalisation capability and evaluation strategies. The review identifies risks associated with improper data partitioning, where data leakage can lead to overestimated performance. Key challenges include limited dataset sizes, lack of standardised evaluation protocols, and inconsistencies in performance reporting. This study provides a structured understanding of current research trends and outlines future directions for developing more robust, reliable, and generalisable emotion recognition systems.}
}
@article{REN2026116361,
title = {DDNA: Dual-diffusion-enhanced network alignment},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116361},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116361},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010877},
author = {Shaobo Ren and Zhen Liu and Haiyang Ren and Tongle Duan and Shuhang Gu},
keywords = {Network alignment, Graph neural networks, Structural diffusion, Attribute diffusion},
abstract = {Cross-network node alignment is a fundamental problem in many domains; however, existing approaches often assume that the structural and attribute distributions of the source and target graphs are identical. In practice, this assumption rarely holds, leading to poor alignment performance. To address this challenge, we propose a graph distribution alignment framework that explicitly aligns both structural and attribute distributions before performing node matching. Specifically, we introduce two complementary diffusion processes: (i) structural diffusion, which transforms the adjacency matrices of the source and target graphs via learnable structural transformations, and (ii) attribute diffusion, which propagates node attributes to mitigate distributional discrepancies. By enforcing the distribution alignment conditions, our method produces aligned graph representations that are robust to heterogeneity in topology and features. Extensive experiments on synthetic benchmarks and real-world networks demonstrate that the proposed approach consistently outperforms state-of-the-art baselines, by achieving up to 23.4% improvement in alignment accuracy while maintaining high computational efficiency. Ablation studies further confirm the critical role of both diffusion components. Our study establishes a principled pathway for reliable cross-network alignment amid distributional shifts.}
}
@article{ZHAO2026116406,
title = {LMSF-Net: A lightweight multi-scale fusion network with enhanced preprocessing for photovoltaic defect detection},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116406},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116406},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011329},
author = {Yao Zhao and Shiquan Li and Xiangyu Cai},
keywords = {Photovoltaic, Surface defect detection, Lightweight network, Multi-scale fusion},
abstract = {Automated defect detection in photovoltaic (PV) electroluminescence (EL) images is essential for efficient inspection, operation and maintenance (O&M) scheduling, asset health monitoring, and safety assurance. However, the diversity of defect morphologies, the prevalence of small targets, and cluttered backgrounds make it difficult to jointly optimize accuracy and efficiency. We propose LMSF-Net, a lightweight multi-scale fusion network that couples a three-stage enhancement pipeline with an efficient detection architecture. The enhancement pipeline comprises contrast-limited adaptive histogram equalization (CLAHE), guided filtering, and the discrete wavelet transform (DWT) to enhance local contrast, preserve edge continuity, and recover high-frequency details in defect regions. The StarNet backbone improves feature diversity with minimal computational overhead. The proposed dual-hierarchical feature pyramid network (DHFPN), equipped with dual-path coordinate attention (DPCA), models long-range dependencies along horizontal and vertical directions to improve localization. A context-guided C2f-CG block injects multi-scale semantics with fewer parameters, while a lightweight shared-convolution detection head (LSCD) enforces cross-scale consistency and reduces redundancy. Experiments on EL datasets show that the proposed method balances accuracy and efficiency with only 1.5M parameters and 7.4 GFLOPs, yielding an 86.5% reduction in parameter count and an 85.5% reduction in model size. The model combines high efficiency with low resource overhead, indicating strong potential to support scalable, data-driven O&M decision-making in future applications.}
}
@article{CHEN2026116285,
title = {GBExplainer: Generalizing adaptive-granularity explanations with granular balls for graph neural networks},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116285},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116285},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010117},
author = {Jiancu Chen and Shuyin Xia and Sen Zhao and Danni Wang and Chang Peng},
keywords = {Graph neural networks, Granular ball, Global-to-local, Multi-granularity, Structural-level, Explainability, Interpretability},
abstract = {Explaining Graph Neural Networks (GNNs) is essential for enhancing prediction credibility and transparency, benefiting various downstream tasks. Previous methods utilize a local-to-global aggregation strategy, generating induced subgraphs with a fixed number or ratio for explaining GNNs predictions. However, due to data distribution differences, the optimal subgraph size varies significantly. The approach of generating induced subgraphs using a fixed number or ratio cannot fit the optimal subgraph size. To address this issue, we propose GBExplainer, a graph neural network explainer based on granular-ball computing. GBExplainer employs a global-to-local subgraph splitting strategy, combining coarse-grained structural-level and fine-grained edge-level information to explain GNNs predictions. Firstly, it fits the distribution of a graph through granular-balls, thereby generating a multi-granularity granular-ball graph based on information gain. Secondly, it constructs structural-level representations from the granular-ball graph for coarse-grained explanations. Finally, it provides fine-grained explanations within granular-balls. Notably, GBExplainer requires no parameter control for subgraph scale and is a model-independent method, offering flexibility and broad applicability. Experiments on several graph classification datasets of different networks show that GBExplainer outperforms state-of-the-art baselines. Our codes are available at https://anonymous.4open.science/r/GBExplainer-32E6/.}
}
@article{BRAGA2026116369,
title = {Operational fairness diagnostics for AI-based detection systems: Metrics and methodology},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116369},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116369},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010956},
author = {Carlos Mario Braga and Manuel A. Serrano and Eduardo Fernández-Medina},
keywords = {Operational fairness metrics, Metric adaptation, Trustworthy AI, AI-based detection systems, Cybersecurity, Algorithmic governance, Operational fairness diagnostics, Proxy ground truth},
abstract = {AI systems operating in complex, high-frequency environments often make critical decisions such as generating alerts, prioritizing events or assigning severity scores, under conditions of partial ground truth, uneven group visibility and implicit, context-dependent logic. In such settings, it becomes difficult to assess whether behavior is consistent across sources, categories or technical modules. This challenge is particularly relevant in domains such as cybersecurity, where automated decisions directly influence threat prioritization, resource allocation and system-level risk exposure. Fairness metrics have been extensively studied in machine learning, yet most approaches assume supervised classification tasks with complete labels and explicit demographic groups. These assumptions often break down in operational AI systems, where decisions are decentralized, labels are partial or delayed, and group-defining attributes are technical, such as protocol type, sensor origin or detection source. As a result, classical fairness metrics often fail to detect or characterize structural disparities in real-world, partially supervised deployments. To address this gap, we propose a structured six-phase methodology for adapting fairness metrics, specifically independence, separation and sufficiency, to decision systems operating under dynamic and context-sensitive conditions. The framework is applied to the domain of cybersecurity, where the analysis of system behavior is challenged by alert inflation, detection imbalance and score inconsistency. The metrics are characterized using four synthetic scenarios, crafted to reproduce typical diagnostic conditions and to verify the selective sensitivity of each metric, and a real-world intrusion detection dataset (UNSW-NB15), in which a trained Random Forest classifier is evaluated via 5-fold stratified cross-validation to reflect operational conditions. Results show that, even under a high-performing classifier (global F1 = 0.98), the proposed metrics reveal protocol-level disparities not captured by aggregate performance measures, and remain stable under consistency-preserving conditions. Statistical testing confirms that the observed disparities are highly significant (p<10−300), with effect size analysis confirming their practical magnitude, and comparative analysis with standard fairness metrics reveals the limited diagnostic resolution of these classical indicators in operational settings. The resulting metrics are mutually compatible and respond independently across decision dimensions without conflict. Their interpretability and traceability support structured diagnostic analysis of system behavior. We formally derive their theoretical properties, and discuss how they complement the diagnostic objectives promoted by governance frameworks such as the EU AI Act, the NIST AI Risk Management Framework and ISO/IEC 42001. These results position the resulting metrics as diagnostic instruments for analyzing system-level behavior in environments characterized by partial supervision and evolving behavior.}
}
@article{HU2026116429,
title = {Hyperspectral single-source domain generalization via structured data simulation and domain-disparity decorrelation},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116429},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116429},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601155X},
author = {Haotian Hu and Yunpeng Zheng and Qian Liu and Shuai Yang and Biqi Wang and Xiaohui Yuan and Lichuan Gu},
keywords = {Hyperspectral image classification, Single-source domain generalization, Structured data simulation, Domain-disparity decorrelation},
abstract = {Cross-scene hyperspectral image (HSI) classification faces significant challenges due to domain shifts arising from structured spectral–spatial variations. While Single-Source Domain Generalization provides a viable pathway by learning from only one source domain, prevailing methods, particularly those built on generative-adversarial strategies, remain constrained by two issues. On the one hand, they predominantly depend on unstructured randomization, which ignores the inherent structured variations of cross-scene HSI. On the other hand, in striving for domain invariance, they tend to enforce strict alignment, which can suppress discriminative intra-domain features that are valuable for classification. To address these challenges, this paper proposes SD3Net, a novel framework grounded in structured data simulation and domain-disparity decorrelation. Specifically, to ensure structural fidelity, we introduce the Structured Data Simulation Generator (SDSG), which shifts data generation method from stochastic perturbation to logic-driven emulation. It consists of a Semantic-Anchored Layout Simulator (SALS) to reorganize spatial topologies based on semantic logic, and a Multi-Scale Spectral Variation Simulator (MSVS) to emulate spectral distortions induced by sensor and atmospheric variations. Meanwhile, to resolve the dilemma between invariance and discriminability, we propose the Domain-Disparity Decorrelation Discriminator (D3). Instead of enforcing strict alignment, this mechanism explicitly models feature residuals between source and simulated domains and maximizes their predictive entropy. This strategy effectively decouples domain-specific disparities from the feature representation while preserving essential intra-domain semantics. Extensive experiments on multiple cross-scene HSI datasets demonstrate that SD3Net significantly outperforms state-of-the-art methods, validating the efficacy of the proposed simulation and decorrelation strategies.}
}
@article{HU2026116325,
title = {KidMind: An open framework to develop and benchmark LLMs for empathetic companionship and knowledge reasoning in Chinese child mental health support},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116325},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116325},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010518},
author = {Gang Hu and Tian Wei and Jingyao Luo and Zekang Huang and Xinghao Zhao and Shiyuan Chen and Kang Wang and Fang Liu and Min Peng and Qianqian Xie and Zhengpeng Zhao and Yuanyuan Pu},
keywords = {Child psychology, Large language model, Dataset&benchmark, Open leaderboard},
abstract = {Children face growing mental health challenges, creating opportunities for LLM-based psychological support. Yet existing psychological LLMs, primarily trained on adult data, are poorly aligned with children’s linguistic, cognitive, and emotional characteristics. To address this gap, we introduce KidMind, a pioneering open and extensible framework for Chinese child mental health support that integrates KidIns, KidGPT, and KidBen into a unified ecosystem spanning data construction, model development, and fine-grained assessment. To address the scarcity of child counseling data due to privacy concerns, we develop KidIns, a 33.7k instruction dataset built from real-world resources using LLM-augmented methods, designed to reflect the linguistic and cultural characteristics of Chinese children. Quality assessments confirm its high acceptability and natural child-language alignment. Leveraging KidIns, we fine-tune the Qwen2.5-7B-Instruct base LLM to create KidGPT, a child-oriented LLM for empathetic companionship and knowledge reasoning. KidBen, our new benchmark, uses GPT-4.1 as a simulated human judge to jointly evaluate context-aware multi-turn response generation and child-psychology knowledge through expanded tasks and detailed metrics. Evaluations across 20 leading general and psychological LLMs show that KidGPT surpasses all baseline models by 23.39% and exhibits strong generalization capabilities, despite its compact parameter size. KidMind presents the research community with an opportunity to innovate AI technologies that benefit mental well-being. Our resources are available at https://github.com/wtiantianw/KidMind.}
}
@article{TAN2026116414,
title = {Inferring game strategy from networked populations and human experimental systems},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116414},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116414},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011408},
author = {Huaiyu Tan and Yikang Lu and Alfonso {de Miguel-Arribas} and Lei Shi},
keywords = {Social dilemmas, Networked game systems, Strategic inference},
abstract = {Predicting collective human behavior is crucial for risk prevention and timely intervention across domains such as economics, public security, engineering, privacy, and public health. While epidemic forecasting has showcased the value of prediction for policy (e.g., during COVID-19), far less attention has gone to strategic behavior that co-evolves on networks and creates social dilemmas—failures of cooperation with consequences comparable to public health crises. Inspired by the success of data-driven epidemic prediction, we use graph neural networks to overcome the coupling of evolutionary and topological dynamics and predict human strategies in spatial Prisoner’s Dilemmas. We test predictive performance both on evolutionary simulations and behavioral experiments. Where simulations and experiments diverge, our method predicts human behavior without relying on closed-form dynamical equations. The framework provides an intervention-ready tool to anticipate cooperation breakdowns and prevent large-scale failures, analogous in spirit to epidemic control.}
}
@article{JIANG2026116438,
title = {Cross-modal UAV semantic communication via large-model generative restoration for air-to-ground links},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116438},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116438},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011640},
author = {Jun Jiang and Chen Zhang and Yanan Xie and Shengliang Wu and Xin He and Yong Xu},
keywords = {UAV communication, Air-to-ground channel, Cross-modal semantic communication, Robust image transmission, Generative AI, Latent diffusion model, LOS/NLOS adaptation, Semantic restoration},
abstract = {Transmitting high-definition imagery from unmanned aerial vehicles (UAVs) over bandwidth-constrained, rapidly varying air-to-ground channels remains a critical challenge. Existing semantic communication methods are predominantly unimodal and thus suffer from irreversible semantic drift when image features are corrupted during deep fading events, as no cross-modal recovery mechanism is available. To address this limitation, this paper proposes a joint text–image semantic communication system that leverages large pre-trained models (JTIS-LM), a cross-modal framework that jointly transmits independently encoded textual semantics and compressed image latents, thereby providing cross-modal redundancy to counteract channel-induced semantic collapse. At the transmitter, a variational autoencoder (VAE) compresses image features into compact latent representations, while a bootstrapping language–image pretraining (BLIP) model extracts concise textual descriptors of the captured scene. At the receiver, a dual-modal iterative semantic restoration (DISR) framework, built upon a pre-trained latent diffusion model, iteratively refines channel-corrupted latents under textual guidance via cross-modal attention. Furthermore, a hierarchical dual-adaptive mechanism, which integrates a signal-to-noise ratio (SNR)-aware macro-strategy with line-of-sight (LOS)/non-line-of-sight (NLOS)-aware micro-correction, dynamically adjusts reconstruction parameters to track the rapidly changing channel states inherent to UAV mobility. Evaluations conducted on a UAV aerial photography dataset using simulated 3GPP-compliant air-to-ground channel models indicate that JTIS-LM yields consistent improvements over state-of-the-art baselines across a 2-20 dB SNR range in urban scenarios. The proposed method demonstrates more robust performance under severe channel impairments, helping to mitigate the abrupt semantic loss typically observed in conventional transmission schemes.}
}
@article{LIU2026116410,
title = {SGFM-Net: A semantically guided feature mining network for fine-grained ship classification in remote sensing images},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116410},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116410},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011366},
author = {Xiao Liu and Chule Yang and Minming Ye and Longfei Su and Naiyang Guan},
keywords = {Fine-grained ship classification, Remote sensing, Vision-language model, Structural prior knowledge},
abstract = {The fine-grained ship classification (FGSC) problem in remote sensing is quite challenging since the images have limited viewpoint variations, rigid structural configurations, and substantial inter-class visual similarity. Existing FGSC approaches suffer from unsatisfactory classification performance and limited interpretability, as they usually overlook intrinsic structural information and fine-grained discriminative cues. To overcome the aforementioned deficiencies, we propose a Semantically Guided Feature Mining Network (SGFM-Net), which explicitly models ship structures to capture fine-grained local details while leverages textual semantic information to discriminate fine-grained ships. Particularly, SGFM-Net utilizes the auxiliary textual information to promptly extract both local and global discriminative visual features, and employs a multi-circle constrained loss to effectively align semantically diverse visual features with semantic prototypes encoded from critical ship components. Benefiting from the synergy of semantic guidance and structural priors, SGFM-Net achieves the state-of-the-art performance on existing benchmark datasets with good interpretability preserved. At the same time, we built a novel large-scale remote sensing ship slice dataset (FGSRSIS-38) to provide a more realistic and challenging evaluation benchmark for FGSC.}
}
@article{JAVAID2026116297,
title = {A graph-guided geometry-collapse adversarial attack for person re-identification},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116297},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116297},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010233},
author = {Mubashir Javaid and Muhammad Javed Iqbal and Muazzam Maqsood},
keywords = {Person re-identification, Adversarial attacks, Graph-based optimization, Feature-shift geometry, Meta-learning-inspired optimization, Texture-aware perturbations},
abstract = {Person re-identification (Re-ID) is playing a crucial part in modern surveillance systems. Nevertheless, these person Re-ID systems are typically built upon deep learning models that are very sensitive to adversarial manipulations. More precisely, these Re-ID models are explicitly trained to lessen intra-class feature distances and enlarge inter-class separations, thereby forming a structured relational geometry in the embedding space. However, the existing research studies on adversarial attack for person ReID overlook these induced relational structures in feature-shift space, where perturbations interact with identity-aware embedding geometry. From this line of research, this study presents a Graph Gating Meta Attack (GGAM) framework in which perturbations are crafted as a geometry-aware graph optimization problem. This is achieved by inducing a graph-based relational loss to explicitly distort the intra- and inter-class structure in the feature-shift space, thereby altering the relational geometry of ReID embeddings through perturbation shifts rather than directly modifying embedding distributions. It constructs a feature-difference graph within each batch, where adversarial objectives induce intra-class feature-shift collapse by maximizing consistency in perturbation-shift patterns while minimizing inter-class feature-shift similarity (i.e., maximizing divergence). Beyond relational graph distortion, GGAM employs a batch-level meta optimization strategy that mimics meta-learning dynamics through iterative support-query adaptation. The proposed GGAM also incorporates a feature-level adaptive gating mechanism along with an imperceptibility constraint to improve attack effectiveness. Extensive experiments on Market-1501, DukeMTMC-reID, Occluded-DukeMTMC, WB-WoB-ReID, and CUHK03 datasets show that the proposed adversarial framework achieves higher attack success, better generalization, and strong imperceptibility trade-offs.}
}
@article{ZHAO2026116349,
title = {Domain generalization via decoupling class and domain discriminability: A sample perspective},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116349},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116349},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010750},
author = {Jiao Zhao and Junbiao Cui and Bin Zheng and Jiye Liang},
keywords = {Domain generalization, Core data mining, Dual-path learning},
abstract = {Domain generalization aims to learn a robust model from multiple source domains that can perform well on target domain. Most existing works focus on learning a unified representation for each sample equally, resulting in domain-specific features of samples being erroneously identified as class discriminative features, impairing the model’s discriminative ability. To address this issue, we decouple these two types of discriminability at the sample level. We address the critical challenge of mining and utilizing core data in domain generalization. First, we establish a quantitative evaluation criterion to define core data from two perspectives of domain and class uncertainty. Second, we design a core data mining strategy based on two uncertainties. Furthermore, we propose a dual-path learning strategy that enhances domain-invariant representation learning. Comprehensive experiments across multiple benchmarks demonstrate that our method achieves superior generalization performance compared to state-of-the-art methods.}
}
@article{LI2026116378,
title = {Bregman adaptive nonconvex decoupled algorithm for convolutional dictionary learning},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116378},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116378},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011044},
author = {Jing Li and Minghui Xu and Jinjia Wang},
keywords = {Convolutional sparse representation, Slice-based dictionary learning, Nonconvex nonsmooth minimization, Bregman proximal gradient method, Convergence, Image reconstruction},
abstract = {Convolutional dictionary learning (CDL) aims to learn structured, shift-invariant filters and corresponding sparse representations from signals, and it has shown strong performance in a wide range of image processing applications. However, the slice-based ℓ0-constrained CDL problem is highly challenging because it is both nonconvex and nonsmooth. Conventional proximal gradient methods based on Euclidean distances do not fully exploit the intrinsic geometry of the objective, while alternating minimization schemes may converge to suboptimal stationary points. To address these challenges, we propose a Bregman adaptive nonconvex decoupled algorithm (BANDA). The main novelty is not the use of a generic Bregman proximal framework itself, but the construction of a problem-specific Legendre function tailored to the slice-based ℓ0-constrained CDL model. This tailored Bregman geometry induces a direction–magnitude decoupling of the sparse coefficient update, thereby transforming the original coupled nonconvex proximal subproblem into a tractable form. As a direct computational consequence, the coefficient magnitude is obtained by solving a one-dimensional cubic equation with an analytical solution. We further establish rigorous convergence guarantees, showing that the sequence generated by BANDA is monotonically decreasing and converges to a critical point of the nonconvex objective. Experimental results on representative image reconstruction, denoising, and texture–cartoon separation tasks, together with comparisons against classical baselines and a recent nonconvex baseline, demonstrate that BANDA achieves competitive performance in terms of reconstruction quality, sparsity, and optimization quality. These results support the practical relevance of the proposed geometry-aware optimization framework for representative CDL-related imaging tasks.}
}
@article{ZHAO2026116430,
title = {UMHSDet: Underwater Multi-scale Heterogeneous State Space Detector},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116430},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116430},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011561},
author = {Gaoli Zhao and Jiazheng Su and Junping Song and Kefei Zhang and Hang Wang and Xin Ning},
keywords = {Underwater object detection, Global guided state enhancement, Adaptive multi-branch aggregation, Bidirectional symmetric path},
abstract = {Underwater object detection is a critical technology in applications such as marine resource exploration and underwater robot navigation. However, the degraded underwater imaging environment leads to insufficient effective feature representation of the object, which severely limits detection performance. To address this problem, we propose a dedicated detection framework named the Underwater Multi-Scale Heterogeneous State Space Detector (UMHSDet). We first extract multi-scale features gradually through initial convolution and the Structure-Aware Downsampling (SAD) module. The SAD module effectively preserves high-frequency details while reducing resolution. To further enhance the semantic representation capabilities at each level, we alternately deploy the Global Guided State Enhancement (GGSE) module and the Adaptive Multi-Branch Aggregation (AMBA) module at various scales to model long-range context dependencies and strengthen local feature representation. Furthermore, we introduce a joint attention mechanism at a deep level to recalibrate features, thereby constructing a robust multi-scale representation. Building on this, we employ a bidirectional symmetric path aggregation mechanism, combined with the Global Guided Feature Integration (GGFI) module, to collaboratively optimize the interaction and fusion of multi-scale features. Finally, the optimized multi-scale representation is utilized for multi-task detection, simultaneously optimizing object localization and category discrimination performance. Extensive experiments on three benchmark datasets, DUO, RUOD, and COCO, demonstrate that UMHSDet achieves superior performance, with AP improvements of 2.0% and 3.6% on the two underwater benchmark datasets, respectively, and an AP improvement of 1.0% on the COCO dataset. The codes and model weights will be available at https://github.com/Zhao-space/UMHSDet-UOD.}
}
@article{LI2026116313,
title = {Adaptive Prompt and External Knowledge Guidance for Enhancing Molecular Graph OOD Detection},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116313},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116313},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010397},
author = {Chenyu Li and Mingchen Sun and Yutong Zhang and Ying Wang},
keywords = {Adaptive prompt, External knowledge guidance, Molecular graph OOD detection, Graph neural network},
abstract = {Molecular graph Out-of-Distribution (OOD) detection has recently received significant attention, which is crucial in various practical applications. However, existing methods often focus excessively on designing complex model architectures or optimization strategies, with limited exploration of the intrinsic associations between the attributes and structural characteristics within molecular graphs. Additionally, although some works have attempted to incorporate molecular pre-trained models into the graph embedding process, they often fail to effectively induce implicit prior knowledge. To address these limitations, we propose Adaptive Prompt and External Knowledge Guidance for Enhancing Molecular Graph OOD Detection, namely APEKG. Specifically, we initially construct the structure guided molecular graph embedding base model, which leverages the inherent structural information to improve the model’s understanding of the complex correlations between molecular structures and their attributes. Then, we construct an adaptive prompt module, which includes attribute-aware and structure-aware adaptive prompts. These prompts are dynamically generated based on node attributes and graph structures, which can enhance the model’s understanding of molecular graphs. Subsequently, we leverage the molecular pre-trained model to integrate generalizable knowledge, thereby improving the model’s generalization and stability. Finally, we design a joint contrastive learning strategy to obtain more discriminative and expressive molecular embeddings. We conduct extensive experiments on five benchmark dataset pairs to demonstrate the effectiveness of our model.}
}
@article{LI2026116381,
title = {FSTL-Net: A few-shot welding defect detection method based on temporal modeling and metric learning},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116381},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116381},
url = {https://www.sciencedirect.com/science/article/pii/S095070512601107X},
author = {Keqiang Li and Shuai Ji and Yisheng Yin and Chengrui Zhang and Tieshuang Zhu},
keywords = {Welding defect detection, Temporal modeling, Few-shot, Metric learning, Molten pool evolution},
abstract = {Welding process monitoring is an important means of ensuring weld quality. However, welding defect detection faces two major challenges: methods relying only on single-frame images have difficulty in capturing the dynamic evolution of welding defects across consecutive frames; meanwhile, under few-shot and class-imbalanced conditions, conventional temporal models still struggle to stably learn the evolution patterns of minority defect classes. To address these issues, this paper proposes FSTL-Net, a few-shot welding defect detection method based on temporal modeling and metric learning. The framework employs a 3D convolutional neural network (3DCNN) as the backbone to jointly model spatiotemporal features in few-shot scenarios. Meanwhile, a Temporal Metric Query (TMQ) module based on Brownian Distance Covariance (BDC) is introduced to characterize the nonlinear temporal dependencies between query and support samples, thereby enhancing the representation of long-range correlations and dynamic evolution patterns. Furthermore, a Global Spatiotemporal Attention (GSTA) module is designed to exploit the temporal response stability and spatial structural continuity of welding regions. Through lightweight collaborative recalibration with temporal consistency modeling and spatial dual-axis structural aggregation, GSTA adaptively enhances stable defect regions and key structural features. Experimental results show that, with only 15 temporal samples per class, the proposed method achieves accuracies of 95.53% and 98.23% on a private dataset and the SS304 public dataset, respectively, and demonstrates strong cross-condition generalization ability.}
}
@article{CANOESPINOSA2026116402,
title = {Multimodal classification of keratoconus progression using corneal surface geometry and refractive data: the role of peripheral regions and missing-data patterns},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116402},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116402},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011287},
author = {Carlos Cano-Espinosa and Jose González and Carmelo Gómez and José Miguel Bolarín and Jorge {Alió del Barrio} and Francisco Cavas},
keywords = {Keratoconus classification, Corneal topography, Feature fusion, Machine learning, Sirius topographer, Peripheral corneal regions, Missing-data patterns},
abstract = {Early detection of ocular pathologies is crucial for improving treatment outcomes and preventing severe vision impairment. Keratoconus is a progressive corneal disorder characterized by thinning and irregular deformation of the cornea, which leads to visual distortion and may ultimately require corneal transplantation. Accurate detection and staging of keratoconus progression are therefore essential for effective clinical management. This study presents a multimodal framework for classifying keratoconus stages by integrating raw anterior and posterior corneal point cloud data acquired with Sirius topographer together with clinically derived refractive parameters. The proposed approach combines surface-based deep learning with traditional machine learning models for tabular clinical data, enabling joint exploitation of structural and optical information. Beyond classification performance, the study investigates the diagnostic role of peripheral corneal regions and acquisition-related missing-data patterns through dedicated analyses. The results indicate that peripheral measurements and structured missing-data distributions contain diagnostically relevant information that complements central corneal features. Overall, the proposed multimodal strategy improves keratoconus classification performance while providing new insights into the spatial and acquisition-related cues that contribute to disease staging, highlighting the potential of data-driven approaches to support clinical decision-making in keratoconus management.}
}
@article{LI2026116305,
title = {CIRRUS: A contextual interaction routing residual and unified spectral architecture for temporal graph representation learning},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116305},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116305},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010312},
author = {Xianghui Li and Liqing Qiu and Weidong Zhao},
keywords = {Temporal graphs, Representation learning, Interaction routing, Residual refinement, Spectral modeling},
abstract = {Continuous-time temporal graph representation learning aims to learn informative representations from streams of timestamped interactions for downstream dynamic tasks. However, existing methods often encode heterogeneous historical interactions through overly unified aggregation, which prematurely compresses different temporal dependencies into a single encoding stream. Such early compression blurs the distinction between personalized recurrence dependencies and collective temporal dependencies, making their effective organization under changing interaction contexts difficult. To address this issue, this paper proposes CIRRUS, a contextual interaction routing residual and unified spectral architecture for temporal graph representation learning. CIRRUS first separates historical interactions into two complementary dynamic signals, termed the individual dynamic signal and the collective dynamic signal, thereby preserving the functional distinction between personalized recurrence dependencies and collective temporal dependencies. Based on this dual-signal decomposition, CIRRUS organizes heterogeneous temporal dependencies within a unified interaction space, where a Spectral Component Routing Block (SCRB) performs context-guided spectral decomposition and adaptive component routing to organize branch-relevant temporal patterns. The routed branch guidance is then integrated with signal-guided residual mixing to reconstruct informative temporal semantics, thereby avoiding coarse uniform aggregation while preserving complementary dynamics across branches. In addition, a lightweight contrastive regularization is incorporated to improve semantic coordination between the two branches without weakening their distinct temporal roles. Extensive experiments on benchmark temporal graph datasets, including dynamic link prediction and auxiliary dynamic node classification, demonstrate that CIRRUS achieves competitive performance across diverse evaluation protocols.}
}
@article{YUAN2026116373,
title = {FedSA-GCL: A semi-asynchronous federated graph learning framework with personalized aggregation and cluster-aware broadcasting},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116373},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116373},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010993},
author = {Zhongzheng Yuan and Lianshuai Guo and Xunkai Li and Yinlin Zhu and Wenyu Wang and Meixia Qu},
keywords = {Federated graph learning, Asynchronous federated learning, Non-IID data, Client clustering},
abstract = {Federated Graph Learning (FGL) is a distributed learning paradigm that enables collaborative training over large-scale subgraphs located on multiple local systems. However, most existing FGL approaches rely on synchronous communication, which leads to inefficiencies and is often impractical in real-world deployments. Meanwhile, current asynchronous federated learning (AFL) methods are primarily designed for conventional tasks such as image classification and natural language processing, consequently failing to account for the unique topological properties of graph data. Directly applying these methods to graph learning frequently results in semantic drift and representational inconsistency within the global model. To address these challenges, we propose FedSA-GCL, a semi-asynchronous federated framework that leverages both inter-client label distribution divergence and graph topological characteristics through a novel ClusterCast mechanism for efficient training. We evaluate FedSA-GCL on multiple real-world graph datasets using the Louvain and Metis algorithms and conduct comparative analysis against 10 baselines. Extensive experiments demonstrate that our method achieves superior robustness and outstanding efficiency, outperforming the baselines by an average margin of 1.9% with Louvain and 3.0% with Metis.}
}
@article{LV2026116329,
title = {Distributed algorithm for best subset selection in smoothed quantile regression},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116329},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116329},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126010555},
author = {Jing Lv and Yu Dong and Chaohui Guo},
keywords = {Best subset selection, Distributed algorithm, High-dimensional data, Smoothed quantile loss, Splicing technique},
abstract = {Modeling high-dimensional massive data gives rise to fundamental challenges concerning computational efficiency, memory scalability, and privacy preservation. Best subset selection serves as a powerful framework for this task, as it can accurately and efficiently recover key signals from high-dimensional data and yield parsimonious, interpretable regression models. Nevertheless, most existing best subset methods are built upon the least squares or maximum likelihood estimation, which only characterizes the conditional mean of the response and lacks robustness to outliers or heavy-tailed errors. To address these limitations, we develop a robust adaptive best subset selection algorithm that integrates the smoothed quantile loss with refined splicing mechanisms. The main merit of the proposed procedure is that it not only quickly identifies important variables but also automatically determines the optimal sparsity level via the Schwarz information criterion. To further deal with the large-scale distributed datasets, we develop a communication-efficient distributed best subset selection algorithm. By employing a divide-and-conquer framework integrated with a weighted aggregation strategy, the proposed distributed algorithm effectively mitigates the critical limitation of naive averaging in handling the sample heterogeneity across machines. We also establish useful asymptotic properties for the newly distributed algorithm. Extensive simulations and real-data examples demonstrate that our proposals outperforms existing competitors, achieving substantially higher accuracy in both variable selection and parameter estimation.}
}
@article{SHEN2026116418,
title = {Toward trustworthy engineering information extraction using retrieval-augmented generation},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116418},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116418},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011445},
author = {Jie Shen and Hongyan Zhu and Binbin Zhang},
keywords = {Large language model, Trustworthy, Retrieval augmented generation, Engineering information extraction},
abstract = {Engineering information extraction is essential for construction intelligence, yet ensuring its trustworthiness remains a critical challenge. Although retrieval-augmented generation (RAG) enhances large language models (LLMs) with external knowledge, it introduces risks such as hallucination, weak robustness, and limited accountability. To address these challenges, this paper proposes TEIE-RAG, a unified framework for trustworthy engineering information extraction. By integrating hierarchical semantic chunking, hard-negative fine-tuning for retrieval models, self-improving few-shot learning, and precise source grounding, the framework improves contextual integrity, factual accuracy, and traceability. Experiments show that TEIE-RAG achieves 93.10% Top-5 extraction accuracy and 92.31% error identification accuracy, outperforming existing approaches in both reliability and effectiveness. These results highlight the potential of TEIE-RAG as a practical, scalable solution for trustworthy engineering information extraction, thereby advancing the deployment of RAG-based systems in safety-critical and knowledge-intensive domains.}
}
@article{ZHOU2026116390,
title = {GMG-Net: Gradient-aware and Mid-frequency Guided network for low-light image enhancement},
journal = {Knowledge-Based Systems},
volume = {348},
pages = {116390},
year = {2026},
issn = {0950-7051},
doi = {https://doi.org/10.1016/j.knosys.2026.116390},
url = {https://www.sciencedirect.com/science/article/pii/S0950705126011160},
author = {Huaping Zhou and Shiji Lu and Kelei Sun and Tao Wu and Bin Deng and Man Chen},
keywords = {Low-light image enhancement, Gradient-aware, Fourier transform, Mid-frequency guided, Deformable attention},
abstract = {Low-light image enhancement is a challenging task in image processing, aiming to restore visually natural and structurally faithful images from environments with insufficient and spatially varying illumination. Although mainstream deep learning methods have achieved notable progress, they often fail to adaptively handle regions with varying lighting conditions in scenes with large illumination changes, resulting in noise amplification, detail degradation, and color distortion. To address these issues, we propose GMG-Net, a low-light enhancement network based on a gradient-aware mechanism and a mid-frequency guided mechanism. First, we design a Gradient-aware Contextual Attention Block (GCAB). This block dynamically enhances blurred edge features in low-light images through a gradient-aware mechanism, preserving regions with clear structural information. Second, we propose a Mid-frequency Guided Multi-scale Frequency Enhancement Module (MGMFE). It uses informative mid-frequency features as guidance to adaptively modulate high- and low-frequency information in the frequency domain. Third, we develop a Deformable Cross-branch Fusion Attention (DCFA) module. It dynamically aligns and fuses features between the HV-branch and I-branch within the HVI color space using deformable offset sampling. Experiments on the multiple datasets demonstrate that GMG-Net exhibits good visual and performance advantages in low-light image enhancement. Additionally, our method maintains low Params and FLOPs, making it suitable for practical applications. Code is available at https://github.com/Century-lu/GMG-Net.}
}
