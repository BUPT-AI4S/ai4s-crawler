  {
    "id": "10.1016/j.jtho.2024.11.016",
    "venue": "j-37b23398b2",
    "year": 2025,
    "track": null,
    "title": "Differentiating Separate Primary Lung Adenocarcinomas From Intrapulmonary Metastases With Emphasis on Pathological and Molecular Considerations: Recommendations From the International Association for the Study of Lung Cancer Pathology Committee",
    "authors": [
      "Teh-Ying Chou",
      "Sanja Dacic",
      "Ignacio Wistuba",
      "Mary Beth Beasley",
      "Sabina Berezowska",
      "Yeun-Chung Chang",
      "Jin-Haeng Chung",
      "Casey Connolly",
      "Yuchen Han",
      "Fred R. Hirsch",
